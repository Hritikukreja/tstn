{% doc %}
  @prompt
    Create a collapsable Rich Text content container to house the data in BODY HTML 
    mATCH THE CURRENT THEME
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collapsible-richtext-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    border: {{ block.settings.border_thickness }}px solid rgba(18, 18, 18, {{ block.settings.border_opacity | divided_by: 100.0 }});
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-collapsible-richtext-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.header_bg_color }};
    cursor: pointer;
    user-select: none;
  }

  .ai-collapsible-richtext-header-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.header_hover_bg_color }};
  }

  .ai-collapsible-richtext-title-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    font-weight: 600;
  }

  .ai-collapsible-richtext-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: {{ block.settings.icon_color }};
  }

  .ai-collapsible-richtext-{{ ai_gen_id }}[data-expanded="true"] .ai-collapsible-richtext-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-collapsible-richtext-content-{{ ai_gen_id }} {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-collapsible-richtext-{{ ai_gen_id }}[data-expanded="true"] .ai-collapsible-richtext-content-{{ ai_gen_id }} {
    max-height: 5000px;
  }

  .ai-collapsible-richtext-body-{{ ai_gen_id }} {
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.content_bg_color }};
    color: {{ block.settings.content_text_color }};
    font-size: {{ block.settings.content_text_size }}px;
    line-height: 1.6;
  }

  .ai-collapsible-richtext-body-{{ ai_gen_id }} p {
    margin: 0 0 1em 0;
  }

  .ai-collapsible-richtext-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-collapsible-richtext-body-{{ ai_gen_id }} h1,
  .ai-collapsible-richtext-body-{{ ai_gen_id }} h2,
  .ai-collapsible-richtext-body-{{ ai_gen_id }} h3,
  .ai-collapsible-richtext-body-{{ ai_gen_id }} h4,
  .ai-collapsible-richtext-body-{{ ai_gen_id }} h5,
  .ai-collapsible-richtext-body-{{ ai_gen_id }} h6 {
    margin: 0 0 0.5em 0;
  }

  .ai-collapsible-richtext-body-{{ ai_gen_id }} ul,
  .ai-collapsible-richtext-body-{{ ai_gen_id }} ol {
    margin: 0 0 1em 0;
    padding-left: 1.5em;
  }

  .ai-collapsible-richtext-body-{{ ai_gen_id }} a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
  }

  .ai-collapsible-richtext-body-{{ ai_gen_id }} a:hover {
    color: {{ block.settings.link_hover_color }};
  }
{% endstyle %}

<collapsible-richtext-{{ ai_gen_id }}
  class="ai-collapsible-richtext-{{ ai_gen_id }}"
  data-expanded="{{ block.settings.default_open }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collapsible-richtext-header-{{ ai_gen_id }}" role="button" aria-expanded="{{ block.settings.default_open }}" tabindex="0">
    <h3 class="ai-collapsible-richtext-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
    <svg class="ai-collapsible-richtext-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </div>
  <div class="ai-collapsible-richtext-content-{{ ai_gen_id }}">
    <div class="ai-collapsible-richtext-body-{{ ai_gen_id }}">
      {% if block.settings.content != blank %}
        {{ block.settings.content }}
      {% else %}
        <p>Add your rich text content here. You can include headings, paragraphs, lists, and links.</p>
      {% endif %}
    </div>
  </div>
</collapsible-richtext-{{ ai_gen_id }}>

<script>
  (function() {
    class CollapsibleRichtext{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.header = this.querySelector('.ai-collapsible-richtext-header-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-collapsible-richtext-content-{{ ai_gen_id }}');
        
        this.header.addEventListener('click', () => this.toggle());
        this.header.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            this.toggle();
          }
        });
      }

      toggle() {
        const isExpanded = this.getAttribute('data-expanded') === 'true';
        this.setAttribute('data-expanded', !isExpanded);
        this.header.setAttribute('aria-expanded', !isExpanded);
      }
    }

    customElements.define('collapsible-richtext-{{ ai_gen_id }}', CollapsibleRichtext{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Collapsible rich text",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Collapsible content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Rich text content",
      "default": "<p>Add your detailed content here. This area supports rich text formatting including <strong>bold</strong>, <em>italic</em>, lists, and links.</p>"
    },
    {
      "type": "checkbox",
      "id": "default_open",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Header style"
    },
    {
      "type": "color",
      "id": "header_bg_color",
      "label": "Background color",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "header_hover_bg_color",
      "label": "Hover background color",
      "default": "#e8e8e8"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Content style"
    },
    {
      "type": "color",
      "id": "content_bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "content_text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link hover color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_opacity",
      "label": "Border opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 10
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Collapsible rich text"
    }
  ]
}
{% endschema %}
