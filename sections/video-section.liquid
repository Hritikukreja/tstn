{% comment %}
  TSTN — Latest From The Trail (Videos Section)
  Premium black theme with orange accents
  Uses Danger Neue Free Regular for headings
  Videos play in-page via lightbox (YouTube / Vimeo / direct video files)
  Secondary grid can auto-feed the latest uploads from a YouTube channel
  (YouTube Data API v3). Falls back to manual Video Card blocks.
{% endcomment %}

{%- assign featured_aspect = section.settings.featured_aspect | times: 1.0 | divided_by: 100.0 -%}
{%- assign card_aspect = section.settings.card_aspect | times: 1.0 | divided_by: 100.0 -%}

{%- assign yt_enabled = false -%}
{%- if section.settings.youtube_api_key != blank and section.settings.youtube_channel_id != blank -%}
  {%- assign yt_enabled = true -%}
{%- endif -%}

<section
  id="shopify-section-{{ section.id }}"
  class="trail-videos"
  style="
    --tv-section-pad-y: {{ section.settings.section_padding_y }}px;
    --tv-heading-size: {{ section.settings.heading_size }}px;
    --tv-subheading-size: {{ section.settings.subheading_size }}px;
    --tv-featured-title-size: {{ section.settings.featured_title_size }}px;
    --tv-featured-aspect: {{ featured_aspect }};
    --tv-stat-value-size: {{ section.settings.stat_value_size }}px;
    --tv-card-title-size: {{ section.settings.card_title_size }}px;
    --tv-card-aspect: {{ card_aspect }};
  "
>
  <div class="trail-videos__container">

    {%- comment -%} Header {%- endcomment -%}
    <div class="trail-videos__header">
      <div class="trail-videos__eyebrow">
        <span class="trail-videos__eyebrow-line"></span>
        <span class="trail-videos__eyebrow-text">{{ section.settings.eyebrow }}</span>
      </div>
      {%- if section.settings.heading != blank -%}
        <h2 class="trail-videos__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="trail-videos__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Main grid: Featured video + Stats {%- endcomment -%}
    <div class="trail-videos__main">

      {%- comment -%} Featured Video {%- endcomment -%}
      <div class="trail-videos__featured">
        <a
          href="{{ section.settings.featured_video_url | default: '#' }}"
          class="trail-videos__featured-link"
          data-tv-video="{{ section.settings.featured_video_url }}"
        >
          <div class="trail-videos__featured-media">
            {%- if section.settings.featured_image != blank -%}
              {{ section.settings.featured_image | image_url: width: 1400 | image_tag:
                loading: 'lazy',
                class: 'trail-videos__featured-img',
                widths: '600,900,1200,1400,1800',
                sizes: '(min-width: 990px) 65vw, 100vw',
                alt: section.settings.featured_title
              }}
            {%- else -%}
              <div class="trail-videos__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            <div class="trail-videos__overlay"></div>

            <button type="button" class="trail-videos__play trail-videos__play--featured" aria-label="Play video">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
                <path d="M9.5 8L16 12L9.5 16V8Z" fill="currentColor"/>
              </svg>
            </button>

            <div class="trail-videos__featured-content">
              {%- if section.settings.featured_label != blank -%}
                <span class="trail-videos__featured-label">{{ section.settings.featured_label }}</span>
              {%- endif -%}
              {%- if section.settings.featured_title != blank or yt_enabled -%}
                <h3 class="trail-videos__featured-title">{{ section.settings.featured_title }}</h3>
              {%- endif -%}
            </div>
          </div>
        </a>
      </div>

      {%- comment -%} Stats Sidebar {%- endcomment -%}
      <div class="trail-videos__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="trail-videos__stat" {{ block.shopify_attributes }}>
              <div class="trail-videos__stat-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'youtube' -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="2" y="5" width="20" height="14" rx="3" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M10 9L15 12L10 15V9Z" fill="currentColor"/>
                    </svg>
                  {%- when 'eye' -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M2 12C2 12 5 5 12 5C19 5 22 12 22 12C22 12 19 19 12 19C5 19 2 12 2 12Z" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {%- when 'instagram' -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="3" y="3" width="18" height="18" rx="4" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
                    </svg>
                  {%- when 'tiktok' -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M16 4V14.5C16 17 14 19 11.5 19C9 19 7 17 7 14.5C7 12 9 10 11.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M16 4C16 6.5 18 8.5 20.5 8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- when 'twitter' -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M4 4L20 20M20 4L4 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {%- when 'facebook' -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M14 4H17V8H14C13.5 8 13 8.5 13 9V12H17L16 16H13V22H9V16H6V12H9V9C9 6 11 4 14 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                {%- endcase -%}
              </div>
              <div class="trail-videos__stat-content">
                <div class="trail-videos__stat-value">{{ block.settings.value }}</div>
                <div class="trail-videos__stat-label">{{ block.settings.label }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

    {%- comment -%} Secondary video grid (auto-fed from YouTube, manual blocks as fallback) {%- endcomment -%}
    {%- assign video_blocks = section.blocks | where: 'type', 'video' -%}
    {%- if video_blocks.size > 0 or yt_enabled -%}
      <div
        class="trail-videos__grid"
        data-tv-grid
        data-tv-yt-key="{{ section.settings.youtube_api_key | escape }}"
        data-tv-yt-channel="{{ section.settings.youtube_channel_id | escape }}"
        data-tv-yt-count="{{ section.settings.youtube_count }}"
        data-tv-yt-date="{{ section.settings.youtube_show_date }}"
        data-tv-yt-min="{{ section.settings.youtube_min_seconds }}"
      >
        {%- for block in video_blocks -%}
          <a
            href="{{ block.settings.video_url | default: '#' }}"
            class="trail-videos__card"
            data-tv-video="{{ block.settings.video_url }}"
            {{ block.shopify_attributes }}
          >
            <div class="trail-videos__card-media">
              {%- if block.settings.thumbnail != blank -%}
                {{ block.settings.thumbnail | image_url: width: 800 | image_tag:
                  loading: 'lazy',
                  class: 'trail-videos__card-img',
                  widths: '400,600,800,1000',
                  sizes: '(min-width: 990px) 30vw, 90vw',
                  alt: block.settings.title
                }}
              {%- else -%}
                <div class="trail-videos__placeholder">
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}

              <button type="button" class="trail-videos__play" aria-label="Play video">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M9.5 8L16 12L9.5 16V8Z" fill="currentColor"/>
                </svg>
              </button>
            </div>

            <div class="trail-videos__card-footer">
              <div class="trail-videos__card-meta">
                {%- if block.settings.episode != blank -%}
                  <span class="trail-videos__card-episode">{{ block.settings.episode }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <span class="trail-videos__card-title">{{ block.settings.title }}</span>
                {%- endif -%}
              </div>
              <span class="trail-videos__card-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} View all CTA {%- endcomment -%}
    {%- if section.settings.cta_text != blank -%}
      <div class="trail-videos__cta-wrap">
        <a
          href="{{ section.settings.cta_url | default: '#' }}"
          class="trail-videos__cta"
          {% if section.settings.cta_url contains 'youtube.com' or section.settings.cta_url contains 'youtu.be' %}target="_blank" rel="noopener"{% endif %}
        >
          <span>{{ section.settings.cta_text }}</span>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} In-page video lightbox {%- endcomment -%}
  <div
    class="trail-videos__modal"
    id="tv-modal-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-label="Video player"
    aria-hidden="true"
  >
    <div class="trail-videos__modal-backdrop" data-tv-close></div>
    <div class="trail-videos__modal-dialog">
      <button type="button" class="trail-videos__modal-close" data-tv-close aria-label="Close video">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="trail-videos__modal-frame" id="tv-modal-frame-{{ section.id }}"></div>
    </div>
  </div>
</section>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var root = document.getElementById('shopify-section-' + sectionId) || document.querySelector('#shopify-section-' + sectionId);
    if (!root) return;

    var modal = document.getElementById('tv-modal-' + sectionId);
    var frame = document.getElementById('tv-modal-frame-' + sectionId);
    if (!modal || !frame) return;

    // Avoid double-binding when the theme editor re-renders the section
    if (root.dataset.tvBound === 'true') return;
    root.dataset.tvBound = 'true';

    function buildEmbed(url) {
      if (!url) return null;

      var yt = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|v\/)|youtu\.be\/)([\w-]{11})/);
      if (yt) {
        return '<iframe src="https://www.youtube.com/embed/' + yt[1] +
          '?autoplay=1&rel=0&modestbranding=1&playsinline=1" ' +
          'frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>';
      }

      var vimeo = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
      if (vimeo) {
        return '<iframe src="https://player.vimeo.com/video/' + vimeo[1] +
          '?autoplay=1" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>';
      }

      if (/\.(mp4|webm|ogg|ogv|mov)(\?.*)?$/i.test(url)) {
        return '<video src="' + url + '" controls autoplay playsinline></video>';
      }

      return null;
    }

    function openModal(embedHtml) {
      frame.innerHTML = embedHtml;
      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
      frame.innerHTML = ''; // clears iframe/video -> stops playback
      document.body.style.overflow = '';
    }

    // Event delegation so dynamically injected YouTube cards work too
    root.addEventListener('click', function (e) {
      var el = e.target.closest ? e.target.closest('[data-tv-video]') : null;
      if (!el || !root.contains(el)) return;

      var url = (el.getAttribute('data-tv-video') || '').trim();

      // No URL set yet -> stop the placeholder "#" jump
      if (!url || url === '#') {
        e.preventDefault();
        return;
      }

      var embed = buildEmbed(url);

      // Unrecognized URL (e.g. an internal page link) -> let it navigate normally
      if (!embed) return;

      e.preventDefault();
      openModal(embed);
    });

    modal.querySelectorAll('[data-tv-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-active')) {
        closeModal();
      }
    });

    /* -------------------------------------------------------------
       YouTube auto-feed for the secondary grid
    -------------------------------------------------------------- */
    function escHtml(str) {
      return String(str).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function fmtDate(iso) {
      var d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      var m = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
      return m[d.getMonth()] + ' ' + d.getFullYear();
    }

    function parseDuration(iso) {
      // ISO 8601 e.g. PT1H2M30S -> seconds
      var m = /^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/.exec(iso || '');
      if (!m) return 0;
      return (parseInt(m[1] || 0, 10) * 3600) +
             (parseInt(m[2] || 0, 10) * 60) +
             parseInt(m[3] || 0, 10);
    }

    function bestThumb(s) {
      var t = (s && s.thumbnails) || {};
      return (t.maxres || t.standard || t.high || t.medium || t.default || {}).url || '';
    }

    function updateFeatured(item) {
      var link = root.querySelector('.trail-videos__featured-link');
      var media = root.querySelector('.trail-videos__featured-media');
      var titleEl = root.querySelector('.trail-videos__featured-title');
      if (!link || !media) return;

      var s = item.snippet || {};
      var vid = (s.resourceId || {}).videoId;
      var watch = 'https://www.youtube.com/watch?v=' + vid;
      var thumb = bestThumb(s);

      link.setAttribute('href', watch);
      link.setAttribute('data-tv-video', watch);

      if (thumb) {
        var img = media.querySelector('.trail-videos__featured-img');
        var placeholder = media.querySelector('.trail-videos__placeholder');
        if (img) {
          img.removeAttribute('srcset');
          img.removeAttribute('sizes');
          img.src = thumb;
          img.alt = s.title || '';
        } else {
          var newImg = document.createElement('img');
          newImg.className = 'trail-videos__featured-img';
          newImg.loading = 'lazy';
          newImg.src = thumb;
          newImg.alt = s.title || '';
          if (placeholder) {
            media.replaceChild(newImg, placeholder);
          } else {
            media.insertBefore(newImg, media.firstChild);
          }
        }
      }

      if (titleEl) titleEl.textContent = s.title || '';
    }

    function skeletonHtml(n) {
      var out = '';
      for (var i = 0; i < n; i++) {
        out += '<div class="trail-videos__card trail-videos__card--skeleton" aria-hidden="true">' +
          '<div class="trail-videos__card-media"></div>' +
          '<div class="trail-videos__card-footer"><span class="trail-videos__skel"></span></div>' +
          '</div>';
      }
      return out;
    }

    function ytCard(item, showDate) {
      var s = item.snippet || {};
      var rid = s.resourceId || {};
      var vid = rid.videoId;
      var t = s.thumbnails || {};
      var thumb = (t.maxres || t.standard || t.high || t.medium || t.default || {}).url || '';
      var title = s.title || '';
      var watch = 'https://www.youtube.com/watch?v=' + vid;
      var meta = (showDate && s.publishedAt) ?
        '<span class="trail-videos__card-episode">' + escHtml(fmtDate(s.publishedAt)) + '</span>' : '';

      return '<a href="' + watch + '" class="trail-videos__card" data-tv-video="' + watch + '">' +
        '<div class="trail-videos__card-media">' +
          (thumb
            ? '<img src="' + escHtml(thumb) + '" loading="lazy" class="trail-videos__card-img" alt="' + escHtml(title) + '">'
            : '<div class="trail-videos__placeholder"></div>') +
          '<button type="button" class="trail-videos__play" aria-label="Play video">' +
            '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
            '<circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.5"/>' +
            '<path d="M9.5 8L16 12L9.5 16V8Z" fill="currentColor"/></svg>' +
          '</button>' +
        '</div>' +
        '<div class="trail-videos__card-footer">' +
          '<div class="trail-videos__card-meta">' + meta +
            '<span class="trail-videos__card-title">' + escHtml(title) + '</span>' +
          '</div>' +
          '<span class="trail-videos__card-arrow" aria-hidden="true">' +
            '<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
            '<path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>' +
          '</span>' +
        '</div>' +
      '</a>';
    }

    var grid = root.querySelector('[data-tv-grid]');
    if (grid) {
      var key = (grid.getAttribute('data-tv-yt-key') || '').trim();
      var channel = (grid.getAttribute('data-tv-yt-channel') || '').trim();
      var count = parseInt(grid.getAttribute('data-tv-yt-count'), 10) || 6;
      var showDate = grid.getAttribute('data-tv-yt-date') === 'true';
      var minSeconds = parseInt(grid.getAttribute('data-tv-yt-min'), 10);
      if (isNaN(minSeconds)) minSeconds = 0;

      if (key && channel) {
        var fallbackHtml = grid.innerHTML; // manual Video Card blocks
        var uploads = channel.replace(/^UC/, 'UU'); // uploads playlist id
        var apiBase = 'https://www.googleapis.com/youtube/v3/';

        function showFallback() {
          grid.classList.remove('is-loading');
          if (fallbackHtml && fallbackHtml.trim()) {
            grid.innerHTML = fallbackHtml; // restore manual blocks
          } else {
            grid.style.display = 'none';
          }
        }

        grid.classList.add('is-loading');
        grid.innerHTML = skeletonHtml(count);

        // 1) Latest uploads (newest first). Pull a wide window so we still
        //    have enough long-form videos left after Shorts are removed.
        fetch(apiBase + 'playlistItems?part=snippet&maxResults=50&playlistId=' +
              encodeURIComponent(uploads) + '&key=' + encodeURIComponent(key))
          .then(function (r) { if (!r.ok) throw new Error('playlistItems ' + r.status); return r.json(); })
          .then(function (data) {
            var candidates = (data.items || []).filter(function (it) {
              var s = it.snippet || {};
              var rid = s.resourceId || {};
              return rid.videoId &&
                s.title !== 'Private video' &&
                s.title !== 'Deleted video' &&
                s.thumbnails;
            });
            if (!candidates.length) throw new Error('No public videos');

            var ids = candidates.map(function (it) { return it.snippet.resourceId.videoId; });

            // 2) Look up durations to separate Shorts from regular videos.
            return fetch(apiBase + 'videos?part=contentDetails&id=' +
                         encodeURIComponent(ids.join(',')) + '&key=' + encodeURIComponent(key))
              .then(function (r) { if (!r.ok) throw new Error('videos ' + r.status); return r.json(); })
              .then(function (durData) {
                var durMap = {};
                (durData.items || []).forEach(function (v) {
                  durMap[v.id] = parseDuration((v.contentDetails || {}).duration);
                });

                // Keep only regular (long-form) videos
                var regular = candidates.filter(function (it) {
                  var sec = durMap[it.snippet.resourceId.videoId] || 0;
                  return sec > minSeconds;
                });
                if (!regular.length) throw new Error('No regular videos after Shorts filter');

                // Featured = newest regular video; grid = the next ones
                updateFeatured(regular[0]);

                var gridItems = regular.slice(1, 1 + count);
                grid.classList.remove('is-loading');
                if (gridItems.length) {
                  grid.innerHTML = gridItems.map(function (it) { return ytCard(it, showDate); }).join('');
                } else {
                  grid.style.display = 'none';
                }
              });
          })
          .catch(function () { showFallback(); });
      }
    }
  })();
</script>

{% stylesheet %}
  /* Font face — Danger Neue Free Regular */
  @font-face {
    font-family: 'Danger Neue Free Regular';
    src: url('https://cdn.shopify.com/s/files/1/0000/0000/files/DangerNeueFree-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  .trail-videos {
    --tv-bg: #0a0a0a;
    --tv-surface: #141414;
    --tv-surface-2: #1a1a1a;
    --tv-border: rgba(255, 255, 255, 0.08);
    --tv-border-hover: rgba(255, 106, 26, 0.4);
    --tv-text: #ffffff;
    --tv-text-muted: rgba(255, 255, 255, 0.65);
    --tv-text-dim: rgba(255, 255, 255, 0.45);
    --tv-accent: #ff6a1a;
    --tv-accent-glow: rgba(255, 106, 26, 0.2);

    --tv-section-pad-y: 100px;
    --tv-heading-size: 80px;
    --tv-subheading-size: 17px;
    --tv-featured-title-size: 36px;
    --tv-featured-aspect: 1.78;
    --tv-stat-value-size: 48px;
    --tv-card-title-size: 14px;
    --tv-card-aspect: 1.78;

    position: relative;
    background: var(--tv-bg);
    color: var(--tv-text);
    padding: var(--tv-section-pad-y) 0;
    overflow: hidden;
    font-family: 'Danger Neue Free Regular', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .trail-videos::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 15% 30%, rgba(255, 106, 26, 0.04) 0%, transparent 40%),
      radial-gradient(circle at 85% 70%, rgba(255, 106, 26, 0.03) 0%, transparent 40%);
    pointer-events: none;
    z-index: 0;
  }

  .trail-videos__container {
    position: relative;
    z-index: 1;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 60px);
  }

  .trail-videos__header {
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .trail-videos__eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: clamp(16px, 2vw, 24px);
  }

  .trail-videos__eyebrow-line {
    display: block;
    width: clamp(32px, 4vw, 48px);
    height: 2px;
    background: var(--tv-accent);
  }

  .trail-videos__eyebrow-text {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: clamp(14px, 1.2vw, 16px);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tv-accent);
  }

  .trail-videos__heading {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: var(--tv-heading-size);
    line-height: 0.95;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--tv-text);
    margin: 0 0 clamp(12px, 1.5vw, 20px);
    font-weight: 400;
  }

  .trail-videos__subheading {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: var(--tv-subheading-size);
    line-height: 1.5;
    color: var(--tv-text-muted);
    margin: 0;
    max-width: 600px;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  .trail-videos__main {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 40px);
    margin-bottom: clamp(20px, 2.5vw, 32px);
  }

  @media (min-width: 990px) {
    .trail-videos__main {
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }

  .trail-videos__featured {
    position: relative;
  }

  .trail-videos__featured-link {
    display: block;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .trail-videos__featured-media {
    position: relative;
    aspect-ratio: var(--tv-featured-aspect);
    border-radius: clamp(8px, 1vw, 14px);
    overflow: hidden;
    background: var(--tv-surface);
    border: 1px solid var(--tv-border);
    transition: border-color 0.4s ease, transform 0.4s ease;
  }

  .trail-videos__featured-link:hover .trail-videos__featured-media {
    border-color: var(--tv-border-hover);
  }

  .trail-videos__featured-img,
  .trail-videos__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .trail-videos__featured-link:hover .trail-videos__featured-img {
    transform: scale(1.03);
  }

  .trail-videos__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0.85) 100%
    );
    pointer-events: none;
  }

  .trail-videos__featured-content {
    position: absolute;
    left: clamp(20px, 3vw, 40px);
    right: clamp(20px, 3vw, 40px);
    bottom: clamp(20px, 3vw, 36px);
    z-index: 2;
  }

  .trail-videos__featured-label {
    display: inline-block;
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: clamp(13px, 1.1vw, 15px);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tv-accent);
    margin-bottom: clamp(8px, 1vw, 12px);
  }

  .trail-videos__featured-title {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: var(--tv-featured-title-size);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--tv-text);
    margin: 0;
    max-width: 700px;
    font-weight: 400;
  }

  .trail-videos__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(48px, 5vw, 72px);
    height: clamp(48px, 5vw, 72px);
    border-radius: 50%;
    border: none;
    background: transparent;
    color: var(--tv-text);
    cursor: pointer;
    z-index: 3;
    display: grid;
    place-items: center;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .trail-videos__play svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .trail-videos__play--featured {
    color: var(--tv-accent);
    width: clamp(56px, 6vw, 84px);
    height: clamp(56px, 6vw, 84px);
    filter: drop-shadow(0 4px 20px var(--tv-accent-glow));
  }

  .trail-videos__featured-link:hover .trail-videos__play--featured,
  .trail-videos__card:hover .trail-videos__play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .trail-videos__stats {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    gap: clamp(20px, 2.5vw, 32px);
    padding: clamp(20px, 2.5vw, 32px) clamp(20px, 2vw, 28px);
  }

  @media (max-width: 989px) {
    .trail-videos__stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      padding: 0;
    }
  }

  .trail-videos__stat {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.5vw, 20px);
    padding-bottom: clamp(20px, 2.5vw, 32px);
    border-bottom: 1px solid var(--tv-border);
  }

  .trail-videos__stat:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  @media (max-width: 989px) {
    .trail-videos__stat {
      padding: clamp(16px, 2vw, 24px);
      border: 1px solid var(--tv-border);
      border-radius: clamp(8px, 1vw, 12px);
      background: var(--tv-surface);
    }
  }

  .trail-videos__stat-icon {
    flex-shrink: 0;
    width: clamp(36px, 3.5vw, 48px);
    height: clamp(36px, 3.5vw, 48px);
    color: var(--tv-text);
    display: grid;
    place-items: center;
  }

  .trail-videos__stat-icon svg {
    width: 100%;
    height: 100%;
  }

  .trail-videos__stat-value {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: var(--tv-stat-value-size);
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--tv-accent);
    margin-bottom: 4px;
    font-weight: 400;
  }

  .trail-videos__stat-label {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tv-text-muted);
  }

  .trail-videos__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(16px, 2vw, 24px);
  }

  @media (min-width: 700px) {
    .trail-videos__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .trail-videos__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .trail-videos__card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--tv-surface);
    border: 1px solid var(--tv-border);
    border-radius: clamp(8px, 1vw, 14px);
    overflow: hidden;
    transition: border-color 0.4s ease, transform 0.4s ease;
  }

  .trail-videos__card:hover {
    border-color: var(--tv-border-hover);
    transform: translateY(-2px);
  }

  .trail-videos__card-media {
    position: relative;
    aspect-ratio: var(--tv-card-aspect);
    overflow: hidden;
    background: var(--tv-surface-2);
  }

  .trail-videos__card:hover .trail-videos__card-img {
    transform: scale(1.05);
  }

  .trail-videos__card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(14px, 1.6vw, 20px) clamp(16px, 1.8vw, 22px);
  }

  .trail-videos__card-meta {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.2vw, 16px);
    min-width: 0;
    flex: 1;
  }

  .trail-videos__card-episode {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tv-accent);
    flex-shrink: 0;
  }

  .trail-videos__card-title {
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: var(--tv-card-title-size);
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tv-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .trail-videos__card-arrow {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    color: var(--tv-text);
    display: grid;
    place-items: center;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .trail-videos__card-arrow svg {
    width: 100%;
    height: 100%;
  }

  .trail-videos__card:hover .trail-videos__card-arrow {
    transform: translateX(4px);
    color: var(--tv-accent);
  }

  .trail-videos__card .trail-videos__play {
    color: var(--tv-text);
    opacity: 0.95;
  }

  /* Skeleton loading state for auto-fed YouTube cards */
  .trail-videos__card--skeleton {
    pointer-events: none;
    cursor: default;
  }

  .trail-videos__card--skeleton:hover {
    border-color: var(--tv-border);
    transform: none;
  }

  .trail-videos__card--skeleton .trail-videos__card-media,
  .trail-videos__skel {
    background: linear-gradient(
      90deg,
      var(--tv-surface-2) 25%,
      rgba(255, 255, 255, 0.07) 37%,
      var(--tv-surface-2) 63%
    );
    background-size: 400% 100%;
    animation: tvShimmer 1.4s ease infinite;
  }

  .trail-videos__skel {
    display: block;
    height: 14px;
    width: 70%;
    border-radius: 4px;
  }

  @keyframes tvShimmer {
    0% { background-position: 100% 0; }
    100% { background-position: 0 0; }
  }

  .trail-videos__cta-wrap {
    margin-top: clamp(32px, 4vw, 56px);
    display: flex;
    justify-content: center;
  }

  .trail-videos__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(40px, 6vw, 80px);
    padding: clamp(14px, 1.5vw, 18px) clamp(28px, 3vw, 44px);
    border: 1.5px solid var(--tv-accent);
    border-radius: 4px;
    background: transparent;
    color: var(--tv-accent);
    text-decoration: none;
    font-family: 'Danger Neue Free Regular', 'Impact', 'Bebas Neue', sans-serif !important;
    font-size: clamp(14px, 1.2vw, 16px);
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
    min-width: clamp(280px, 30vw, 380px);
  }

  .trail-videos__cta svg {
    width: clamp(20px, 1.6vw, 24px);
    height: clamp(20px, 1.6vw, 24px);
    transition: transform 0.3s ease;
  }

  .trail-videos__cta:hover {
    background: #ffffff;
    color: var(--tv-bg);
    border-color: #ffffff;
  }

  .trail-videos__cta:hover svg {
    transform: translateX(4px);
  }

  /* ---------------------------------------------------------------
     In-page video lightbox
  ---------------------------------------------------------------- */
  .trail-videos__modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 56px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .trail-videos__modal.is-active {
    opacity: 1;
    visibility: visible;
  }

  .trail-videos__modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .trail-videos__modal-dialog {
    position: relative;
    z-index: 1;
    width: min(1100px, 100%);
    transform: scale(0.96);
    transition: transform 0.3s ease;
  }

  .trail-videos__modal.is-active .trail-videos__modal-dialog {
    transform: scale(1);
  }

  .trail-videos__modal-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: clamp(8px, 1vw, 14px);
    overflow: hidden;
    border: 1px solid var(--tv-border-hover);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 106, 26, 0.12);
  }

  .trail-videos__modal-frame iframe,
  .trail-videos__modal-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .trail-videos__modal-close {
    position: absolute;
    top: clamp(-52px, -6vw, -44px);
    right: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--tv-border);
    background: rgba(20, 20, 20, 0.8);
    color: var(--tv-text);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .trail-videos__modal-close svg {
    width: 22px;
    height: 22px;
  }

  .trail-videos__modal-close:hover {
    background: var(--tv-accent);
    border-color: var(--tv-accent);
    color: #0a0a0a;
    transform: scale(1.06);
  }

  @media (max-width: 749px) {
    .trail-videos {
      padding: calc(var(--tv-section-pad-y) * 0.6) 0;
    }
    .trail-videos__heading {
      font-size: calc(var(--tv-heading-size) * 0.55);
    }
    .trail-videos__subheading {
      font-size: calc(var(--tv-subheading-size) * 0.9);
    }
    .trail-videos__featured-title {
      font-size: calc(var(--tv-featured-title-size) * 0.6);
    }
    .trail-videos__stat-value {
      font-size: calc(var(--tv-stat-value-size) * 0.7);
    }
    .trail-videos__card-title {
      font-size: calc(var(--tv-card-title-size) * 0.92);
    }
    .trail-videos__modal-close {
      top: 0;
      right: 0;
      transform: translate(-8px, 8px);
      z-index: 2;
    }
    .trail-videos__modal-close:hover {
      transform: translate(-8px, 8px) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trail-videos *,
    .trail-videos *::before,
    .trail-videos *::after {
      transition: none !important;
      animation: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Latest From Trail",
  "tag": "section",
  "class": "section-trail-videos",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Latest From The Trail"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh Drops Every Week."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real adventures. Real gear. Real world-tested."
    },
    {
      "type": "header",
      "content": "Featured Video"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured thumbnail"
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Featured label",
      "default": "Latest Video"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured video title",
      "default": "Conquering an Unexpected Snowstorm in My Full-Size RAM!"
    },
    {
      "type": "url",
      "id": "featured_video_url",
      "label": "Featured video URL",
      "info": "YouTube, Vimeo, or a direct video file (.mp4). Plays in a pop-up on the page."
    },
    {
      "type": "header",
      "content": "YouTube Auto-Feed (Videos Grid)"
    },
    {
      "type": "paragraph",
      "content": "Auto-fills the featured video and the grid with the channel's latest uploads. The newest regular video becomes the featured video; the rest fill the grid. Leave the API key blank (or if the API fails) to use the manual featured video + Video Cards instead."
    },
    {
      "type": "text",
      "id": "youtube_api_key",
      "label": "YouTube Data API key",
      "info": "Google Cloud Console → enable 'YouTube Data API v3' → create an API key → restrict it to your store domain (HTTP referrers)."
    },
    {
      "type": "text",
      "id": "youtube_channel_id",
      "label": "YouTube Channel ID",
      "default": "UC_QteyvNZKtK5qPWlPbrl-Q",
      "info": "Starts with UC… (The Story Till Now is pre-filled)."
    },
    {
      "type": "range",
      "id": "youtube_count",
      "label": "Videos in grid (below featured)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "info": "Featured video is shown separately above the grid."
    },
    {
      "type": "range",
      "id": "youtube_min_seconds",
      "label": "Hide videos shorter than",
      "min": 0,
      "max": 600,
      "step": 10,
      "unit": "sec",
      "default": 180,
      "info": "Filters out YouTube Shorts (max length 180s). Videos at or under this length are hidden. Lower it if real short videos get hidden."
    },
    {
      "type": "checkbox",
      "id": "youtube_show_date",
      "label": "Show upload date label",
      "default": true
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "View All Videos"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section Sizing"
    },
    {
      "type": "range",
      "id": "section_padding_y",
      "label": "Section vertical padding",
      "min": 20,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100,
      "info": "Top & bottom padding (auto-reduced on mobile)"
    },
    {
      "type": "range",
      "id": "featured_aspect",
      "label": "Featured video aspect ratio (×100)",
      "min": 100,
      "max": 250,
      "step": 5,
      "default": 180,
      "info": "Width ÷ height × 100. 180 ≈ 16:9, 200 = wider, 150 = taller"
    },
    {
      "type": "range",
      "id": "card_aspect",
      "label": "Video card aspect ratio (×100)",
      "min": 100,
      "max": 250,
      "step": 5,
      "default": 180,
      "info": "Width ÷ height × 100. 180 ≈ 16:9"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Main heading size",
      "min": 32,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "featured_title_size",
      "label": "Featured video title size",
      "min": 18,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "stat_value_size",
      "label": "Stat number size",
      "min": 24,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Video card title size",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "youtube", "label": "YouTube" },
            { "value": "eye", "label": "Views (Eye)" },
