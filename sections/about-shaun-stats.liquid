{%- comment -%}
==========================================================================
TSTN — ABOUT SHAUN PAGE
SECTION 2 of 8: STATS BAR  (section type: about-shaun-stats)
4-up stat strip: icon, big number, label, sub-label. Add 1 block per stat.
==========================================================================
{%- endcomment -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&display=swap');
  @font-face {
    font-family: 'Danger Neue Free Regular';
    src: url('https://cdn.shopify.com/s/files/1/0686/9486/8103/files/Danger_Neue_Regular.ttf') format('truetype');
    font-weight: normal; font-style: normal; font-display: swap;
  }
  #shopify-section-{{ section.id }}{
    --tstn-bg: {{ section.settings.bg_color }};
    --tstn-card: {{ section.settings.card_color }};
    --tstn-accent: {{ section.settings.accent_color }};
    --tstn-text: {{ section.settings.text_color }};
    --tstn-muted: {{ section.settings.muted_color }};
    --tstn-pad-x: clamp(28px, 4vw, 64px);
    --tstn-maxw: 1600px;
  }
  #shopify-section-{{ section.id }} .ash-stats{
    background: var(--tstn-bg); color: var(--tstn-text);
    font-family: 'Rajdhani', sans-serif;
    padding: clamp(28px, 4vw, 56px) var(--tstn-pad-x);
  }
  #shopify-section-{{ section.id }} .ash-stats__wrap{ max-width: var(--tstn-maxw); margin: 0 auto; }
  #shopify-section-{{ section.id }} .ash-stats__grid{
    background: var(--tstn-card);
    border: 1px solid rgba(255,255,255,.06);
    border-radius: 10px;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, 1fr);
  }
  #shopify-section-{{ section.id }} .ash-stat{
    padding: clamp(28px, 3vw, 44px) clamp(18px, 2vw, 30px);
    text-align: center;
    border-left: 1px solid rgba(255,255,255,.07);
  }
  #shopify-section-{{ section.id }} .ash-stat:first-child{ border-left: 0; }
  #shopify-section-{{ section.id }} .ash-stat__icon{
    color: var(--tstn-accent); margin: 0 auto 16px; width: 38px; height: 38px;
  }
  #shopify-section-{{ section.id }} .ash-stat__icon svg{ width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .ash-stat__num{
    font-family: 'Danger Neue Free Regular', sans-serif;
    font-size: clamp(34px, 3.4vw, 50px); line-height: 1; margin-bottom: 12px;
  }
  #shopify-section-{{ section.id }} .ash-stat__label{
    font-size: 13px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; margin-bottom: 8px;
  }
  #shopify-section-{{ section.id }} .ash-stat__sub{
    font-size: 14px; color: var(--tstn-muted); line-height: 1.4;
  }
  @media (max-width: 749px){
    #shopify-section-{{ section.id }} .ash-stats__grid{ grid-template-columns: 1fr 1fr; }
    #shopify-section-{{ section.id }} .ash-stat:nth-child(odd){ border-left: 0; }
    #shopify-section-{{ section.id }} .ash-stat:nth-child(n+3){ border-top: 1px solid rgba(255,255,255,.07); }
  }
</style>

<div class="ash-stats">
  <div class="ash-stats__wrap">
    <div class="ash-stats__grid">
      {%- for block in section.blocks -%}
        <div class="ash-stat" {{ block.shopify_attributes }}>
          <div class="ash-stat__icon">
            {%- case block.settings.icon -%}
              {%- when 'pin' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {%- when 'mountain' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 19l6-10 4 6 2-3 6 7z"/></svg>
              {%- when 'flame' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3c1 3-2 4-2 7a2 2 0 0 0 4 0c0-1-.5-2-.5-2 2 1 3.5 3 3.5 5.5A5 5 0 1 1 7 16c0-3 3-4 5-13z"/></svg>
              {%- when 'video' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="13" height="12" rx="2"/><path d="M16 10l5-3v10l-5-3z"/></svg>
              {%- when 'compass' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 5-4 1 2-5z"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 19l6-10 4 6 2-3 6 7z"/></svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.number != blank -%}<div class="ash-stat__num">{{ block.settings.number }}</div>{%- endif -%}
          {%- if block.settings.label != blank -%}<div class="ash-stat__label">{{ block.settings.label }}</div>{%- endif -%}
          {%- if block.settings.sub != blank -%}<div class="ash-stat__sub">{{ block.settings.sub }}</div>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Shaun • Stats",
  "tag": "section",
  "class": "section-ash-stats",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#141414" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#ff6a1a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#9a9a9a" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "pin",
          "options": [
            { "value": "pin", "label": "Location pin" },
            { "value": "mountain", "label": "Mountain" },
            { "value": "flame", "label": "Campfire" },
            { "value": "video", "label": "Video" },
            { "value": "compass", "label": "Compass" }
          ] },
        { "type": "text", "id": "number", "label": "Number", "default": "210,000+" },
        { "type": "text", "id": "label", "label": "Label", "default": "KM TRAVELLED" },
        { "type": "text", "id": "sub", "label": "Sub-label", "default": "Across 4 continents" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Shaun • Stats",
      "blocks": [
        { "type": "stat", "settings": { "icon": "pin", "number": "210,000+", "label": "KM TRAVELLED", "sub": "Across 4 continents" } },
        { "type": "stat", "settings": { "icon": "mountain", "number": "48+", "label": "TRIPS TAKEN", "sub": "Remote backcountry expeditions" } },
        { "type": "stat", "settings": { "icon": "flame", "number": "6+", "label": "YEARS ON THE ROAD", "sub": "Full-time overlanding and exploring" } },
        { "type": "stat", "settings": { "icon": "video", "number": "500+", "label": "VIDEOS SHARED", "sub": "Real experiences. Zero fluff." } }
      ]
    }
  ]
}
{% endschema %}
