{%- comment -%}
  TSTN — Tag To Get Featured Promo Banner
  ---------------------------------------
  Glass promo strip: camera icon | divider | headline (bold = orange) | ghost TSTN mark.
  Self-contained, scoped to this section ID. Bold text in the headline renders orange.
{%- endcomment -%}

{%- liquid
  assign sid = section.id
  assign st = section.settings
-%}

<style>
  @font-face {
    font-family: 'Danger Neue Free Regular';
    src: url('{{ "DangerNeueFree-Regular.woff2" | asset_url }}') format('woff2'),
         url('https://fonts.cdnfonts.com/s/107588/DangerNeueFree-Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  #shopify-section-{{ sid }} {
    --tstn-bg: {{ st.bg_color }};
    --tstn-card: rgba(255, 255, 255, 0.03);
    --tstn-border: rgba(255, 255, 255, 0.08);
    --tstn-orange: #ff6a1a;
    --tstn-text: #f5f5f5;
    --tstn-muted: #9a9a9a;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo {
    background: var(--tstn-bg);
    padding: {{ st.pad_top }}px clamp(16px, 4vw, 56px) {{ st.pad_bottom }}px;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__inner {
    max-width: 1600px;
    margin: 0 auto;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__card {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(28px, 4.5vw, 64px) clamp(24px, 5vw, 72px);
    background: var(--tstn-card);
    border: 1px solid var(--tstn-border);
    border-radius: clamp(20px, 2.5vw, 32px);
    overflow: hidden;
    transition: border-color 0.4s ease;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__card:hover {
    border-color: rgba(255, 106, 26, 0.25);
  }

  /* soft top sheen */
  #shopify-section-{{ sid }} .tstn-tagpromo__card::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% -30%, rgba(255, 255, 255, 0.05), transparent 60%),
      radial-gradient(60% 120% at 105% 50%, rgba(255, 106, 26, 0.05), transparent 70%);
    pointer-events: none;
  }

  /* ---- Icon ---- */
  #shopify-section-{{ sid }} .tstn-tagpromo__icon {
    position: relative;
    flex: 0 0 auto;
    width: clamp(96px, 11vw, 168px);
    height: clamp(96px, 11vw, 168px);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__icon svg {
    width: 52%;
    height: 52%;
    display: block;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__icon img {
    width: 56%;
    height: 56%;
    object-fit: contain;
    display: block;
  }

  /* ---- Divider ---- */
  #shopify-section-{{ sid }} .tstn-tagpromo__divider {
    flex: 0 0 1px;
    align-self: stretch;
    min-height: clamp(96px, 11vw, 168px);
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(255, 255, 255, 0.18) 20%,
      rgba(255, 255, 255, 0.18) 80%,
      transparent
    );
  }

  /* ---- Headline ---- */
  #shopify-section-{{ sid }} .tstn-tagpromo__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__heading {
    margin: 0;
    font-family: 'Danger Neue Free Regular', 'Rajdhani', sans-serif;
    font-size: clamp({{ st.text_size_mobile }}px, 3.2vw, {{ st.text_size }}px);
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--tstn-text);
    max-width: 26ch;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__heading strong,
  #shopify-section-{{ sid }} .tstn-tagpromo__heading b {
    font-weight: inherit;
    color: var(--tstn-orange);
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__sub {
    margin: 14px 0 0;
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(14px, 1.3vw, 17px);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tstn-muted);
  }

  /* ---- Ghost mark ---- */
  #shopify-section-{{ sid }} .tstn-tagpromo__mark {
    flex: 0 0 auto;
    width: clamp(110px, 13vw, 200px);
    opacity: 0.16;
    pointer-events: none;
    user-select: none;
  }

  #shopify-section-{{ sid }} .tstn-tagpromo__mark img,
  #shopify-section-{{ sid }} .tstn-tagpromo__mark svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---- Mobile ---- */
  @media (max-width: 749px) {
    #shopify-section-{{ sid }} .tstn-tagpromo__card {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    #shopify-section-{{ sid }} .tstn-tagpromo__icon {
      width: 84px;
      height: 84px;
    }

    #shopify-section-{{ sid }} .tstn-tagpromo__divider {
      flex: 0 0 auto;
      align-self: auto;
      width: 56px;
      min-height: 0;
      height: 1px;
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0.18),
        transparent
      );
    }

    #shopify-section-{{ sid }} .tstn-tagpromo__heading {
      max-width: none;
    }

    #shopify-section-{{ sid }} .tstn-tagpromo__mark {
      position: absolute;
      right: 18px;
      bottom: 18px;
      width: 72px;
      opacity: 0.1;
    }
  }
</style>

<div class="tstn-tagpromo">
  <div class="tstn-tagpromo__inner">
    <div class="tstn-tagpromo__card">

      {%- comment -%} Icon {%- endcomment -%}
      <div class="tstn-tagpromo__icon" aria-hidden="true">
        {%- if st.icon_image != blank -%}
          <img
            src="{{ st.icon_image | image_url: width: 300 }}"
            alt=""
            loading="lazy"
            width="150"
            height="150"
          >
        {%- else -%}
          <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            {%- comment -%} viewfinder corner brackets {%- endcomment -%}
            <path d="M14 22v-5a3 3 0 0 1 3-3h5" stroke="#ff6a1a" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M50 22v-5a3 3 0 0 0-3-3h-5" stroke="#ff6a1a" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M14 44v5a3 3 0 0 0 3 3h5" stroke="#ff6a1a" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M50 44v5a3 3 0 0 1-3 3h-5" stroke="#ff6a1a" stroke-width="2.5" stroke-linecap="round"/>
            {%- comment -%} camera body {%- endcomment -%}
            <rect x="20" y="26" width="24" height="17" rx="3" stroke="#ff6a1a" stroke-width="2.5"/>
            <path d="M26 26l2.2-3.4a2 2 0 0 1 1.7-.9h4.2a2 2 0 0 1 1.7.9L38 26" stroke="#ff6a1a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="32" cy="34.5" r="5" stroke="#ff6a1a" stroke-width="2.5"/>
            {%- comment -%} sparkle plus {%- endcomment -%}
            <path d="M52 8v6M49 11h6" stroke="#ff6a1a" stroke-width="2" stroke-linecap="round"/>
            <circle cx="45.5" cy="9.5" r="1" fill="#ff6a1a"/>
          </svg>
        {%- endif -%}
      </div>

      {%- comment -%} Divider {%- endcomment -%}
      <div class="tstn-tagpromo__divider" aria-hidden="true"></div>

      {%- comment -%} Headline {%- endcomment -%}
      <div class="tstn-tagpromo__text">
        {%- assign heading_check = st.heading | strip_html | strip -%}
        {%- if heading_check != blank -%}
          <h2 class="tstn-tagpromo__heading">{{ st.heading }}</h2>
        {%- endif -%}
        {%- assign sub_check = st.subtext | strip_html | strip -%}
        {%- if sub_check != blank -%}
          <p class="tstn-tagpromo__sub">{{ st.subtext }}</p>
        {%- endif -%}
      </div>

      {%- comment -%} Ghost TSTN mark {%- endcomment -%}
      {%- if st.show_mark -%}
        <div class="tstn-tagpromo__mark" aria-hidden="true">
          {%- if st.mark_image != blank -%}
            <img
              src="{{ st.mark_image | image_url: width: 400 }}"
              alt=""
              loading="lazy"
              width="200"
              height="200"
            >
          {%- else -%}
            <svg viewBox="0 0 120 140" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="3" y="3" width="114" height="134" stroke="#ffffff" stroke-width="3"/>
              <text x="18" y="62" font-family="'Danger Neue Free Regular', 'Rajdhani', sans-serif" font-size="48" fill="#ffffff">T</text>
              <text x="68" y="62" font-family="'Danger Neue Free Regular', 'Rajdhani', sans-serif" font-size="48" fill="#ffffff">S</text>
              <text x="18" y="118" font-family="'Danger Neue Free Regular', 'Rajdhani', sans-serif" font-size="48" fill="#ffffff">T</text>
              <text x="68" y="118" font-family="'Danger Neue Free Regular', 'Rajdhani', sans-serif" font-size="48" fill="#ffffff">N</text>
            </svg>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "TSTN Tag Promo",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Headline",
      "info": "Bold text renders in orange.",
      "default": "Tag <strong>@tstn.club</strong> to get featured and earn <strong>500 points</strong> if your picture get selected"
    },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Subtext (optional)"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Custom icon image",
      "info": "Leave empty to use the built-in camera icon."
    },
    {
      "type": "header",
      "content": "TSTN mark"
    },
    {
      "type": "checkbox",
      "id": "show_mark",
      "label": "Show ghost TSTN mark",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "mark_image",
      "label": "Custom mark image",
      "info": "Leave empty to use the built-in TSTN mark. A transparent PNG/SVG of your logo works best."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Headline size (desktop)",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Headline size (mobile)",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "TSTN Tag Promo"
    }
  ]
}
{% endschema %}
