    { "type": "textarea", "id": "featured_description", "label": "Description", "default": "Epic weekend run through the Rockies with the crew. Views, snow, and good vibes." },
    { "type": "text", "id": "featured_author", "label": "Author name", "default": "Dylan M." },
    { "type": "image_picker", "id": "featured_avatar", "label": "Author avatar" },
    { "type": "text", "id": "featured_photos", "label": "Photo count", "default": "28" },
    { "type": "text", "id": "featured_likes", "label": "Like count", "default": "142" },
    { "type": "text", "id": "featured_location_label", "label": "Location", "info": "Shown in lightbox with a pin icon. e.g. 'Banff National Park, Alberta'." },
    { "type": "url", "id": "featured_location_url", "label": "Location URL", "info": "Optional Google Maps or Apple Maps URL. If empty, a Google Maps search is auto-generated from the label." },

    { "type": "header", "content": "Sidebar" },
    { "type": "checkbox", "id": "show_sidebar", "label": "Show sidebar", "default": true },
    { "type": "text", "id": "qf_title", "label": "Quick filters title", "default": "QUICK FILTERS" },

    { "type": "header", "content": "Interactions (Likes, Comments, Share)" },
    { "type": "paragraph", "content": "Likes and comments are stored locally in each visitor's browser by default. Wire optional endpoints below to persist them server-side." },
    { "type": "checkbox", "id": "show_likes", "label": "Enable likes", "default": true },
    { "type": "checkbox", "id": "show_comments", "label": "Enable comments", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Enable share button", "default": true },
    { "type": "url", "id": "like_endpoint", "label": "Like endpoint URL", "info": "Optional. POST receives { image_id, customer_id, action: 'like' | 'unlike' }." },
    { "type": "url", "id": "comments_endpoint", "label": "Comments endpoint URL", "info": "Optional. POST receives { image_id, customer_id, author, body }." },
    { "type": "text", "id": "share_text", "label": "Share text", "default": "Check out this shot from the TSTN community" },

    { "type": "header", "content": "Stats" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "2,400+" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Photos" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "380+" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Community Uploads" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "120" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Featured Builds" },

    { "type": "header", "content": "Bottom Strip" },
    { "type": "checkbox", "id": "show_bottom_strip", "label": "Show bottom strip", "default": true },
    { "type": "text", "id": "tagline_text", "label": "Tagline", "default": "REAL PEOPLE. REAL RIGS. REAL ADVENTURES." },
    { "type": "text", "id": "powered_by_text", "label": "Powered by text", "default": "POWERED BY THE TSTN COMMUNITY" }
  ],
  "blocks": [
    {
      "type": "gallery_item",
      "name": "Gallery Item",
      "limit": 16,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
