            { "value": "sparkle", "label": "New Uploads" },
            { "value": "compass", "label": "Compass" },
            { "value": "wrench", "label": "Wrench" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community Gallery",
      "blocks": [
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "gallery_item" },
        { "type": "quick_filter" },
        { "type": "quick_filter" },
        { "type": "quick_filter" },
        { "type": "quick_filter" },
        { "type": "quick_filter" },
        { "type": "quick_filter" },
        { "type": "quick_filter" }
      ]
    }
  ]
}
