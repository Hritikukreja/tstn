    -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
  }
  .tstn-gal__lightbox-close {
    width: 42px;
    height: 42px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.22s var(--lb-ease);
    box-shadow: none !important;
    -webkit-appearance: none;
    -webkit-backdrop-filter: blur(12px);
            backdrop-filter: blur(12px);
  }
  .tstn-gal__lightbox-close:hover {
    background: var(--tstn-accent);
    border-color: var(--tstn-accent);
    transform: scale(1.05);
  }
  .tstn-gal__lightbox-close svg { width: 18px; height: 18px; }

  /* Stage (clips the sliding figure) */
  .tstn-gal__lightbox-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 80px 90px 110px;
    box-sizing: border-box;
  }

  /* Two stacked figures — one shown, one queued — for crossfade-slide */
  .tstn-gal__lightbox-figure {
    position: absolute;
    inset: 80px 90px 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      transform var(--lb-duration) var(--lb-ease),
      opacity var(--lb-duration) var(--lb-ease);
    will-change: transform, opacity;
    pointer-events: none;
  }
  .tstn-gal__lightbox-figure img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 30px 90px rgba(0,0,0,0.6);
    user-select: none;
    -webkit-user-drag: none;
  }
  /* Active figure */
  .tstn-gal__lightbox-figure.is-active {
    opacity: 1;
    transform: translateX(0) scale(1);
    pointer-events: auto;
  }
  /* Inactive figures wait off to the right by default */
  .tstn-gal__lightbox-figure.is-inactive {
    opacity: 0;
    transform: translateX(8%) scale(0.97);
  }
  /* Direction-aware enter/leave states */
  .tstn-gal__lightbox-figure.is-leaving-left {
    opacity: 0;
    transform: translateX(-8%) scale(0.97);
  }
  .tstn-gal__lightbox-figure.is-leaving-right {
    opacity: 0;
    transform: translateX(8%) scale(0.97);
  }
  .tstn-gal__lightbox-figure.is-entering-from-right {
    opacity: 0;
    transform: translateX(8%) scale(0.97);
  }
  .tstn-gal__lightbox-figure.is-entering-from-left {
    opacity: 0;
    transform: translateX(-8%) scale(0.97);
  }
  /* Touch-drag (no transition while finger is down) */
  .tstn-gal__lightbox-figure.is-dragging {
    transition: none;
  }
  /* Initial open zoom-in */
  .tstn-gal__lightbox:not(.is-open) .tstn-gal__lightbox-figure {
    transform: scale(0.94);
    opacity: 0;
  }

  /* Arrows */
  .tstn-gal__lightbox-nav {
    position: absolute;
