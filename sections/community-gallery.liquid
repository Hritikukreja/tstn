    display: block;
    background: rgba(34,197,94,0.12);
    border: 1px solid rgba(34,197,94,0.3);
    color: #4ade80;
  }
  .tstn-gal__upmodal-status.is-error {
    display: block;
    background: rgba(239,68,68,0.12);
    border: 1px solid rgba(239,68,68,0.3);
    color: #f87171;
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 1280px) {
    .tstn-gal__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
    .tstn-gal__sidebar {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .tstn-gal__sidebar > * { flex: 1 1 240px; }
  }

  @media (max-width: 900px) {
    .tstn-gal__grid { grid-template-columns: 1fr; }
    .tstn-gal__items { grid-template-columns: repeat(2, 1fr); }
    .tstn-gal__featured-img { min-height: 280px; }
    .tstn-gal__filterbar { padding: 8px; gap: 8px; }
    .tstn-gal__search { width: 100%; flex: 1 1 200px; }
    .tstn-gal__sidebar { flex-direction: column; }
    .tstn-gal__bg-img { width: 80%; height: 280px; top: -40px; }
  }

  @media (max-width: 600px) {
    .tstn-gal__items { grid-template-columns: 1fr; }
    .tstn-gal__pills {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    .tstn-gal__pills::-webkit-scrollbar { display: none; }
    .tstn-gal__strip-side { font-size: 10px; gap: 8px; letter-spacing: 0.15em; }
    .tstn-gal__strip { padding: 14px 18px; }
    .tstn-gal__featured-title { font-size: 18px; }
  }
</style>

<section class="tstn-gal">
  {%- comment -%} =============== HEADER =============== {%- endcomment -%}
  <header class="tstn-gal__header">
    {%- if section.settings.bg_image != blank -%}
      <div class="tstn-gal__bg-img" style="opacity: {{ section.settings.bg_image_opacity | divided_by: 100.0 }};">
        <img src="{{ section.settings.bg_image | image_url: width: 1800 }}"
             alt=""
             loading="lazy"
             width="{{ section.settings.bg_image.width }}"
             height="{{ section.settings.bg_image.height }}">
      </div>
    {%- endif -%}

    {%- if section.settings.tag_text != blank -%}
      <div class="tstn-gal__breadcrumb" style="color: {{ section.settings.tag_color }};">
        <span>{{ section.settings.tag_text }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="tstn-gal__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="tstn-gal__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </header>

  {%- comment -%} =============== FILTER BAR =============== {%- endcomment -%}
  {%- if section.settings.show_filter_bar -%}
    <div class="tstn-gal__filterbar">
      <div class="tstn-gal__pills">
        <button type="button" class="tstn-gal__pill is-active"><span>All</span></button>
        <button type="button" class="tstn-gal__pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h2l1-4h12l1 4h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 13V8h12l2 5"/></svg>
          <span>Rigs</span>
        </button>
        <button type="button" class="tstn-gal__pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
          <span>Trips</span>
        </button>
        <button type="button" class="tstn-gal__pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <span>Builds</span>
        </button>
        <button type="button" class="tstn-gal__pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>Campsites</span>
        </button>
        <button type="button" class="tstn-gal__pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Community</span>
        </button>
        <button type="button" class="tstn-gal__pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18l-2 13H5L3 6z"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span>Gear</span>
        </button>
      </div>

      <div class="tstn-gal__spacer"></div>

      <div class="tstn-gal__search">
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" placeholder="{{ section.settings.search_placeholder }}" aria-label="Search the gallery">
      </div>

      <select class="tstn-gal__sort" aria-label="Sort">
        <option>Newest</option>
        <option>Most Liked</option>
        <option>Most Photos</option>
      </select>

      <label class="tstn-gal__toggle">
        <input type="checkbox">
        <span class="tstn-gal__switch"></span>
        <span>Only community uploads</span>
      </label>

      <div class="tstn-gal__viewmode">
        <button type="button" class="tstn-gal__viewbtn is-active" aria-label="Grid view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </button>
        <button type="button" class="tstn-gal__viewbtn" aria-label="Column view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="18" rx="1"/></svg>
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} =============== MAIN GRID =============== {%- endcomment -%}
  <div class="tstn-gal__grid{% unless customer %} is-locked{% endunless %}">

    {%- unless customer -%}
      {%- comment -%} ----- LOGIN GATE OVERLAY ----- {%- endcomment -%}
      <div class="tstn-gal__lock" aria-live="polite">
        <div class="tstn-gal__lock-card">
          {%- if section.settings.gate_pill != blank -%}
            <span class="tstn-gal__lock-pill">{{ section.settings.gate_pill }}</span>
          {%- endif -%}
          <div class="tstn-gal__lock-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          {%- if section.settings.gate_title != blank -%}
            <h3 class="tstn-gal__lock-title">{{ section.settings.gate_title }}</h3>
          {%- endif -%}
          {%- if section.settings.gate_description != blank -%}
            <p class="tstn-gal__lock-desc">{{ section.settings.gate_description }}</p>
          {%- endif -%}
          <div class="tstn-gal__lock-actions">
            {%- if section.settings.gate_join_text != blank -%}
              <a href="{{ section.settings.gate_join_link | default: routes.account_register_url }}" class="tstn-gal__lock-join">{{ section.settings.gate_join_text }}</a>
            {%- endif -%}
            {%- if section.settings.gate_login_text != blank -%}
              <a href="{{ section.settings.gate_login_link | default: routes.account_login_url }}" class="tstn-gal__lock-login">{{ section.settings.gate_login_text }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endunless -%}

    {%- comment -%} ----- FEATURED STORY ----- {%- endcomment -%}
    {%- if section.settings.show_featured -%}
      <a href="{{ section.settings.featured_link | default: '#' }}" class="tstn-gal__featured">
        <div class="tstn-gal__featured-img">
          {%- if section.settings.featured_image != blank -%}
            <img src="{{ section.settings.featured_image | image_url: width: 900 }}"
                 alt="{{ section.settings.featured_title | escape }}"
                 loading="lazy"
                 width="{{ section.settings.featured_image.width }}"
                 height="{{ section.settings.featured_image.height }}"
                 data-lightbox-src="{{ section.settings.featured_image | image_url: width: 1800 }}">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if section.settings.featured_badge != blank -%}
            <span class="tstn-gal__featured-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {{ section.settings.featured_badge }}
            </span>
          {%- endif -%}
        </div>
        <div class="tstn-gal__featured-body">
          {%- if section.settings.featured_category != blank -%}
            <div class="tstn-gal__cat">{{ section.settings.featured_category }}</div>
          {%- endif -%}
          {%- if section.settings.featured_title != blank -%}
            <h3 class="tstn-gal__featured-title">{{ section.settings.featured_title }}</h3>
          {%- endif -%}
          {%- if section.settings.featured_description != blank -%}
            <p class="tstn-gal__featured-desc">{{ section.settings.featured_description }}</p>
          {%- endif -%}
          <div class="tstn-gal__featured-meta">
            <div class="tstn-gal__author">
              <div class="tstn-gal__author-avatar">
                {%- if section.settings.featured_avatar != blank -%}
                  <img src="{{ section.settings.featured_avatar | image_url: width: 60 }}" alt="" loading="lazy">
                {%- endif -%}
              </div>
              <span class="tstn-gal__author-name">{{ section.settings.featured_author }}</span>
            </div>
            <div class="tstn-gal__featured-stats">
              {%- if section.settings.featured_photos != blank -%}
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  {{ section.settings.featured_photos }}
                </span>
              {%- endif -%}
              {%- if section.settings.featured_likes != blank -%}
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {{ section.settings.featured_likes }}
                </span>
              {%- endif -%}
            </div>
          </div>
        </div>
      </a>
    {%- endif -%}

    {%- comment -%} ----- ITEMS GRID ----- {%- endcomment -%}
    <div class="tstn-gal__items">
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery_item' -%}
          <div class="tstn-gal__card" role="button" tabindex="0" data-lightbox-trigger {{ block.shopify_attributes }}>
            <div class="tstn-gal__card-img">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}"
                     alt="{{ block.settings.title | escape }}"
                     loading="lazy"
                     width="{{ block.settings.image.width }}"
                     height="{{ block.settings.image.height }}"
                     data-lightbox-src="{{ block.settings.image | image_url: width: 1800 }}">
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
              {%- if block.settings.photo_count != blank -%}
                <span class="tstn-gal__photocount">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  {{ block.settings.photo_count }}
                </span>
              {%- endif -%}
              <span class="tstn-gal__expand" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
              </span>
              {%- if block.settings.category != blank -%}
                <div class="tstn-gal__card-cat-overlay">{{ block.settings.category }}</div>
              {%- endif -%}
            </div>
            <div class="tstn-gal__card-body">
              {%- if block.settings.title != blank -%}
                <div class="tstn-gal__card-title">{{ block.settings.title }}</div>
              {%- endif -%}
              <div class="tstn-gal__card-meta">
                <div class="tstn-gal__author tstn-gal__card-author">
                  <div class="tstn-gal__author-avatar">
                    {%- if block.settings.avatar != blank -%}
                      <img src="{{ block.settings.avatar | image_url: width: 50 }}" alt="" loading="lazy">
                    {%- endif -%}
                  </div>
                  <span class="tstn-gal__author-name">{{ block.settings.author_name }}</span>
                </div>
                {%- if block.settings.like_count != blank -%}
                  <span class="tstn-gal__likes">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    {{ block.settings.like_count }}
                  </span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ----- SIDEBAR ----- {%- endcomment -%}
    {%- if section.settings.show_sidebar -%}
      <aside class="tstn-gal__sidebar">

        {%- comment -%} Quick Filters {%- endcomment -%}
        <div class="tstn-gal__panel">
          {%- if section.settings.qf_title != blank -%}
            <h4 class="tstn-gal__panel-title">{{ section.settings.qf_title }}</h4>
          {%- endif -%}
          <div class="tstn-gal__chips">
            {%- for block in section.blocks -%}
              {%- if block.type == 'quick_filter' -%}
                <a href="{{ block.settings.link | default: '#' }}" class="tstn-gal__chip" {{ block.shopify_attributes }}>
                  {%- case block.settings.icon -%}
                    {%- when 'snowflake' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/><line x1="19.07" y1="4.93" x2="4.93" y2="19.07"/></svg>
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h2l1-4h12l1 4h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 13V8h12l2 5"/></svg>
                    {%- when 'jeep' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17V11l2-5h10l2 5v6"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><line x1="9" y1="11" x2="15" y2="11"/></svg>
                    {%- when 'fire' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 9.5C14.5 7 12 4 12 4S9.5 7 9.5 9.5C9.5 12 12 13 12 13s2.5-1 2.5-3.5z"/><path d="M8.5 14.5A3.5 3.5 0 0 0 12 18a3.5 3.5 0 0 0 3.5-3.5C15.5 13 13.5 11 12 10.5c-1.5 0.5-3.5 2.5-3.5 4z"/></svg>
                    {%- when 'tent' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 19l9-15 9 15"/><path d="M12 4v15"/><path d="M3 19h18"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'sparkle' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3z"/></svg>
                    {%- when 'compass' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                    {%- when 'wrench' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                  {%- endcase -%}
                  <span>{{ block.settings.label }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Upload card {%- endcomment -%}
        <div class="tstn-gal__upload">
          <div class="tstn-gal__upload-head">
            <div class="tstn-gal__upload-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            </div>
            <div>
              {%- if section.settings.upload_title != blank -%}
                <h4 class="tstn-gal__upload-title">{{ section.settings.upload_title }}</h4>
              {%- endif -%}
              {%- if section.settings.upload_description != blank -%}
                <p class="tstn-gal__upload-desc">{{ section.settings.upload_description }}</p>
              {%- endif -%}
            </div>
          </div>
          {%- if section.settings.upload_button_text != blank -%}
            <button type="button" class="tstn-gal__upload-btn" data-upload-trigger>{{ section.settings.upload_button_text }}</button>
            <input type="file" accept="image/*" multiple class="tstn-gal__upload-input" data-upload-input hidden>
          {%- endif -%}
        </div>

        {%- comment -%} Stats {%- endcomment -%}
        <div class="tstn-gal__panel tstn-gal__stats">
          {%- if section.settings.stat_1_value != blank -%}
            <div class="tstn-gal__stat">
              <div class="tstn-gal__stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              </div>
              <div>
                <div class="tstn-gal__stat-value">{{ section.settings.stat_1_value }}</div>
                <div class="tstn-gal__stat-label">{{ section.settings.stat_1_label }}</div>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.stat_2_value != blank -%}
            <div class="tstn-gal__stat">
              <div class="tstn-gal__stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <div class="tstn-gal__stat-value">{{ section.settings.stat_2_value }}</div>
                <div class="tstn-gal__stat-label">{{ section.settings.stat_2_label }}</div>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.stat_3_value != blank -%}
            <div class="tstn-gal__stat">
              <div class="tstn-gal__stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div>
                <div class="tstn-gal__stat-value">{{ section.settings.stat_3_value }}</div>
                <div class="tstn-gal__stat-label">{{ section.settings.stat_3_label }}</div>
              </div>
            </div>
          {%- endif -%}
        </div>

      </aside>
    {%- endif -%}
  </div>

  {%- comment -%} =============== BOTTOM STRIP =============== {%- endcomment -%}
  {%- if section.settings.show_bottom_strip -%}
    <div class="tstn-gal__strip">
      <div class="tstn-gal__strip-side">
        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M3 20l5-12 4 6 4-9 5 15z"/></svg>
        <span>{{ section.settings.tagline_text }}</span>
      </div>
      <div class="tstn-gal__strip-side">
        <span>{{ section.settings.powered_by_text }}</span>
        <svg viewBox="0 0 70 14" fill="currentColor" preserveAspectRatio="none" width="70" height="14"><path d="M2 7 Q18 1 35 7 T68 7 L66 10 Q44 14 35 9 T4 9 Z" opacity="0.9"/></svg>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} =============== UPLOAD MODAL =============== {%- endcomment -%}
  {%- if customer -%}
    <div class="tstn-gal__upmodal" id="tstn-upmodal-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true">
      <div class="tstn-gal__upmodal-card">
        <button type="button" class="tstn-gal__upmodal-close" aria-label="Close" data-upload-close>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
        <h3 class="tstn-gal__upmodal-title">{{ section.settings.upload_modal_title | default: 'Share Your Adventure' }}</h3>
        <p class="tstn-gal__upmodal-sub">{{ section.settings.upload_modal_sub | default: 'Drag photos in or click to browse. JPG, PNG up to 10MB each.' }}</p>

        <div class="tstn-gal__dropzone" data-upload-dropzone>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <span class="tstn-gal__dropzone-main">Drop photos here or <em>browse files</em></span>
          <span class="tstn-gal__dropzone-sub">Up to {{ section.settings.upload_max_files | default: 10 }} images</span>
        </div>

        <div class="tstn-gal__previews" data-upload-previews></div>

        <div class="tstn-gal__upmodal-fields">
          <label class="tstn-gal__field">
            <span>Title</span>
            <input type="text" data-upload-field="title" placeholder="Snow run in the Rockies" maxlength="80">
          </label>
          <label class="tstn-gal__field">
            <span>Caption</span>
            <textarea data-upload-field="caption" placeholder="Tell us about this trip…" maxlength="500" rows="3"></textarea>
          </label>
          <label class="tstn-gal__field">
            <span>Category</span>
            <select data-upload-field="category">
              <option value="">Choose…</option>
              <option value="rig">Rig</option>
              <option value="trip">Trip</option>
              <option value="build">Build</option>
              <option value="campsite">Campsite</option>
              <option value="gear">Gear</option>
            </select>
          </label>
        </div>

        <div class="tstn-gal__upmodal-actions">
          <button type="button" class="tstn-gal__upmodal-cancel" data-upload-close>Cancel</button>
          <button type="button" class="tstn-gal__upmodal-submit" data-upload-submit disabled>
            <span class="tstn-gal__upmodal-submit-label">Submit</span>
            <span class="tstn-gal__upmodal-spinner" aria-hidden="true"></span>
          </button>
        </div>

        <div class="tstn-gal__upmodal-status" data-upload-status role="status"></div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} =============== LIGHTBOX =============== {%- endcomment -%}
  <div class="tstn-gal__lightbox" id="tstn-lightbox-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="tstn-gal__lightbox-topbar">
      <div class="tstn-gal__lightbox-counter" data-lb-counter>1 / 1</div>
      <button type="button" class="tstn-gal__lightbox-close" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <button type="button" class="tstn-gal__lightbox-nav is-prev" aria-label="Previous image" data-lb-prev>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="tstn-gal__lightbox-nav is-next" aria-label="Next image" data-lb-next>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <div class="tstn-gal__lightbox-stage">
      <div class="tstn-gal__lightbox-figure is-active" data-lb-figure="0">
        <img src="" alt="">
      </div>
      <div class="tstn-gal__lightbox-figure is-inactive" data-lb-figure="1">
        <img src="" alt="">
      </div>
    </div>

    <div class="tstn-gal__lightbox-thumbs" data-lb-thumbs></div>
    <div class="tstn-gal__lightbox-caption is-empty" data-lb-caption></div>
  </div>

</section>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var lightbox = section.querySelector('.tstn-gal__lightbox');
    var closeBtn = lightbox.querySelector('.tstn-gal__lightbox-close');
    var prevBtn = lightbox.querySelector('[data-lb-prev]');
    var nextBtn = lightbox.querySelector('[data-lb-next]');
    var counterEl = lightbox.querySelector('[data-lb-counter]');
    var captionEl = lightbox.querySelector('[data-lb-caption]');
    var thumbsEl = lightbox.querySelector('[data-lb-thumbs]');
    var figures = lightbox.querySelectorAll('.tstn-gal__lightbox-figure');
    var stage = lightbox.querySelector('.tstn-gal__lightbox-stage');

    // Build the gallery list from all card images in the section
    var items = [];
    section.querySelectorAll('img[data-lightbox-src]').forEach(function(img) {
      var card = img.closest('.tstn-gal__card') || img.closest('.tstn-gal__featured');
      var title = '';
      var author = '';
      if (card) {
        var t = card.querySelector('.tstn-gal__card-title, .tstn-gal__featured-title');
        var a = card.querySelector('.tstn-gal__author-name');
        if (t) title = t.textContent.trim();
        if (a) author = a.textContent.trim();
      }
      items.push({
        src: img.getAttribute('data-lightbox-src'),
        thumb: img.src,
        title: title,
        author: author
      });
    });

    var currentIndex = 0;
    var activeIdx = 0; // which of the two figures is currently active (0 or 1)
    var isAnimating = false;
    var transitionMs = 460;

    function getFigureImg(figIdx) {
      return figures[figIdx].querySelector('img');
    }

    function preload(idx) {
      if (idx < 0 || idx >= items.length) return;
      var pre = new Image();
      pre.src = items[idx].src;
    }

    function updateCounter() {
      counterEl.textContent = (currentIndex + 1) + ' / ' + items.length;
    }

    function updateCaption(swap) {
      var item = items[currentIndex];
      var hasContent = item && (item.title || item.author);
      if (!hasContent) {
        captionEl.classList.add('is-empty');
        captionEl.innerHTML = '';
        return;
      }
      var render = function() {
        var html = '';
        if (item.title) html += '<p class="tstn-gal__lightbox-caption-title">' + escapeHtml(item.title) + '</p>';
        if (item.author) html += '<p class="tstn-gal__lightbox-caption-author">by ' + escapeHtml(item.author) + '</p>';
        captionEl.innerHTML = html;
        captionEl.classList.remove('is-empty');
      };
      if (swap) {
        captionEl.classList.add('is-swapping');
        setTimeout(function() {
          render();
          requestAnimationFrame(function() {
            captionEl.classList.remove('is-swapping');
          });
        }, 180);
      } else {
        render();
      }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function(c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function buildThumbs() {
      thumbsEl.innerHTML = '';
      // Show ~5 thumbs centered on current
      var span = 2; // 2 before + current + 2 after
      var start = Math.max(0, currentIndex - span);
      var end = Math.min(items.length - 1, currentIndex + span);
      // Prefer to keep 5 visible by extending whichever side has room
      while (end - start < 4 && (start > 0 || end < items.length - 1)) {
        if (start > 0) start--;
        else if (end < items.length - 1) end++;
        if (end - start >= 4) break;
      }
      for (var i = start; i <= end; i++) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'tstn-gal__lightbox-thumb' + (i === currentIndex ? ' is-active' : '');
        btn.setAttribute('aria-label', 'Go to image ' + (i + 1));
        btn.setAttribute('data-lb-thumb-idx', i);
        var im = document.createElement('img');
        im.src = items[i].thumb;
        im.alt = '';
        btn.appendChild(im);
        thumbsEl.appendChild(btn);
      }
      thumbsEl.querySelectorAll('[data-lb-thumb-idx]').forEach(function(t) {
        t.addEventListener('click', function() {
          var idx = parseInt(t.getAttribute('data-lb-thumb-idx'), 10);
          if (idx === currentIndex) return;
          var dir = idx > currentIndex ? 1 : -1;
          goTo(idx, dir);
        });
      });
    }

    function setFigure(figIdx, src) {
      var img = getFigureImg(figIdx);
      img.src = src;
    }

    function openLightbox(src) {
      if (!src) return;
      // Find index of clicked image
      var idx = items.findIndex(function(it) { return it.src === src; });
      if (idx === -1) idx = 0;
      currentIndex = idx;
      activeIdx = 0;

      // Set both figures to a clean state
      figures[0].classList.add('is-active');
      figures[0].classList.remove('is-inactive', 'is-leaving-left', 'is-leaving-right', 'is-entering-from-left', 'is-entering-from-right');
      figures[1].classList.add('is-inactive');
      figures[1].classList.remove('is-active', 'is-leaving-left', 'is-leaving-right', 'is-entering-from-left', 'is-entering-from-right');

      setFigure(0, items[currentIndex].src);
      setFigure(1, '');

      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      updateCounter();
      updateCaption(false);
      buildThumbs();
      preload(currentIndex + 1);
      preload(currentIndex - 1);
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      // Clear srcs after transition for memory
      setTimeout(function() {
        if (!lightbox.classList.contains('is-open')) {
          getFigureImg(0).src = '';
          getFigureImg(1).src = '';
        }
      }, 400);
    }

    function goTo(newIndex, direction) {
      if (isAnimating) return;
      if (items.length <= 1) return;
      // Wrap around
      if (newIndex < 0) newIndex = items.length - 1;
      if (newIndex >= items.length) newIndex = 0;
      if (newIndex === currentIndex) return;

      isAnimating = true;
      var nextActiveIdx = activeIdx === 0 ? 1 : 0;
      var current = figures[activeIdx];
      var incoming = figures[nextActiveIdx];

      // Set up incoming figure
      setFigure(nextActiveIdx, items[newIndex].src);
      incoming.classList.remove('is-active', 'is-inactive', 'is-leaving-left', 'is-leaving-right', 'is-entering-from-left', 'is-entering-from-right');
      // Position it on the side it should enter from
      if (direction > 0) {
        incoming.classList.add('is-entering-from-right');
      } else {
        incoming.classList.add('is-entering-from-left');
      }

      // Force a reflow so the initial position takes effect before transitioning
      // eslint-disable-next-line no-unused-expressions
      incoming.offsetWidth;

      // Animate
      requestAnimationFrame(function() {
        // Outgoing slides away in the direction of motion
        current.classList.remove('is-active');
        current.classList.add(direction > 0 ? 'is-leaving-left' : 'is-leaving-right');
        // Incoming slides into active position
        incoming.classList.remove('is-entering-from-right', 'is-entering-from-left');
        incoming.classList.add('is-active');
      });

      currentIndex = newIndex;
      activeIdx = nextActiveIdx;

      updateCounter();
      updateCaption(true);
      buildThumbs();
      preload(currentIndex + 1);
      preload(currentIndex - 1);

      setTimeout(function() {
        // Clean up the outgoing figure
        current.classList.remove('is-leaving-left', 'is-leaving-right');
        current.classList.add('is-inactive');
        isAnimating = false;
      }, transitionMs);
    }

    function next() { goTo(currentIndex + 1, 1); }
    function prev() { goTo(currentIndex - 1, -1); }

    // Hook up triggers (cards)
    section.querySelectorAll('[data-lightbox-trigger]').forEach(function(el) {
      function trigger(e) {
        e.preventDefault();
        e.stopPropagation();
        var root = el.classList.contains('tstn-gal__card') ? el : el.closest('.tstn-gal__card');
        if (!root) root = el;
        var img = root.querySelector('img[data-lightbox-src]') || el.querySelector('img[data-lightbox-src]');
        if (img) openLightbox(img.getAttribute('data-lightbox-src'));
      }
      el.addEventListener('click', trigger);
      el.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') trigger(e);
      });
    });

    closeBtn.addEventListener('click', closeLightbox);
    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);
    lightbox.addEventListener('click', function(e) {
      // Only close on backdrop click — not on stage, controls, or figure
      if (e.target === lightbox || e.target === stage) closeLightbox();
    });
    document.addEventListener('keydown', function(e) {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      else if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
    });

    // Touch swipe on stage
    var touchStartX = 0, touchStartY = 0, touchDelta = 0, isTouching = false;
    stage.addEventListener('touchstart', function(e) {
      if (isAnimating || e.touches.length !== 1) return;
      isTouching = true;
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      touchDelta = 0;
      figures[activeIdx].classList.add('is-dragging');
    }, { passive: true });
    stage.addEventListener('touchmove', function(e) {
      if (!isTouching || e.touches.length !== 1) return;
      var dx = e.touches[0].clientX - touchStartX;
      var dy = e.touches[0].clientY - touchStartY;
      // Only treat as swipe if mostly horizontal
      if (Math.abs(dy) > Math.abs(dx)) return;
      touchDelta = dx;
      var current = figures[activeIdx];
      var pct = (dx / window.innerWidth) * 100;
      current.style.transform = 'translateX(' + pct + '%) scale(' + (1 - Math.min(0.04, Math.abs(pct) / 800)) + ')';
      current.style.opacity = String(Math.max(0.4, 1 - Math.abs(pct) / 100));
    }, { passive: true });
    stage.addEventListener('touchend', function() {
      if (!isTouching) return;
      isTouching = false;
      var current = figures[activeIdx];
      current.classList.remove('is-dragging');
      current.style.transform = '';
      current.style.opacity = '';
      var threshold = window.innerWidth * 0.18;
      if (touchDelta < -threshold) next();
      else if (touchDelta > threshold) prev();
      touchDelta = 0;
    });

    // Filter pills (visual only)
    section.querySelectorAll('.tstn-gal__pill').forEach(function(pill) {
      pill.addEventListener('click', function() {
        section.querySelectorAll('.tstn-gal__pill').forEach(function(p) { p.classList.remove('is-active'); });
        pill.classList.add('is-active');
      });
    });

    // View mode toggle (visual only)
    section.querySelectorAll('.tstn-gal__viewbtn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        section.querySelectorAll('.tstn-gal__viewbtn').forEach(function(b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
      });
    });

    // ===== Upload modal =====
    var upModal = section.querySelector('.tstn-gal__upmodal');
    if (upModal) {
      var upInput = section.querySelector('[data-upload-input]');
      var upTrigger = section.querySelector('[data-upload-trigger]');
      var dropzone = upModal.querySelector('[data-upload-dropzone]');
      var previews = upModal.querySelector('[data-upload-previews]');
      var submitBtn = upModal.querySelector('[data-upload-submit]');
      var statusEl = upModal.querySelector('[data-upload-status]');
      var maxFiles = {{ section.settings.upload_max_files | default: 10 }};
      var maxSizeMB = {{ section.settings.upload_max_size_mb | default: 10 }};
      var endpoint = {{ section.settings.upload_endpoint | default: '' | json }};
      var selectedFiles = [];

      function openUpModal() {
        upModal.classList.add('is-open');
        upModal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeUpModal() {
        upModal.classList.remove('is-open');
        upModal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        resetUpModal();
      }
      function resetUpModal() {
        selectedFiles = [];
        previews.innerHTML = '';
        upInput.value = '';
        statusEl.className = 'tstn-gal__upmodal-status';
        statusEl.textContent = '';
        upModal.querySelectorAll('[data-upload-field]').forEach(function(f) { f.value = ''; });
        updateSubmitState();
      }
      function updateSubmitState() {
        submitBtn.disabled = selectedFiles.length === 0;
      }
      function renderPreviews() {
        previews.innerHTML = '';
        selectedFiles.forEach(function(file, idx) {
          var wrap = document.createElement('div');
          wrap.className = 'tstn-gal__preview';
          var img = document.createElement('img');
          img.src = URL.createObjectURL(file);
          img.alt = file.name;
          wrap.appendChild(img);
          var rm = document.createElement('button');
          rm.type = 'button';
          rm.className = 'tstn-gal__preview-remove';
          rm.setAttribute('aria-label', 'Remove');
          rm.innerHTML = '&times;';
          rm.addEventListener('click', function(e) {
            e.stopPropagation();
            selectedFiles.splice(idx, 1);
            renderPreviews();
            updateSubmitState();
          });
          wrap.appendChild(rm);
          previews.appendChild(wrap);
        });
      }
      function addFiles(files) {
        var arr = Array.prototype.slice.call(files);
        arr.forEach(function(f) {
          if (selectedFiles.length >= maxFiles) return;
          if (!f.type.startsWith('image/')) return;
          if (f.size > maxSizeMB * 1024 * 1024) {
            statusEl.className = 'tstn-gal__upmodal-status is-error';
            statusEl.textContent = f.name + ' is larger than ' + maxSizeMB + 'MB and was skipped.';
            return;
          }
          selectedFiles.push(f);
        });
        renderPreviews();
        updateSubmitState();
      }

      if (upTrigger) upTrigger.addEventListener('click', openUpModal);
      upModal.querySelectorAll('[data-upload-close]').forEach(function(b) {
        b.addEventListener('click', closeUpModal);
      });
      upModal.addEventListener('click', function(e) {
        if (e.target === upModal) closeUpModal();
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && upModal.classList.contains('is-open')) closeUpModal();
      });

      dropzone.addEventListener('click', function() { upInput.click(); });
      upInput.addEventListener('change', function(e) { addFiles(e.target.files); });
      ['dragenter', 'dragover'].forEach(function(ev) {
        dropzone.addEventListener(ev, function(e) {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('is-dragover');
        });
      });
      ['dragleave', 'drop'].forEach(function(ev) {
        dropzone.addEventListener(ev, function(e) {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('is-dragover');
        });
      });
      dropzone.addEventListener('drop', function(e) {
        if (e.dataTransfer && e.dataTransfer.files) addFiles(e.dataTransfer.files);
      });

      submitBtn.addEventListener('click', function() {
        if (selectedFiles.length === 0) return;
        submitBtn.disabled = true;
        submitBtn.classList.add('is-loading');
        statusEl.className = 'tstn-gal__upmodal-status';
        statusEl.textContent = '';

        var fd = new FormData();
        selectedFiles.forEach(function(f, i) { fd.append('file_' + i, f, f.name); });
        upModal.querySelectorAll('[data-upload-field]').forEach(function(field) {
          fd.append(field.dataset.uploadField, field.value);
        });
        fd.append('customer_id', '{{ customer.id }}');
        fd.append('customer_email', '{{ customer.email }}');

        var done = function(success, msg) {
          submitBtn.classList.remove('is-loading');
          submitBtn.disabled = false;
          statusEl.className = 'tstn-gal__upmodal-status ' + (success ? 'is-success' : 'is-error');
          statusEl.textContent = msg;
          if (success) {
            setTimeout(function() {
              closeUpModal();
            }, 1800);
          }
        };

        if (!endpoint) {
          // No backend endpoint configured — show success demo state.
          // Wire the "Upload endpoint URL" setting in the theme editor to your
          // upload handler (e.g. a Cloudinary upload preset, a custom Shopify app
          // endpoint, or any service that accepts multipart/form-data POST).
          setTimeout(function() {
            done(true, 'Thanks! Your photos were submitted for review.');
          }, 700);
          return;
        }

        fetch(endpoint, { method: 'POST', body: fd })
          .then(function(r) { return r.ok ? r : Promise.reject(r); })
          .then(function() { done(true, 'Thanks! Your photos were submitted for review.'); })
          .catch(function() { done(false, 'Upload failed. Please try again or contact support.'); });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Community Gallery",
  "tag": "section",
  "class": "section-tstn-gallery",
  "settings": [
    { "type": "header", "content": "Section Padding" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 60 },
