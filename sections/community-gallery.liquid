    border: 1px solid rgba(255,106,26,0.3);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 14px;
    text-transform: uppercase;
  }
  .tstn-gal__lock-title {
    font-family: var(--tstn-heading-font) !important;
    font-weight: 400;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.1;
    color: var(--tstn-text);
    margin: 0 0 12px;
    letter-spacing: 0.5px;
  }
  .tstn-gal__lock-desc {
    font-size: 14px;
    line-height: 1.55;
    color: var(--tstn-muted);
    margin: 0 0 24px;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }
  .tstn-gal__lock-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .tstn-gal__lock-join {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    background: var(--tstn-accent);
    color: #0a0a0a;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid var(--tstn-accent);
    transition: all 0.2s ease;
    box-shadow: none !important;
    -webkit-appearance: none;
  }
  .tstn-gal__lock-join:hover {
    background: #ffffff;
    border-color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(255,106,26,0.25) !important;
  }
  .tstn-gal__lock-login {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    background: transparent;
    color: var(--tstn-text);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid var(--tstn-border);
    transition: all 0.2s ease;
    box-shadow: none !important;
    -webkit-appearance: none;
  }
  .tstn-gal__lock-login:hover {
    background: #ffffff;
    color: #0a0a0a;
    border-color: #ffffff;
  }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 1280px) {
    .tstn-gal__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    }
    .tstn-gal__sidebar {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
    }
    .tstn-gal__sidebar > * { flex: 1 1 240px; }
  }

  @media (max-width: 900px) {
    .tstn-gal__grid { grid-template-columns: 1fr; }
    .tstn-gal__items { grid-template-columns: repeat(2, 1fr); }
    .tstn-gal__featured-img { min-height: 280px; }
    .tstn-gal__filterbar { padding: 8px; gap: 8px; }
    .tstn-gal__search { width: 100%; flex: 1 1 200px; }
    .tstn-gal__sidebar { flex-direction: column; }
    .tstn-gal__bg-img { width: 80%; height: 280px; top: -40px; }
  }

  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      --tstn-pad-top: {{ section.settings.padding_top_mobile | default: 32 }}px;
      --tstn-pad-right: {{ section.settings.padding_right_mobile | default: 16 }}px;
      --tstn-pad-bottom: {{ section.settings.padding_bottom_mobile | default: 40 }}px;
      --tstn-pad-left: {{ section.settings.padding_left_mobile | default: 16 }}px;
    }
  }

  @media (max-width: 600px) {
    .tstn-gal__items { grid-template-columns: 1fr; }
    .tstn-gal__pills {
      width: 100%;
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 4px;
      scrollbar-width: none;
    }
    .tstn-gal__pills::-webkit-scrollbar { display: none; }
    .tstn-gal__strip-side { font-size: 10px; gap: 8px; letter-spacing: 0.15em; }
    .tstn-gal__strip { padding: 14px 18px; }
    .tstn-gal__featured-title { font-size: 18px; }
  }
</style>

<section class="tstn-gal">
  {%- comment -%} =============== HEADER =============== {%- endcomment -%}
  <header class="tstn-gal__header">
    {%- if section.settings.bg_image != blank -%}
      <div class="tstn-gal__bg-img" style="opacity: {{ section.settings.bg_image_opacity | divided_by: 100.0 }};">
        <img src="{{ section.settings.bg_image | image_url: width: 1800 }}"
             alt=""
             loading="lazy"
             width="{{ section.settings.bg_image.width }}"
             height="{{ section.settings.bg_image.height }}">
      </div>
    {%- endif -%}

    {%- if section.settings.tag_text != blank -%}
      <div class="tstn-gal__breadcrumb" style="color: {{ section.settings.tag_color }};">
        <span>{{ section.settings.tag_text }}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="tstn-gal__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="tstn-gal__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </header>

  {%- comment -%} =============== FILTER BAR =============== {%- endcomment -%}
  {%- if section.settings.show_filter_bar -%}
    <div class="tstn-gal__filterbar">
      <div class="tstn-gal__pills">
        <button type="button" class="tstn-gal__pill is-active" data-filter="all"><span>All</span></button>
        <button type="button" class="tstn-gal__pill" data-filter="rig">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h2l1-4h12l1 4h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 13V8h12l2 5"/></svg>
          <span>Rigs</span>
        </button>
        <button type="button" class="tstn-gal__pill" data-filter="trip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
          <span>Trips</span>
        </button>
        <button type="button" class="tstn-gal__pill" data-filter="build">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <span>Builds</span>
        </button>
        <button type="button" class="tstn-gal__pill" data-filter="campsite">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          <span>Campsites</span>
        </button>
        <button type="button" class="tstn-gal__pill" data-filter="community">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span>Community</span>
        </button>
        <button type="button" class="tstn-gal__pill" data-filter="gear">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18l-2 13H5L3 6z"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span>Gear</span>
        </button>
      </div>

      <div class="tstn-gal__spacer"></div>

      <div class="tstn-gal__search">
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" placeholder="{{ section.settings.search_placeholder }}" aria-label="Search the gallery">
      </div>

      <select class="tstn-gal__sort" aria-label="Sort">
        <option>Newest</option>
        <option>Most Liked</option>
        <option>Most Photos</option>
      </select>

      <label class="tstn-gal__toggle">
        <input type="checkbox">
        <span class="tstn-gal__switch"></span>
        <span>Only community uploads</span>
      </label>

      <div class="tstn-gal__viewmode">
        <button type="button" class="tstn-gal__viewbtn is-active" aria-label="Grid view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </button>
        <button type="button" class="tstn-gal__viewbtn" aria-label="Column view">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="3" width="7" height="18" rx="1"/></svg>
        </button>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} =============== MAIN GRID =============== {%- endcomment -%}
  <div class="tstn-gal__grid{% unless customer %} is-locked{% endunless %}">

    {%- unless customer -%}
      {%- comment -%} ----- LOGIN GATE OVERLAY ----- {%- endcomment -%}
      <div class="tstn-gal__lock" aria-live="polite">
        <div class="tstn-gal__lock-card">
          {%- if section.settings.gate_pill != blank -%}
            <span class="tstn-gal__lock-pill">{{ section.settings.gate_pill }}</span>
          {%- endif -%}
          <div class="tstn-gal__lock-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          {%- if section.settings.gate_title != blank -%}
            <h3 class="tstn-gal__lock-title">{{ section.settings.gate_title }}</h3>
          {%- endif -%}
          {%- if section.settings.gate_description != blank -%}
            <p class="tstn-gal__lock-desc">{{ section.settings.gate_description }}</p>
          {%- endif -%}
          <div class="tstn-gal__lock-actions">
            {%- if section.settings.gate_join_text != blank -%}
              <a href="{{ section.settings.gate_join_link | default: routes.account_register_url }}" class="tstn-gal__lock-join">{{ section.settings.gate_join_text }}</a>
            {%- endif -%}
            {%- if section.settings.gate_login_text != blank -%}
              <a href="{{ section.settings.gate_login_link | default: routes.account_login_url }}" class="tstn-gal__lock-login">{{ section.settings.gate_login_text }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endunless -%}

    {%- comment -%} ----- FEATURED STORY ----- {%- endcomment -%}
    {%- if section.settings.show_featured -%}
      <div class="tstn-gal__featured" role="button" tabindex="0" data-lightbox-trigger
           data-description="{{ section.settings.featured_description | escape }}"
           data-location-label="{{ section.settings.featured_location_label | escape }}"
           data-location-url="{{ section.settings.featured_location_url | escape }}"
           data-likes="{{ section.settings.featured_likes }}">
        <div class="tstn-gal__featured-img">
          {%- if section.settings.featured_image != blank -%}
            <img src="{{ section.settings.featured_image | image_url: width: 900 }}"
                 alt="{{ section.settings.featured_title | escape }}"
                 loading="lazy"
                 width="{{ section.settings.featured_image.width }}"
                 height="{{ section.settings.featured_image.height }}"
                 data-lightbox-src="{{ section.settings.featured_image | image_url: width: 1800 }}">
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if section.settings.featured_badge != blank -%}
            <span class="tstn-gal__featured-badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {{ section.settings.featured_badge }}
            </span>
          {%- endif -%}
          {%- if section.settings.featured_location_label != blank -%}
            <span class="tstn-gal__featured-loc">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{{ section.settings.featured_location_label }}</span>
            </span>
          {%- endif -%}
        </div>
        <div class="tstn-gal__featured-body">
          {%- if section.settings.featured_category != blank -%}
            <div class="tstn-gal__cat">{{ section.settings.featured_category }}</div>
          {%- endif -%}
          {%- if section.settings.featured_title != blank -%}
            <h3 class="tstn-gal__featured-title">{{ section.settings.featured_title }}</h3>
          {%- endif -%}
          {%- if section.settings.featured_description != blank -%}
            <p class="tstn-gal__featured-desc">{{ section.settings.featured_description }}</p>
          {%- endif -%}
          <div class="tstn-gal__featured-meta">
            <div class="tstn-gal__author">
              <div class="tstn-gal__author-avatar">
                {%- if section.settings.featured_avatar != blank -%}
                  <img src="{{ section.settings.featured_avatar | image_url: width: 60 }}" alt="" loading="lazy">
                {%- endif -%}
              </div>
              <span class="tstn-gal__author-name">{{ section.settings.featured_author }}</span>
            </div>
            <div class="tstn-gal__featured-stats">
              {%- if section.settings.featured_photos != blank -%}
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  {{ section.settings.featured_photos }}
                </span>
              {%- endif -%}
              {%- if section.settings.featured_likes != blank -%}
                <span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  {{ section.settings.featured_likes }}
                </span>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ----- ITEMS GRID ----- {%- endcomment -%}
    {%- liquid
      assign mo_type = section.settings.metaobject_type | default: 'gallery_photo'
      assign mo_entries = shop.metaobjects[mo_type].values
      assign src = section.settings.gallery_source
    -%}
    <div class="tstn-gal__items" data-initial="{{ section.settings.initial_visible }}" data-step="{{ section.settings.load_more_count }}">

      {%- comment -%} Metaobject-backed photos (scales to hundreds) {%- endcomment -%}
      {%- if src == 'metaobject' or src == 'both' -%}
        {%- if mo_entries != blank -%}
          {%- for photo in mo_entries limit: section.settings.max_items -%}
            {%- render 'tstn-gallery-card',
              image: photo.image.value,
              title: photo.title.value,
              category: photo.category.value,
              author_name: photo.author_name.value,
              avatar: photo.avatar.value,
              photo_count: photo.photo_count.value,
              like_count: photo.like_count.value,
              description: photo.description.value,
              location_label: photo.location_label.value,
              location_url: photo.location_url.value,
              is_community_upload: photo.is_community_upload.value
            -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}

      {%- comment -%} Section blocks (manual; useful while migrating) {%- endcomment -%}
      {%- if src == 'blocks' or src == 'both' -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_item' -%}
            {%- render 'tstn-gallery-card',
              image: block.settings.image,
              title: block.settings.title,
              category: block.settings.category,
              author_name: block.settings.author_name,
              avatar: block.settings.avatar,
              photo_count: block.settings.photo_count,
              like_count: block.settings.like_count,
              description: block.settings.description,
              location_label: block.settings.location_label,
              location_url: block.settings.location_url,
              is_community_upload: block.settings.is_community_upload,
              editor_attributes: block.shopify_attributes
            -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

    </div>

    {%- if section.settings.show_load_more -%}
      <div class="tstn-gal__loadmore-wrap">
        <button type="button" class="tstn-gal__loadmore" data-load-more hidden>
          {{ section.settings.load_more_text | default: 'Load more' }}
        </button>
      </div>
    {%- endif -%}

    {%- comment -%} ----- SIDEBAR ----- {%- endcomment -%}
    {%- if section.settings.show_sidebar -%}
      <aside class="tstn-gal__sidebar">

        {%- comment -%} Quick Filters {%- endcomment -%}
        <div class="tstn-gal__panel">
          {%- if section.settings.qf_title != blank -%}
            <h4 class="tstn-gal__panel-title">{{ section.settings.qf_title }}</h4>
          {%- endif -%}
          <div class="tstn-gal__chips">
            {%- for block in section.blocks -%}
              {%- if block.type == 'quick_filter' -%}
                <a href="{{ block.settings.link | default: '#' }}" class="tstn-gal__chip" {{ block.shopify_attributes }}>
                  {%- case block.settings.icon -%}
                    {%- when 'snowflake' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/><line x1="19.07" y1="4.93" x2="4.93" y2="19.07"/></svg>
                    {%- when 'truck' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17h2l1-4h12l1 4h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 13V8h12l2 5"/></svg>
                    {%- when 'jeep' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17V11l2-5h10l2 5v6"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><line x1="9" y1="11" x2="15" y2="11"/></svg>
                    {%- when 'fire' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 9.5C14.5 7 12 4 12 4S9.5 7 9.5 9.5C9.5 12 12 13 12 13s2.5-1 2.5-3.5z"/><path d="M8.5 14.5A3.5 3.5 0 0 0 12 18a3.5 3.5 0 0 0 3.5-3.5C15.5 13 13.5 11 12 10.5c-1.5 0.5-3.5 2.5-3.5 4z"/></svg>
                    {%- when 'tent' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 19l9-15 9 15"/><path d="M12 4v15"/><path d="M3 19h18"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    {%- when 'sparkle' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3z"/></svg>
                    {%- when 'compass' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                    {%- when 'wrench' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                  {%- endcase -%}
                  <span>{{ block.settings.label }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Stats {%- endcomment -%}
        <div class="tstn-gal__panel tstn-gal__stats">
          {%- if section.settings.stat_1_value != blank -%}
            <div class="tstn-gal__stat">
              <div class="tstn-gal__stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              </div>
              <div>
                <div class="tstn-gal__stat-value">{{ section.settings.stat_1_value }}</div>
                <div class="tstn-gal__stat-label">{{ section.settings.stat_1_label }}</div>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.stat_2_value != blank -%}
            <div class="tstn-gal__stat">
              <div class="tstn-gal__stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              </div>
              <div>
                <div class="tstn-gal__stat-value">{{ section.settings.stat_2_value }}</div>
                <div class="tstn-gal__stat-label">{{ section.settings.stat_2_label }}</div>
              </div>
            </div>
          {%- endif -%}
          {%- if section.settings.stat_3_value != blank -%}
            <div class="tstn-gal__stat">
              <div class="tstn-gal__stat-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div>
                <div class="tstn-gal__stat-value">{{ section.settings.stat_3_value }}</div>
                <div class="tstn-gal__stat-label">{{ section.settings.stat_3_label }}</div>
              </div>
            </div>
          {%- endif -%}
        </div>

      </aside>
    {%- endif -%}
  </div>

  {%- comment -%} =============== BOTTOM STRIP =============== {%- endcomment -%}
  {%- if section.settings.show_bottom_strip -%}
    <div class="tstn-gal__strip">
      <div class="tstn-gal__strip-side">
        <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M3 20l5-12 4 6 4-9 5 15z"/></svg>
        <span>{{ section.settings.tagline_text }}</span>
      </div>
      <div class="tstn-gal__strip-side">
        <span>{{ section.settings.powered_by_text }}</span>
        <svg viewBox="0 0 70 14" fill="currentColor" preserveAspectRatio="none" width="70" height="14"><path d="M2 7 Q18 1 35 7 T68 7 L66 10 Q44 14 35 9 T4 9 Z" opacity="0.9"/></svg>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} =============== LIGHTBOX =============== {%- endcomment -%}
  <div class="tstn-gal__lightbox" id="tstn-lightbox-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true"
       data-likes-enabled="{{ section.settings.show_likes }}"
       data-comments-enabled="{{ section.settings.show_comments }}"
       data-share-enabled="{{ section.settings.show_share }}"
       data-share-text="{{ section.settings.share_text | escape }}"
       data-like-endpoint="{{ section.settings.like_endpoint | escape }}"
       data-comments-endpoint="{{ section.settings.comments_endpoint | escape }}"
       data-customer-name="{{ customer.first_name | escape }}{% if customer.last_name %} {{ customer.last_name | first | escape }}.{% endif %}">
    <div class="tstn-gal__lightbox-topbar">
      <div class="tstn-gal__lightbox-counter" data-lb-counter>1 / 1</div>
      <div class="tstn-gal__lightbox-topbar-actions">
        {%- if section.settings.show_share -%}
          <button type="button" class="tstn-gal__lightbox-iconbtn" aria-label="Share" data-lb-share>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </button>
        {%- endif -%}
        <button type="button" class="tstn-gal__lightbox-iconbtn tstn-gal__lightbox-close" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <button type="button" class="tstn-gal__lightbox-nav is-prev" aria-label="Previous image" data-lb-prev>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="tstn-gal__lightbox-nav is-next" aria-label="Next image" data-lb-next>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>

    <div class="tstn-gal__lightbox-stage">
      <div class="tstn-gal__lightbox-figure is-active" data-lb-figure="0">
        <img src="" alt="">
      </div>
      <div class="tstn-gal__lightbox-figure is-inactive" data-lb-figure="1">
        <img src="" alt="">
      </div>
      <a class="tstn-gal__lightbox-loc" data-lb-loc-overlay target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span data-lb-loc-overlay-label></span>
      </a>
    </div>

    <div class="tstn-gal__lightbox-info" data-lb-info>
      <div class="tstn-gal__lightbox-info-main">
        <h3 class="tstn-gal__lightbox-info-title" data-lb-title></h3>
        <div class="tstn-gal__lightbox-info-byline">
          <span data-lb-author></span>
          <a class="tstn-gal__lightbox-info-loc" data-lb-location target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span data-lb-location-label></span>
            <svg class="tstn-gal__lightbox-info-loc-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        </div>
        <p class="tstn-gal__lightbox-info-desc" data-lb-desc></p>
      </div>

      <div class="tstn-gal__lightbox-actions">
        {%- if section.settings.show_likes -%}
          <button type="button" class="tstn-gal__lightbox-action" data-lb-like>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span data-lb-like-count>0</span>
          </button>
        {%- endif -%}
        {%- if section.settings.show_comments -%}
          <button type="button" class="tstn-gal__lightbox-action" data-lb-comment-toggle>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span data-lb-comment-count>0</span>
          </button>
        {%- endif -%}
        {%- if section.settings.show_share -%}
          <button type="button" class="tstn-gal__lightbox-action" data-lb-share>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            <span>Share</span>
          </button>
        {%- endif -%}
      </div>

      {%- if section.settings.show_comments -%}
        <div class="tstn-gal__lightbox-comments" data-lb-comments-panel>
          <div class="tstn-gal__lightbox-comments-list" data-lb-comments-list></div>
          {%- if customer -%}
            <div class="tstn-gal__lightbox-comment-form">
              <input type="text" class="tstn-gal__lightbox-comment-input" data-lb-comment-input placeholder="Add a comment…" maxlength="280">
              <button type="button" class="tstn-gal__lightbox-comment-submit" data-lb-comment-submit aria-label="Post comment">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              </button>
            </div>
          {%- else -%}
            <div class="tstn-gal__lightbox-comments-signin">
              <a href="{{ routes.account_login_url }}">Sign in</a> to leave a comment.
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="tstn-gal__lightbox-thumbs-wrap">
      <div class="tstn-gal__lightbox-thumbs" data-lb-thumbs></div>
    </div>

    <div class="tstn-gal__lightbox-toast" data-lb-toast></div>
  </div>

</section>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    // ===== Lightbox =====
    var lightbox = section.querySelector('.tstn-gal__lightbox');
    if (lightbox) {
      var closeBtn = lightbox.querySelector('.tstn-gal__lightbox-close');
      var prevBtn = lightbox.querySelector('[data-lb-prev]');
      var nextBtn = lightbox.querySelector('[data-lb-next]');
      var counterEl = lightbox.querySelector('[data-lb-counter]');
      var thumbsEl = lightbox.querySelector('[data-lb-thumbs]');
      var figures = lightbox.querySelectorAll('.tstn-gal__lightbox-figure');
      var stage = lightbox.querySelector('.tstn-gal__lightbox-stage');
      var infoEl = lightbox.querySelector('[data-lb-info]');
      var titleEl = lightbox.querySelector('[data-lb-title]');
      var authorEl = lightbox.querySelector('[data-lb-author]');
      var locEl = lightbox.querySelector('[data-lb-location]');
      var locLabelEl = lightbox.querySelector('[data-lb-location-label]');
      var locOverlay = lightbox.querySelector('[data-lb-loc-overlay]');
      var locOverlayLabel = lightbox.querySelector('[data-lb-loc-overlay-label]');
      var descEl = lightbox.querySelector('[data-lb-desc]');
      var likeBtn = lightbox.querySelector('[data-lb-like]');
      var likeCountEl = lightbox.querySelector('[data-lb-like-count]');
      var commentToggleBtn = lightbox.querySelector('[data-lb-comment-toggle]');
      var commentCountEl = lightbox.querySelector('[data-lb-comment-count]');
      var commentsPanel = lightbox.querySelector('[data-lb-comments-panel]');
      var commentsList = lightbox.querySelector('[data-lb-comments-list]');
      var commentInput = lightbox.querySelector('[data-lb-comment-input]');
      var commentSubmit = lightbox.querySelector('[data-lb-comment-submit]');
      var shareBtns = lightbox.querySelectorAll('[data-lb-share]');
      var toastEl = lightbox.querySelector('[data-lb-toast]');

      var likesEnabled = lightbox.dataset.likesEnabled === 'true';
      var commentsEnabled = lightbox.dataset.commentsEnabled === 'true';
      var shareEnabled = lightbox.dataset.shareEnabled === 'true';
      var shareTextBase = lightbox.dataset.shareText || '';
      var likeEndpoint = lightbox.dataset.likeEndpoint || '';
      var commentsEndpoint = lightbox.dataset.commentsEndpoint || '';
      var customerName = lightbox.dataset.customerName || '';
      var customerId = '{{ customer.id }}';

      // Build the gallery list from currently-visible card images
      var items = [];
      function buildItems() {
        items = [];
        section.querySelectorAll('img[data-lightbox-src]').forEach(function(img) {
          var card = img.closest('.tstn-gal__card') || img.closest('.tstn-gal__featured');
          if (card && card.classList.contains('is-hidden')) return;
          var title = '', author = '', desc = '', locLabel = '', locUrl = '', baseLikes = 0;
          if (card) {
            var t = card.querySelector('.tstn-gal__card-title, .tstn-gal__featured-title');
            var a = card.querySelector('.tstn-gal__author-name');
            if (t) title = t.textContent.trim();
            if (a) author = a.textContent.trim();
            desc = card.dataset.description || '';
            locLabel = card.dataset.locationLabel || '';
            locUrl = card.dataset.locationUrl || '';
            baseLikes = parseInt(card.dataset.likes, 10) || 0;
          }
          items.push({
            src: img.getAttribute('data-lightbox-src'),
            thumb: img.src,
            id: img.getAttribute('data-lightbox-src'),
            title: title,
            author: author,
            desc: desc,
            locLabel: locLabel,
            locUrl: locUrl,
            baseLikes: baseLikes
          });
        });
      }
      buildItems();

      var currentIndex = 0;
      var activeIdx = 0;
      var isAnimating = false;
      var transitionMs = 460;
      var toastTimer = null;

      // ----- Helpers -----
      function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, function(c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function getFigureImg(figIdx) { return figures[figIdx].querySelector('img'); }
      function setFigure(figIdx, src) { getFigureImg(figIdx).src = src || ''; }
      function preload(idx) {
        if (idx < 0 || idx >= items.length) return;
        var pre = new Image();
        pre.src = items[idx].src;
      }
      function preloadRange(span) {
        for (var d = 1; d <= span; d++) {
          preload(currentIndex + d);
          preload(currentIndex - d);
        }
      }
      function storageKey(prefix, id) {
        return 'tstn_gal_' + prefix + '_' + btoa(unescape(encodeURIComponent(id))).replace(/=/g, '');
      }
      function readStore(key, fallback) {
        try {
          var v = localStorage.getItem(key);
          return v == null ? fallback : JSON.parse(v);
        } catch (e) { return fallback; }
      }
      function writeStore(key, val) {
        try { localStorage.setItem(key, JSON.stringify(val)); } catch (e) {}
      }

      function showToast(msg) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.add('is-visible');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function() {
          toastEl.classList.remove('is-visible');
        }, 2000);
      }

      // ----- Counter / chrome -----
      function updateCounter() {
        counterEl.textContent = (currentIndex + 1) + ' / ' + items.length;
      }

      // ----- Info panel content -----
      function buildLocationUrl(item) {
        if (item.locUrl) return item.locUrl;
        if (!item.locLabel) return '';
        return 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(item.locLabel);
      }

      function renderInfo() {
        var item = items[currentIndex];
        if (!item) return;
        titleEl.textContent = item.title || '';
        authorEl.textContent = item.author ? 'by ' + item.author : '';
        if (item.locLabel) {
          locEl.classList.remove('is-hidden');
          locEl.href = buildLocationUrl(item);
          locLabelEl.textContent = item.locLabel;
        } else {
          locEl.classList.add('is-hidden');
        }
        if (locOverlay) {
          if (item.locLabel) {
            locOverlay.classList.add('is-visible');
            locOverlay.href = buildLocationUrl(item);
            locOverlayLabel.textContent = item.locLabel;
          } else {
            locOverlay.classList.remove('is-visible');
          }
        }
        descEl.textContent = item.desc || '';
        renderLike();
        renderComments();
      }

      function renderInfoSwap() {
        if (!infoEl.classList.contains('is-open')) {
          renderInfo();
          return;
        }
        infoEl.style.opacity = '0';
        setTimeout(function() {
          renderInfo();
          requestAnimationFrame(function() { infoEl.style.opacity = ''; });
        }, 180);
      }

      // ----- Likes -----
      function getLikeState(item) {
        return readStore(storageKey('like', item.id), false);
      }
      function setLikeState(item, liked) {
        writeStore(storageKey('like', item.id), liked);
      }
      function renderLike() {
        if (!likesEnabled || !likeBtn) return;
        var item = items[currentIndex];
        var liked = getLikeState(item);
        var count = item.baseLikes + (liked ? 1 : 0);
        likeCountEl.textContent = count;
        likeBtn.classList.toggle('is-active', liked);
      }
      function toggleLike() {
        var item = items[currentIndex];
        var liked = !getLikeState(item);
        setLikeState(item, liked);
        likeBtn.classList.add('is-bumping');
        setTimeout(function() { likeBtn.classList.remove('is-bumping'); }, 460);
        renderLike();
        if (likeEndpoint) {
          try {
            fetch(likeEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                image_id: item.id,
                customer_id: customerId,
                action: liked ? 'like' : 'unlike'
              })
            }).catch(function() {});
          } catch (e) {}
        }
      }
      if (likeBtn) likeBtn.addEventListener('click', toggleLike);

      // ----- Comments -----
      function getComments(item) {
        return readStore(storageKey('comments', item.id), []);
      }
      function saveComments(item, list) {
        writeStore(storageKey('comments', item.id), list);
      }
      function formatTime(ts) {
        var diff = (Date.now() - ts) / 1000;
        if (diff < 60) return 'just now';
        if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
        if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
        if (diff < 86400 * 7) return Math.floor(diff / 86400) + 'd ago';
        var d = new Date(ts);
        return d.toLocaleDateString();
      }
      function renderComments() {
        if (!commentsEnabled || !commentsList) return;
        var item = items[currentIndex];
        var comments = getComments(item);
        commentCountEl.textContent = comments.length;
        if (comments.length === 0) {
          commentsList.innerHTML = '<div class="tstn-gal__lightbox-comments-empty">No comments yet — be the first.</div>';
          return;
        }
        commentsList.innerHTML = comments.map(function(c) {
          return '<div class="tstn-gal__lightbox-comment">' +
            '<div class="tstn-gal__lightbox-comment-head">' +
              '<span class="tstn-gal__lightbox-comment-author">' + escapeHtml(c.author || 'Anon') + '</span>' +
              '<span class="tstn-gal__lightbox-comment-time">' + escapeHtml(formatTime(c.ts)) + '</span>' +
            '</div>' +
            '<p class="tstn-gal__lightbox-comment-body">' + escapeHtml(c.body) + '</p>' +
          '</div>';
        }).join('');
      }
      function submitComment() {
        if (!commentInput) return;
        var text = (commentInput.value || '').trim();
        if (!text) return;
        var item = items[currentIndex];
        var comments = getComments(item);
        var entry = {
          author: customerName || 'Member',
          body: text,
          ts: Date.now()
        };
        comments.push(entry);
        saveComments(item, comments);
        commentInput.value = '';
        renderComments();
        // Auto-scroll to newest
        if (commentsList.lastElementChild) {
          commentsList.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        if (commentsEndpoint) {
          try {
            fetch(commentsEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                image_id: item.id,
                customer_id: customerId,
                author: entry.author,
                body: entry.body
              })
            }).catch(function() {});
          } catch (e) {}
        }
      }
      if (commentSubmit) commentSubmit.addEventListener('click', submitComment);
      if (commentInput) {
        commentInput.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); submitComment(); }
        });
      }

      // ----- Comment panel toggle -----
      if (commentToggleBtn && commentsPanel) {
        commentToggleBtn.addEventListener('click', function() {
          commentsPanel.classList.toggle('is-open');
          if (commentsPanel.classList.contains('is-open') && commentInput) {
            setTimeout(function() { commentInput.focus(); }, 300);
          }
        });
      }

      // ----- Share -----
      function shareCurrent() {
        var item = items[currentIndex];
        var url = window.location.origin + window.location.pathname + '#tstn-gal-' + (currentIndex + 1);
        var titleStr = item.title ? (shareTextBase ? shareTextBase + ': ' + item.title : item.title) : (shareTextBase || document.title);
        var shareData = {
          title: titleStr,
          text: item.desc || titleStr,
          url: url
        };
        if (navigator.share) {
          navigator.share(shareData).catch(function() {});
        } else if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function() {
            showToast('Link copied to clipboard');
          }).catch(function() {
            showToast('Could not copy link');
          });
        } else {
          showToast('Share not supported on this device');
        }
      }
      shareBtns.forEach(function(b) { b.addEventListener('click', shareCurrent); });

      // ----- Thumbs (scrollable) -----
      function buildThumbs() {
        thumbsEl.innerHTML = '';
        items.forEach(function(it, i) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'tstn-gal__lightbox-thumb' + (i === currentIndex ? ' is-active' : '');
          btn.setAttribute('aria-label', 'Go to image ' + (i + 1));
          btn.setAttribute('data-lb-thumb-idx', i);
          var im = document.createElement('img');
          im.src = it.thumb;
          im.alt = '';
          im.loading = 'lazy';
          btn.appendChild(im);
          thumbsEl.appendChild(btn);
        });
        thumbsEl.querySelectorAll('[data-lb-thumb-idx]').forEach(function(t) {
          t.addEventListener('click', function() {
            var idx = parseInt(t.getAttribute('data-lb-thumb-idx'), 10);
            if (idx === currentIndex) return;
            var dir = idx > currentIndex ? 1 : -1;
            goTo(idx, dir);
          });
        });
      }
      function syncThumbActive() {
        thumbsEl.querySelectorAll('[data-lb-thumb-idx]').forEach(function(t) {
          var idx = parseInt(t.getAttribute('data-lb-thumb-idx'), 10);
          t.classList.toggle('is-active', idx === currentIndex);
        });
        // Auto-scroll active into view
        var active = thumbsEl.querySelector('.tstn-gal__lightbox-thumb.is-active');
        if (active) {
          active.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      }

      // ----- Open / Close -----
      function openLightbox(src) {
        if (!src) return;
        buildItems();
        var idx = items.findIndex(function(it) { return it.src === src; });
        if (idx === -1) idx = 0;
        currentIndex = idx;
        activeIdx = 0;

        figures[0].classList.add('is-active');
        figures[0].classList.remove('is-inactive', 'is-leaving-left', 'is-leaving-right', 'is-entering-from-left', 'is-entering-from-right');
        figures[1].classList.add('is-inactive');
        figures[1].classList.remove('is-active', 'is-leaving-left', 'is-leaving-right', 'is-entering-from-left', 'is-entering-from-right');

        setFigure(0, items[currentIndex].src);
        setFigure(1, '');

        lightbox.classList.add('is-open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        infoEl.classList.add('is-open');

        updateCounter();
        renderInfo();
        buildThumbs();
        // Scroll active thumb to center after thumbs render and lightbox opens
        setTimeout(syncThumbActive, 60);
        preloadRange(3);
      }

      function closeLightbox() {
        lightbox.classList.remove('is-open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (commentsPanel) commentsPanel.classList.remove('is-open');
        infoEl.classList.remove('is-open');
        setTimeout(function() {
          if (!lightbox.classList.contains('is-open')) {
            setFigure(0, '');
            setFigure(1, '');
          }
        }, 400);
      }

      // ----- Navigate -----
      function goTo(newIndex, direction) {
        if (isAnimating || items.length <= 1) return;
        if (newIndex < 0) newIndex = items.length - 1;
        if (newIndex >= items.length) newIndex = 0;
        if (newIndex === currentIndex) return;

        isAnimating = true;
        var nextActiveIdx = activeIdx === 0 ? 1 : 0;
        var current = figures[activeIdx];
        var incoming = figures[nextActiveIdx];

        setFigure(nextActiveIdx, items[newIndex].src);
        incoming.classList.remove('is-active', 'is-inactive', 'is-leaving-left', 'is-leaving-right', 'is-entering-from-left', 'is-entering-from-right');
        incoming.classList.add(direction > 0 ? 'is-entering-from-right' : 'is-entering-from-left');

        // eslint-disable-next-line no-unused-expressions
        incoming.offsetWidth;

        requestAnimationFrame(function() {
          current.classList.remove('is-active');
          current.classList.add(direction > 0 ? 'is-leaving-left' : 'is-leaving-right');
          incoming.classList.remove('is-entering-from-right', 'is-entering-from-left');
          incoming.classList.add('is-active');
        });

        currentIndex = newIndex;
        activeIdx = nextActiveIdx;

        updateCounter();
        renderInfoSwap();
        syncThumbActive();
        preloadRange(3);

        setTimeout(function() {
          current.classList.remove('is-leaving-left', 'is-leaving-right');
          current.classList.add('is-inactive');
          isAnimating = false;
        }, transitionMs);
      }

      function next() { goTo(currentIndex + 1, 1); }
      function prev() { goTo(currentIndex - 1, -1); }

      // ----- Wire up triggers -----
      section.querySelectorAll('[data-lightbox-trigger]').forEach(function(el) {
        function trigger(e) {
          e.preventDefault();
          e.stopPropagation();
          var root = el.classList.contains('tstn-gal__card') || el.classList.contains('tstn-gal__featured') ? el : el.closest('.tstn-gal__card, .tstn-gal__featured');
          if (!root) root = el;
          var img = root.querySelector('img[data-lightbox-src]') || el.querySelector('img[data-lightbox-src]');
          if (img) openLightbox(img.getAttribute('data-lightbox-src'));
        }
        el.addEventListener('click', trigger);
        el.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') trigger(e);
        });
      });

      closeBtn.addEventListener('click', closeLightbox);
      nextBtn.addEventListener('click', next);
      prevBtn.addEventListener('click', prev);
      lightbox.addEventListener('click', function(e) {
        // Backdrop close: only when clicking the lightbox itself or stage (not chrome/info)
        if (e.target === lightbox || e.target === stage) closeLightbox();
      });
      document.addEventListener('keydown', function(e) {
        if (!lightbox.classList.contains('is-open')) return;
        // Don't navigate while typing in comment input
        if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) {
          if (e.key === 'Escape') closeLightbox();
          return;
        }
        if (e.key === 'Escape') closeLightbox();
        else if (e.key === 'ArrowRight') next();
        else if (e.key === 'ArrowLeft') prev();
      });

      // ----- Touch swipe on stage -----
      var touchStartX = 0, touchStartY = 0, touchDelta = 0, isTouching = false;
      stage.addEventListener('touchstart', function(e) {
        if (isAnimating || e.touches.length !== 1) return;
        isTouching = true;
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        touchDelta = 0;
        figures[activeIdx].classList.add('is-dragging');
      }, { passive: true });
      stage.addEventListener('touchmove', function(e) {
        if (!isTouching || e.touches.length !== 1) return;
        var dx = e.touches[0].clientX - touchStartX;
        var dy = e.touches[0].clientY - touchStartY;
        if (Math.abs(dy) > Math.abs(dx)) return;
        touchDelta = dx;
        var current = figures[activeIdx];
        var pct = (dx / window.innerWidth) * 100;
        current.style.transform = 'translateX(' + pct + '%) scale(' + (1 - Math.min(0.04, Math.abs(pct) / 800)) + ')';
        current.style.opacity = String(Math.max(0.4, 1 - Math.abs(pct) / 100));
      }, { passive: true });
      stage.addEventListener('touchend', function() {
        if (!isTouching) return;
        isTouching = false;
        var current = figures[activeIdx];
        current.classList.remove('is-dragging');
        current.style.transform = '';
        current.style.opacity = '';
        var threshold = window.innerWidth * 0.18;
        if (touchDelta < -threshold) next();
        else if (touchDelta > threshold) prev();
        touchDelta = 0;
      });
    }

    // ===== Filters / search / sort / view mode =====
    var filterbar = section.querySelector('.tstn-gal__filterbar');
    var itemsWrap = section.querySelector('.tstn-gal__items');
    if (itemsWrap && filterbar) {
      var pills = filterbar.querySelectorAll('.tstn-gal__pill');
      var searchInput = filterbar.querySelector('.tstn-gal__search input');
      var sortSelect = filterbar.querySelector('.tstn-gal__sort');
      var commToggle = filterbar.querySelector('.tstn-gal__toggle input');
      var viewBtns = filterbar.querySelectorAll('.tstn-gal__viewbtn');
      var cards = Array.prototype.slice.call(itemsWrap.querySelectorAll('.tstn-gal__card'));
      var originalOrder = cards.slice();

      var activeFilter = 'all';
      var searchTerm = '';
      var communityOnly = false;

      var noResults = document.createElement('div');
      noResults.className = 'tstn-gal__noresults';
      noResults.textContent = 'No shots match your filters — try another category or search.';
      itemsWrap.appendChild(noResults);

      var loadMoreBtn = section.querySelector('[data-load-more]');
      var initialVisible = parseInt(itemsWrap.dataset.initial, 10);
      var loadStep = parseInt(itemsWrap.dataset.step, 10) || 12;
      if (!loadMoreBtn || isNaN(initialVisible) || initialVisible <= 0) initialVisible = Infinity;
      var visibleCap = initialVisible;

      function applyFilters() {
        var domCards = Array.prototype.slice.call(itemsWrap.querySelectorAll('.tstn-gal__card'));
        var matched = 0, shown = 0;
        domCards.forEach(function(card) {
          var cat = (card.dataset.category || '').toLowerCase();
          var text = (card.dataset.search || '').toLowerCase();
          var isComm = card.dataset.community === 'true';
          var matchFilter;
          if (activeFilter === 'all') matchFilter = true;
          else if (activeFilter === 'community') matchFilter = isComm || cat.indexOf('community') !== -1;
          else matchFilter = cat.indexOf(activeFilter) !== -1;
          var matchSearch = !searchTerm || text.indexOf(searchTerm) !== -1;
          var matchComm = !communityOnly || isComm;
          var match = matchFilter && matchSearch && matchComm;
          if (match && shown < visibleCap) {
            card.classList.remove('is-hidden');
            shown++;
          } else {
            card.classList.add('is-hidden');
          }
          if (match) matched++;
        });
        noResults.classList.toggle('is-visible', matched === 0);
        if (loadMoreBtn) {
          if (matched > shown) loadMoreBtn.removeAttribute('hidden');
          else loadMoreBtn.setAttribute('hidden', '');
        }
      }

      function resetCap() { visibleCap = initialVisible; }

      function applySort() {
        if (!sortSelect) return;
        var val = sortSelect.value;
        var sorted = originalOrder.slice();
        if (val === 'Most Liked') {
          sorted.sort(function(a, b) {
            return (parseInt(b.dataset.likes, 10) || 0) - (parseInt(a.dataset.likes, 10) || 0);
          });
        } else if (val === 'Most Photos') {
          sorted.sort(function(a, b) {
            return (parseInt(b.dataset.photos, 10) || 0) - (parseInt(a.dataset.photos, 10) || 0);
          });
        }
        sorted.forEach(function(c) { itemsWrap.appendChild(c); });
        itemsWrap.appendChild(noResults);
      }

      pills.forEach(function(pill) {
        pill.addEventListener('click', function() {
          pills.forEach(function(p) { p.classList.remove('is-active'); });
          pill.classList.add('is-active');
          activeFilter = (pill.dataset.filter || 'all').toLowerCase();
          resetCap();
          applyFilters();
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', function() {
          searchTerm = (searchInput.value || '').trim().toLowerCase();
          resetCap();
          applyFilters();
        });
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', function() {
          applySort();
          resetCap();
          applyFilters();
        });
      }

      if (commToggle) {
        commToggle.addEventListener('change', function() {
          communityOnly = commToggle.checked;
          resetCap();
          applyFilters();
        });
      }

      viewBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          viewBtns.forEach(function(b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
          var isList = (btn.getAttribute('aria-label') || '').toLowerCase().indexOf('column') !== -1;
          itemsWrap.classList.toggle('is-list', isList);
        });
      });

      if (loadMoreBtn) {
        loadMoreBtn.addEventListener('click', function() {
          visibleCap += loadStep;
          applyFilters();
        });
      }

      applyFilters();
    }
  })();
</script>

{% schema %}
{
