  /* ===================== LIGHTBOX ===================== */
  /* ===================== LIGHTBOX (Apple-style viewer) ===================== */
  .tstn-gal__lightbox {
    --lb-ease: cubic-bezier(0.32, 0.72, 0, 1);
    --lb-duration: 460ms;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    -webkit-backdrop-filter: blur(10px);
            backdrop-filter: blur(10px);
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0;
    opacity: 0;
    transition: opacity 0.32s var(--lb-ease);
  }
  .tstn-gal__lightbox.is-open { display: flex; opacity: 1; }

  /* Top bar with counter + close */
  .tstn-gal__lightbox-topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
