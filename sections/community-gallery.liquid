    { "type": "range", "id": "padding_top_mobile", "label": "Padding top", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_right_mobile", "label": "Padding right", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_left_mobile", "label": "Padding left", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 16 },

    { "type": "header", "content": "Header" },
    { "type": "text", "id": "tag_text", "label": "Breadcrumb tag", "default": "COMMUNITY GALLERY" },
    { "type": "color", "id": "tag_color", "label": "Tag color", "default": "#ff6a1a" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gallery" },
    { "type": "range", "id": "heading_size", "min": 60, "max": 220, "step": 4, "default": 140, "unit": "px", "label": "Heading max size (desktop)" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Explore rigs, adventures, builds, gear setups, and community moments." },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (mountains)" },
    { "type": "range", "id": "bg_image_opacity", "min": 0, "max": 100, "step": 5, "default": 45, "unit": "%", "label": "Background image opacity" },

    { "type": "header", "content": "Theme Colors" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "card_bg_color", "label": "Card background", "default": "#141414" },
    { "type": "color", "id": "card_hover_color", "label": "Card hover background", "default": "#1a1a1a" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#262626" },
    { "type": "color", "id": "accent_color", "label": "Accent (orange)", "default": "#ff6a1a" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#ffffff" },
    { "type": "color", "id": "text_muted_color", "label": "Muted text", "default": "#9a9a9a" },

    { "type": "header", "content": "Gallery Photos (Data Source)" },
    { "type": "paragraph", "content": "Use a metaobject definition to manage hundreds of photos outside the theme editor. Create a metaobject (Settings → Custom data → Metaobjects) with these field keys: image, title, category, author_name, avatar, photo_count, like_count, description, location_label, location_url, is_community_upload. Then enable its storefront access." },
    {
      "type": "select",
      "id": "gallery_source",
      "label": "Photo source",
      "default": "both",
      "options": [
        { "value": "metaobject", "label": "Metaobject only (scales to hundreds)" },
        { "value": "blocks", "label": "Section blocks only (manual, max 16)" },
        { "value": "both", "label": "Both (metaobject + blocks)" }
      ]
    },
    { "type": "text", "id": "metaobject_type", "label": "Metaobject type handle", "default": "gallery_photo", "info": "The type handle of your metaobject definition (e.g. gallery_photo)." },
    { "type": "range", "id": "max_items", "label": "Max photos to load", "min": 20, "max": 500, "step": 10, "default": 120, "info": "Hard cap on photos rendered from the metaobject. Higher values increase page weight." },
    { "type": "checkbox", "id": "show_load_more", "label": "Enable \"Load more\" button", "default": true, "info": "Reveals photos in batches so they don't all paint at once." },
    { "type": "range", "id": "initial_visible", "label": "Photos shown initially", "min": 3, "max": 60, "step": 3, "default": 12 },
    { "type": "range", "id": "load_more_count", "label": "Photos added per \"Load more\"", "min": 3, "max": 60, "step": 3, "default": 12 },
    { "type": "text", "id": "load_more_text", "label": "Load more button text", "default": "Load More" },

    { "type": "header", "content": "Filter Bar" },
