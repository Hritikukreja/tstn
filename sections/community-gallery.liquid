    { "type": "url", "id": "gate_login_link", "label": "Login button link", "info": "Defaults to /account/login if left blank." },

    { "type": "header", "content": "Featured Story" },
    { "type": "checkbox", "id": "show_featured", "label": "Show featured story", "default": true },
    { "type": "image_picker", "id": "featured_image", "label": "Featured image" },
    { "type": "text", "id": "featured_badge", "label": "Featured badge text", "default": "FEATURED STORY" },
