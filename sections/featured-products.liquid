{%- liquid
  assign accent = section.settings.accent_color
-%}

<section
  id="shopify-section-{{ section.id }}-wrap"
  class="tstn-featured"
  style="--tstn-accent: {{ accent }};"
>
  <div class="tstn-featured__inner">
    <div class="tstn-featured__header">
      <div>
        {%- if section.settings.overline != blank -%}
          <p class="tstn-featured__overline">{{ section.settings.overline }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tstn-featured__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ section.settings.view_all_link | default: '#' }}" class="tstn-featured__view-all">
          {{ section.settings.view_all_label }}
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M1 5H13M13 5L9 1M13 5L9 9"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="tstn-featured__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- liquid
            assign product = block.settings.product

            # ---- Resolve image (manual override > product featured image) ----
            if block.settings.image != blank
              assign card_image = block.settings.image
              assign card_image_alt = block.settings.image.alt | default: block.settings.title
            elsif product != blank and product.featured_image != blank
              assign card_image = product.featured_image
              assign card_image_alt = product.featured_image.alt | default: product.title
            else
              assign card_image = null
              assign card_image_alt = ''
            endif

            # ---- Resolve brand ----
            if block.settings.brand != blank
              assign card_brand = block.settings.brand
            elsif product != blank
              assign card_brand = product.vendor
            else
              assign card_brand = blank
            endif

            # ---- Resolve title ----
            if block.settings.title != blank
              assign card_title = block.settings.title
            elsif product != blank
              assign card_title = product.title
            else
              assign card_title = blank
            endif

            # ---- Resolve description ----
            if block.settings.description != blank
              assign card_description = block.settings.description
            elsif product != blank
              assign card_description = product.description | strip_html | truncate: 110
            else
              assign card_description = blank
            endif

            # ---- Resolve price ----
            if block.settings.price != blank
              assign card_price = block.settings.price
            elsif product != blank
              if product.price_varies
                assign card_price = product.price_min | money
                assign card_price = 'From ' | append: card_price
              else
                assign card_price = product.price | money
              endif
            else
              assign card_price = blank
            endif

            # ---- Resolve link ----
            if block.settings.link != blank
              assign card_link = block.settings.link
            elsif product != blank
              assign card_link = product.url
            else
              assign card_link = '#'
            endif
          -%}

          <div class="tstn-featured__card" {{ block.shopify_attributes }}>
            <a href="{{ card_link }}" class="tstn-featured__image-wrap">
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 750px) 25vw, 50vw',
                    widths: '300, 400, 600, 800',
                    alt: card_image_alt,
                    class: 'tstn-featured__image'
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'tstn-featured__image' }}
              {%- endif -%}
            </a>

            <div class="tstn-featured__body">
              {%- if card_brand != blank -%}
                <p class="tstn-featured__brand">{{ card_brand }}</p>
              {%- endif -%}

              {%- if card_title != blank -%}
                <h3 class="tstn-featured__title">
                  <a href="{{ card_link }}">{{ card_title }}</a>
                </h3>
              {%- endif -%}

              {%- if card_description != blank -%}
                <p class="tstn-featured__desc">{{ card_description }}</p>
              {%- endif -%}

              {%- if card_price != blank -%}
                <p class="tstn-featured__price">{{ card_price }}</p>
              {%- endif -%}

              <a href="{{ card_link }}" class="tstn-featured__btn">
                {{ block.settings.button_label | default: 'VIEW PRODUCT' }}
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .tstn-featured {
    background: #0a0a0a;
    color: #ffffff;
    padding: clamp(40px, 5vw, 70px) 0;
  }

  #shopify-section-{{ section.id }} .tstn-featured__inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(20px, 6vw, 80px);
  }

  #shopify-section-{{ section.id }} .tstn-featured__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .tstn-featured__overline {
    font-family: 'Danger Neue Free Regular', 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tstn-accent, #ff6a1a);
    margin: 0 0 10px;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .tstn-featured__heading {
    font-family: 'Danger Neue Free Regular', 'Helvetica Neue', Arial, sans-serif;
    font-size: clamp(26px, 3vw, 40px);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    font-weight: 400;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .tstn-featured__view-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .tstn-featured__view-all:hover {
    color: var(--tstn-accent, #ff6a1a);
  }

  #shopify-section-{{ section.id }} .tstn-featured__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .tstn-featured__card {
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.04);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .tstn-featured__card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.1);
  }

  #shopify-section-{{ section.id }} .tstn-featured__image-wrap {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #1a1a1a;
  }

  #shopify-section-{{ section.id }} .tstn-featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .tstn-featured__card:hover .tstn-featured__image {
    transform: scale(1.04);
  }

  #shopify-section-{{ section.id }} .tstn-featured__body {
    padding: 18px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .tstn-featured__brand {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0;
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} .tstn-featured__title {
    font-family: 'Danger Neue Free Regular', 'Helvetica Neue', Arial, sans-serif;
    font-size: 17px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
    font-weight: 400;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .tstn-featured__title a {
    color: #ffffff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .tstn-featured__desc {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tstn-featured__price {
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 15px;
    color: #ffffff;
    font-weight: 600;
    margin: 6px 0 10px;
  }

  #shopify-section-{{ section.id }} .tstn-featured__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    padding: 10px 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ffffff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.6);
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .tstn-featured__btn:hover {
    background: #ffffff;
    color: #0a0a0a;
    border-color: #ffffff;
  }

  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .tstn-featured__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 500px) {
    #shopify-section-{{ section.id }} .tstn-featured__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "overline",
      "label": "Overline",
      "default": "FEATURED"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "GEAR WE RUN"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "VIEW ALL FEATURED"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#ff6a1a"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product card",
      "settings": [
        {
          "type": "header",
          "content": "Connect a product",
          "info": "Select a product to auto-fill image, title, brand (vendor), description, price, and link. Any field below will override the product data if filled in."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Manual overrides (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "text",
          "id": "brand",
          "label": "Brand override",
          "info": "Defaults to product vendor."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Short description override"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price override",
          "info": "Defaults to product price. Use to display strike-through or custom pricing copy."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override",
          "info": "Defaults to product URL."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "VIEW PRODUCT"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}