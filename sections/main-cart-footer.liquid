{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- style -%}
  @font-face {
    font-family: 'Danger Neue Free Regular';
    src: url('{{ 'DangerNeueFree-Regular.woff2' | asset_url }}') format('woff2'),
         url('https://fonts.cdnfonts.com/s/107588/DangerNeueFree-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ============================================================
     TSTN CART FOOTER — scoped, self-contained styling
     ============================================================ */
  #shopify-section-{{ section.id }} {
    --tstn-bg: #0a0a0a;
    --tstn-surface: #141414;
    --tstn-surface-2: #1b1b1b;
    --tstn-accent: #ff6a1a;
    --tstn-border: rgba(255, 255, 255, 0.08);
    --tstn-text: #f5f5f5;
    --tstn-muted: #9a9a9a;
  }

  #shopify-section-{{ section.id }} #main-cart-footer {
    background: var(--tstn-bg);
    color: var(--tstn-text);
    font-family: 'Rajdhani', sans-serif;
  }

  #shopify-section-{{ section.id }} #main-cart-footer.is-empty {
    display: none;
  }

  #shopify-section-{{ section.id }} .page-width {
    max-width: 1600px;
    margin: 0 auto;
    padding-left: clamp(16px, 4vw, 56px);
    padding-right: clamp(16px, 4vw, 56px);
  }

  #shopify-section-{{ section.id }} .cart__footer {
    border-top: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: clamp(24px, 4vw, 48px);
  }

  #shopify-section-{{ section.id }} .cart__footer > * {
    width: auto;
  }

  /* ---------- Order note ---------- */
  #shopify-section-{{ section.id }} .cart__note {
    flex: 1 1 420px;
    max-width: 560px;
    min-width: 0;
    top: 0;
  }

  #shopify-section-{{ section.id }} .cart__note label {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--tstn-muted);
    margin-bottom: 10px;
    position: static;
    display: inline-block;
  }

  #shopify-section-{{ section.id }} .cart__note .text-area {
    background: var(--tstn-surface);
    border: 1px solid var(--tstn-border);
    border-radius: 14px;
    color: var(--tstn-text);
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    padding: 14px 16px;
    min-height: 110px;
    transition: border-color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .cart__note .text-area::placeholder {
    color: var(--tstn-muted);
    opacity: 0.7;
  }

  #shopify-section-{{ section.id }} .cart__note .text-area:focus,
  #shopify-section-{{ section.id }} .cart__note .text-area:focus-visible {
    border-color: var(--tstn-accent);
    outline: none;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .cart__note .field__input::after,
  #shopify-section-{{ section.id }} .cart__note.field::after,
  #shopify-section-{{ section.id }} .cart__note.field::before {
    display: none;
  }

  /* ---------- Summary card ---------- */
  #shopify-section-{{ section.id }} .cart__blocks {
    background: var(--tstn-surface);
    border: 1px solid var(--tstn-border);
    border-radius: 18px;
    padding: clamp(22px, 3vw, 32px);
    width: 100%;
    max-width: 420px;
    margin-left: auto;
  }

  /* ---------- Cart-level discounts ---------- */
  #shopify-section-{{ section.id }} .discounts__discount {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tstn-accent);
    background: rgba(255, 106, 26, 0.1);
    border: 1px solid rgba(255, 106, 26, 0.3);
    border-radius: 999px;
    padding: 4px 12px;
    width: fit-content;
    margin-bottom: 14px;
  }

  #shopify-section-{{ section.id }} .discounts__discount svg path {
    fill: var(--tstn-accent);
  }

  /* ---------- Totals ---------- */
  #shopify-section-{{ section.id }} .totals {
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--tstn-border);
    padding-top: 18px;
  }

  #shopify-section-{{ section.id }} .totals__total {
    font-family: 'Danger Neue Free Regular', 'Rajdhani', sans-serif;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tstn-text);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .totals__total-value {
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--tstn-accent);
    margin: 0;
  }

  /* ---------- Tax note ---------- */
  #shopify-section-{{ section.id }} .tax-note {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--tstn-muted);
    margin-top: 12px;
    margin-bottom: 0;
    text-align: left;
    display: block;
  }

  #shopify-section-{{ section.id }} .tax-note a {
    color: var(--tstn-accent);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  /* ---------- Checkout button ---------- */
  #shopify-section-{{ section.id }} .cart__ctas {
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .cart__checkout-button {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: var(--tstn-accent);
    border: 1px solid var(--tstn-accent);
    border-radius: 999px;
    padding: 18px 24px;
    width: 100%;
    max-width: 100%;
    min-height: 0;
    box-shadow: none;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .cart__checkout-button::after,
  #shopify-section-{{ section.id }} .cart__checkout-button::before {
    display: none;
  }

  #shopify-section-{{ section.id }} .cart__checkout-button:hover:not([disabled]) {
    background: #ff7d38;
    transform: translateY(-2px);
    box-shadow: 0 10px 30px rgba(255, 106, 26, 0.25);
  }

  #shopify-section-{{ section.id }} .cart__checkout-button[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* ---------- Dynamic checkout buttons ---------- */
  #shopify-section-{{ section.id }} .cart__dynamic-checkout-buttons {
    margin-top: 14px;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .cart__dynamic-checkout-buttons [data-shopify-buttoncontainer] > * {
    border-radius: 999px;
    overflow: hidden;
  }

  /* ---------- Errors ---------- */
  #shopify-section-{{ section.id }} #cart-errors {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    color: #ff5a5a;
    margin-top: 12px;
  }

  /* ---------- Focus visibility ---------- */
  #shopify-section-{{ section.id }} a:focus-visible,
  #shopify-section-{{ section.id }} button:focus-visible,
  #shopify-section-{{ section.id }} textarea:focus-visible {
    outline: 2px solid var(--tstn-accent);
    outline-offset: 2px;
    box-shadow: none;
  }

  /* ---------- Mobile refinements ---------- */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cart__footer {
      flex-direction: column;
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .cart__note {
      max-width: 100%;
      flex: 1 1 auto;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .cart__blocks {
      max-width: 100%;
      margin-left: 0;
      border-radius: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} * {
      transition: none !important;
    }
  }
{%- endstyle -%}

<div
  class="{% if cart == empty %}is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                          {{ discount.title | escape }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
                </div>

                <small class="tax-note caption-large rte">
                  {%- if cart.duties_included and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- endif -%}
                </small>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
              </div>

              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
