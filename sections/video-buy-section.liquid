{% comment %}
  Section: Video + Buy Now Panel
  Layout: Configurable split | video panel | buy panel, rich text below
  Premium dark theme – Danger Neue headings

  Video behaviour matches other TSTN sections:
  cover/poster image + play button -> autoplay modal lightbox.

  Buy Now button: smooth-scrolls to the TSTN Product Banner section
  on the same page (falls back to Button URL if no banner is found).
{% endcomment %}

{%- liquid
  assign video_type       = section.settings.video_type
  assign youtube_url      = section.settings.youtube_url
  assign mp4_video        = section.settings.mp4_video
  assign heading          = section.settings.heading
  assign subheading       = section.settings.subheading
  assign product          = section.settings.product
  assign btn_label        = section.settings.button_label | default: 'Buy Now'
  assign btn_url          = section.settings.button_url | default: product.url
  assign show_btn         = section.settings.show_buy_button
  assign richtext         = section.settings.richtext
  assign section_padding_top    = section.settings.padding_top
  assign section_padding_bottom = section.settings.padding_bottom
  assign video_split      = section.settings.video_split
  assign panel_split      = 100 | minus: video_split
  assign badge_color      = section.settings.badge_text_color
  assign badge_icon_color = section.settings.badge_icon_color
  assign badge_font_size  = section.settings.badge_font_size
  assign badge_font_weight = section.settings.badge_font_weight
  assign subheading_color = section.settings.subheading_color
  assign custom_price     = section.settings.custom_price
  assign video_min_height = section.settings.video_min_height | default: 560
  assign scroll_target    = section.settings.scroll_target_selector | default: '.section-tstn-product-banner'
-%}

{%- comment -%} ── Build a single video URL + extract YouTube ID for thumbnail fallback ── {%- endcomment -%}
{%- assign vb_video_url = '' -%}
{%- assign yt_id = '' -%}
{%- if video_type == 'youtube' and youtube_url != blank -%}
  {%- assign vb_video_url = youtube_url -%}
  {%- assign yt_id = youtube_url -%}
  {%- if youtube_url contains 'youtu.be/' -%}
    {%- assign yt_id = youtube_url | split: 'youtu.be/' | last | split: '?' | first -%}
  {%- elsif youtube_url contains 'watch?v=' -%}
    {%- assign yt_id = youtube_url | split: 'watch?v=' | last | split: '&' | first -%}
  {%- elsif youtube_url contains 'embed/' -%}
    {%- assign yt_id = youtube_url | split: 'embed/' | last | split: '?' | first -%}
  {%- elsif youtube_url contains 'shorts/' -%}
    {%- assign yt_id = youtube_url | split: 'shorts/' | last | split: '?' | first -%}
  {%- endif -%}
{%- elsif video_type == 'file' and mp4_video != blank -%}
  {%- assign vb_video_url = mp4_video -%}
{%- endif -%}

<section
  id="video-buy-{{ section.id }}"
  class="vb-section"
  style="
    padding-top: {{ section_padding_top }}px;
    padding-bottom: {{ section_padding_bottom }}px;
    --vb-video-split: {{ video_split }}%;
    --vb-panel-split: calc({{ panel_split }}% - var(--vb-gap));
    --vb-video-min-height: {{ video_min_height }}px;
    --vb-badge-text-color: {{ badge_color }};
    --vb-badge-icon-color: {{ badge_icon_color }};
    --vb-badge-font-size: {{ badge_font_size }}px;
    --vb-badge-font-weight: {{ badge_font_weight }};
    --vb-subheading-color: {{ subheading_color }};
  "
>
  <div class="vb-wrapper">

    {%- comment -%} ── TOP SPLIT ROW ── {%- endcomment -%}
    <div class="vb-split">

      {%- comment -%} VIDEO COLUMN {%- endcomment -%}
      <div class="vb-video-col">
        <div class="vb-video-frame">

          {%- if vb_video_url != blank -%}
            <button
              class="vb-video-trigger"
              type="button"
              data-vb-video-trigger
              data-video-url="{{ vb_video_url | escape }}"
              aria-label="Play video"
            >
              {%- if section.settings.video_poster != blank -%}
                <img
                  class="vb-cover"
                  src="{{ section.settings.video_poster | image_url: width: 1600 }}"
                  alt="{{ heading | escape }}"
                  loading="lazy"
                >
              {%- elsif yt_id != blank -%}
                <img
                  class="vb-cover"
                  src="https://img.youtube.com/vi/{{ yt_id }}/maxresdefault.jpg"
                  alt="{{ heading | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <span class="vb-cover vb-cover--blank" aria-hidden="true"></span>
              {%- endif -%}

              <span class="vb-cover-shade" aria-hidden="true"></span>

              <span class="vb-play-icon" aria-hidden="true">
                <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="32" cy="32" r="31" stroke="rgba(255,255,255,0.35)" stroke-width="1.5"/>
                  <circle cx="32" cy="32" r="31" fill="rgba(0,0,0,0.25)"/>
                  <polygon points="26,20 48,32 26,44" fill="white"/>
                </svg>
              </span>
            </button>

          {%- else -%}
            <div class="vb-placeholder">
              <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <circle cx="32" cy="32" r="31" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
                <polygon points="26,20 50,32 26,44" fill="rgba(255,255,255,0.4)"/>
              </svg>
              <p>Add a video in the theme editor</p>
            </div>
          {%- endif -%}

          {%- comment -%} Decorative corner accent {%- endcomment -%}
          <span class="vb-corner vb-corner--tl" aria-hidden="true"></span>
          <span class="vb-corner vb-corner--br" aria-hidden="true"></span>

        </div>
      </div>
      {%- comment -%} END VIDEO COLUMN {%- endcomment -%}

      {%- comment -%} BUY PANEL {%- endcomment -%}
      <div class="vb-buy-col">
        <div class="vb-buy-panel">

          {%- comment -%} Subtle scanline texture overlay {%- endcomment -%}
          <div class="vb-panel-texture" aria-hidden="true"></div>

          {%- comment -%} Accent bar at top {%- endcomment -%}
          <div class="vb-panel-bar" aria-hidden="true"></div>

          {%- if heading != blank -%}
            <h2 class="vb-heading">{{ heading }}</h2>
          {%- endif -%}

          {%- if subheading != blank -%}
            <div class="vb-subheading rte">{{ subheading }}</div>
          {%- endif -%}

          {%- comment -%} Price: custom metafield overrides product price {%- endcomment -%}
          {%- if custom_price != blank or product != blank -%}
            <div class="vb-price">
              {%- if custom_price != blank -%}
                <span class="vb-price--current">{{ custom_price }}</span>
              {%- else -%}
                {%- if product.compare_at_price > product.price -%}
                  <span class="vb-price--compare">{{ product.compare_at_price | money }}</span>
                  <span class="vb-price--badge">SAVE {{ product.compare_at_price | minus: product.price | money }}</span>
                {%- endif -%}
                <span class="vb-price--current">{{ product.price | money }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="vb-divider" aria-hidden="true"></div>

          {%- if show_btn -%}
          <div class="vb-btn-wrap">
            <a
              href="{{ btn_url | default: '#' }}"
              class="vb-btn"
              data-vb-scroll-btn
              data-scroll-target="{{ scroll_target | escape }}"
              {%- if btn_url == blank -%} aria-disabled="true" {%- endif -%}
            >
              <span class="vb-btn-label">{{ btn_label }}</span>
              <svg class="vb-btn-arrow" width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 9H15M15 9L10 4M15 9L10 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
          {%- endif -%}

          {%- comment -%} Trust badges {%- endcomment -%}
          {%- if section.blocks.size > 0 -%}
            <div class="vb-badges">
              {%- for block in section.blocks -%}
                {%- if block.type == 'trust_badge' -%}
                  <div class="vb-badge" {{ block.shopify_attributes }}>
                    {%- if block.settings.icon != blank -%}
                      <span class="vb-badge-icon">{{ block.settings.icon }}</span>
                    {%- endif -%}
                    <span class="vb-badge-text">{{ block.settings.text }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>
      </div>
      {%- comment -%} END BUY PANEL {%- endcomment -%}

    </div>
    {%- comment -%} END SPLIT ROW {%- endcomment -%}

    {%- comment -%} ── RICH TEXT BELOW ── {%- endcomment -%}
    {%- if richtext != blank -%}
      <div class="vb-richtext rte">
        {{ richtext }}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} ── VIDEO MODAL (matches other TSTN sections) ── {%- endcomment -%}
  <div class="vb-modal" id="vb-modal-{{ section.id }}" data-vb-modal aria-hidden="true" role="dialog" aria-modal="true">
    <div class="vb-modal-inner">
      <button class="vb-modal-close" type="button" data-vb-modal-close aria-label="Close video">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="vb-modal-frame" data-vb-modal-frame></div>
    </div>
  </div>

</section>

<style>
  /* ─────────────────────────────────────────
     TSTN – Video + Buy Now Section
     Premium dark theme · Danger Neue headings
  ───────────────────────────────────────── */

  @import url('https://fonts.cdnfonts.com/css/danger-neue');

  #video-buy-{{ section.id }} {
    --vb-bg:              {{ section.settings.bg_color }};
    --vb-text:            {{ section.settings.text_color }};
    --vb-accent:          {{ section.settings.accent_color }};
    --vb-panel-bg:        {{ section.settings.panel_bg_color }};
    --vb-border:          rgba(255,255,255,0.08);
    --vb-radius:          14px;
    --vb-gap:             3px;
    --vb-badge-text-color: {{ badge_color }};
    --vb-badge-icon-color: {{ badge_icon_color }};
  }

  /* ── Section wrapper ── */
  .vb-section {
    background: var(--vb-bg);
    color: var(--vb-text);
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  /* Subtle ambient glow behind the panel */
  .vb-section::before {
    content: '';
    position: absolute;
    top: -30%;
    right: -10%;
    width: 55%;
    height: 160%;
    background: radial-gradient(ellipse at center, rgba(255,255,255,0.03) 0%, transparent 65%);
    pointer-events: none;
  }

  .vb-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  /* ── Split row ── */
  .vb-split {
    display: flex;
    gap: var(--vb-gap);
    align-items: stretch;
    border-radius: var(--vb-radius);
    overflow: hidden;
    box-shadow:
      0 0 0 1px var(--vb-border),
      0 32px 80px rgba(0,0,0,0.6),
      0 8px 24px rgba(0,0,0,0.4);
  }

  .vb-video-col {
    flex: 0 0 var(--vb-video-split);
    min-width: 0;
  }

  .vb-buy-col {
    flex: 0 0 var(--vb-panel-split);
    min-width: 0;
  }

  /* ── Video frame ── */
  .vb-video-frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: var(--vb-video-min-height, 560px);
    background: #000;
    overflow: hidden;
  }

  /* ── Cover + play trigger ── */
  .vb-video-trigger {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: #000;
    cursor: pointer;
    display: block;
  }

  .vb-cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .vb-cover--blank {
    background: #0d0d0d;
  }

  .vb-video-trigger:hover .vb-cover {
    transform: scale(1.04);
  }

  .vb-cover-shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.45) 100%);
    transition: background 0.25s ease;
    z-index: 1;
  }

  .vb-video-trigger:hover .vb-cover-shade {
    background:
      radial-gradient(ellipse at center, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.35) 100%);
  }

  .vb-play-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    transition: transform 0.2s ease;
    pointer-events: none;
  }

  .vb-video-trigger:hover .vb-play-icon {
    transform: translate(-50%, -50%) scale(1.1);
  }

  /* Decorative corner marks */
  .vb-corner {
    position: absolute;
    width: 20px;
    height: 20px;
    z-index: 3;
    pointer-events: none;
  }

  .vb-corner--tl {
    top: 12px;
    left: 12px;
    border-top: 2px solid var(--vb-accent);
    border-left: 2px solid var(--vb-accent);
    opacity: 0.5;
  }

  .vb-corner--br {
    bottom: 12px;
    right: 12px;
    border-bottom: 2px solid var(--vb-accent);
    border-right: 2px solid var(--vb-accent);
    opacity: 0.5;
  }

  .vb-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    background: #0d0d0d;
    color: rgba(255,255,255,0.3);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Video modal ── */
  .vb-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .vb-modal.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .vb-modal-inner {
    position: relative;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 30px 90px rgba(0,0,0,0.7);
    transform: scale(0.96);
    transition: transform 0.3s ease;
  }

  .vb-modal.is-open .vb-modal-inner {
    transform: scale(1);
  }

  .vb-modal-frame {
    position: absolute;
    inset: 0;
  }

  .vb-modal-frame iframe,
  .vb-modal-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .vb-modal-close {
    position: absolute;
    top: -14px;
    right: -14px;
    z-index: 2;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.2);
    background: var(--vb-accent);
    color: var(--vb-bg);
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .vb-modal-close:hover {
    transform: scale(1.08) rotate(90deg);
  }

  @media (max-width: 600px) {
    .vb-modal-close {
      top: 8px;
      right: 8px;
    }
  }

  /* ── Buy panel ── */
  .vb-buy-panel {
    background: var(--vb-panel-bg);
    height: 100%;
    padding: 40px 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-left: 1px solid var(--vb-border);
    position: relative;
    overflow: hidden;
  }

  /* Scanline texture */
  .vb-panel-texture {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(255,255,255,0.015) 2px,
      rgba(255,255,255,0.015) 4px
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Accent top bar */
  .vb-panel-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--vb-accent) 30%,
      var(--vb-accent) 70%,
      transparent 100%
    );
    opacity: 0.8;
    z-index: 1;
  }

  /* All direct children above the texture */
  .vb-buy-panel > *:not(.vb-panel-texture):not(.vb-panel-bar) {
    position: relative;
    z-index: 1;
  }

  /* ── Heading – Danger Neue ── */
  .vb-heading {
    font-family: 'Danger Neue Free Regular', 'Danger Neue', 'Impact', sans-serif;
    font-weight: 400; /* Danger Neue Regular */
    font-size: clamp(22px, 2.4vw, 34px);
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--vb-text);
    margin: 0;
  }

  /* ── Subheading (rich text) ── */
  .vb-subheading {
    font-size: 13px;
    line-height: 1.7;
    color: var(--vb-subheading-color);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .vb-subheading p {
    margin: 0 0 0.6em;
  }

  .vb-subheading p:last-child {
    margin-bottom: 0;
  }

  .vb-subheading a {
    color: var(--vb-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .vb-subheading strong {
    color: var(--vb-text);
    font-weight: 700;
  }

  .vb-subheading em {
    font-style: italic;
    opacity: 0.85;
  }

  /* ── Price ── */
  .vb-price {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .vb-price--compare {
    font-size: 14px;
    color: rgba(255,255,255,0.3);
    text-decoration: line-through;
  }

  .vb-price--current {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 700;
    color: var(--vb-text);
    letter-spacing: -0.03em;
  }

  .vb-price--badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--vb-bg);
    background: var(--vb-accent);
    padding: 3px 8px;
    border-radius: 4px;
  }

  /* ── Divider ── */
  .vb-divider {
    height: 1px;
    background: linear-gradient(90deg, var(--vb-accent) 0%, transparent 80%);
    opacity: 0.25;
    margin: 2px 0;
  }

  /* ── Button ── */
  .vb-btn-wrap {
    margin-top: 4px;
  }

  .vb-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 17px 24px;
    background: var(--vb-accent);
    color: var(--vb-bg);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 8px;
    border: 2px solid var(--vb-accent);
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: background 0.2s ease, color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  /* Shine sweep on hover */
  .vb-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -75%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
    transform: skewX(-15deg);
    transition: left 0.4s ease;
  }

  .vb-btn:hover::after {
    left: 150%;
  }

  .vb-btn:hover {
    background: transparent;
    color: var(--vb-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
  }

  .vb-btn-arrow {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .vb-btn:hover .vb-btn-arrow {
    transform: translateX(5px);
  }

  /* ── Trust badges ── */
  .vb-badges {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: auto;
    border-top: 1px solid var(--vb-border);
    padding-top: 16px;
  }

  .vb-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--vb-badge-font-size, 12px);
    font-weight: var(--vb-badge-font-weight, 400);
    letter-spacing: 0.03em;
    color: var(--vb-badge-text-color);
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: color 0.2s ease;
  }

  .vb-badge:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .vb-badge-icon {
    font-size: calc(var(--vb-badge-font-size, 12px) + 3px);
    color: var(--vb-badge-icon-color);
    flex-shrink: 0;
    width: 20px;
    text-align: center;
  }

  .vb-badge-text {
    color: var(--vb-badge-text-color);
  }

  /* ── Rich text ── */
  .vb-richtext {
    margin-top: 48px;
    padding-top: 48px;
    border-top: 1px solid var(--vb-border);
    color: rgba(255,255,255,0.7);
    line-height: 1.8;
    font-size: 15px;
  }

  .vb-richtext h1,
  .vb-richtext h2,
  .vb-richtext h3,
  .vb-richtext h4 {
    font-family: 'Danger Neue Free Regular', 'Danger Neue', 'Impact', sans-serif;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--vb-text);
    margin-top: 1.6em;
  }

  .vb-richtext a {
    color: var(--vb-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .vb-richtext ul,
  .vb-richtext ol {
    padding-left: 1.5em;
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .vb-split {
      flex-direction: column;
    }

    .vb-video-col,
    .vb-buy-col {
      flex: 0 0 100% !important;
    }

    .vb-video-frame {
      min-height: 64vw;
    }

    .vb-buy-panel {
      border-left: none;
      border-top: 1px solid var(--vb-border);
      padding: 32px 24px 28px;
    }

    .vb-panel-bar {
      top: 0;
    }
  }
</style>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var section   = document.getElementById('video-buy-' + sectionId);
    if (!section) return;
    if (section.dataset.tstnVbBound === 'true') return;
    section.dataset.tstnVbBound = 'true';

    /* ───────────────────────────────────────────
       BUY NOW → smooth-scroll to TSTN Product Banner
    ─────────────────────────────────────────── */
    var scrollBtn = section.querySelector('[data-vb-scroll-btn]');

    function findBannerTarget() {
      // 1. Custom selector from section settings
      var customSel = scrollBtn ? scrollBtn.getAttribute('data-scroll-target') : '';
      var selectors = [];
      if (customSel) selectors.push(customSel);

      // 2. Known fallbacks for the TSTN Product Banner section
      selectors.push(
        '.section-tstn-product-banner',
        '.tstn-product-banner',
        '[data-tstn-product-banner]',
        '.shopify-section[id*="tstn_product_banner"]',
        '.shopify-section[id*="tstn-product-banner"]'
      );

      for (var i = 0; i < selectors.length; i++) {
        try {
          var el = document.querySelector(selectors[i]);
          if (el) return el;
        } catch (err) { /* ignore invalid selector */ }
      }
      return null;
    }

    function getHeaderOffset() {
      var header = document.querySelector('.shopify-section-header-sticky, .section-header, sticky-header, .header-wrapper');
      if (header && getComputedStyle(header).position !== 'static') {
        return header.getBoundingClientRect().height;
      }
      return 0;
    }

    if (scrollBtn) {
      scrollBtn.addEventListener('click', function (e) {
        var target = findBannerTarget();
        if (target) {
          e.preventDefault();
          var top = target.getBoundingClientRect().top + window.pageYOffset - getHeaderOffset() - 12;
          window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
        }
        // No banner on this page -> fall through to the href (Button URL / product URL)
      });
    }

    /* ───────────────────────────────────────────
       VIDEO MODAL
    ─────────────────────────────────────────── */
    var modal = section.querySelector('#vb-modal-' + sectionId);
    if (!modal) return;

    var frame    = modal.querySelector('[data-vb-modal-frame]');
    var closeBtn = modal.querySelector('[data-vb-modal-close]');
    var triggers = section.querySelectorAll('[data-vb-video-trigger]');

    // Convert any pasted YouTube / Vimeo / direct URL to its embed form
    function buildEmbed(rawUrl) {
      if (!rawUrl) return null;
      var url = rawUrl.trim();

      var ytMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
      if (ytMatch) {
        return {
          type: 'iframe',
          src: 'https://www.youtube.com/embed/' + ytMatch[1] + '?autoplay=1&rel=0&modestbranding=1'
        };
      }

      var vimeoMatch = url.match(/(?:vimeo\.com\/(?:video\/)?|player\.vimeo\.com\/video\/)(\d+)/);
      if (vimeoMatch) {
        return {
          type: 'iframe',
          src: 'https://player.vimeo.com/video/' + vimeoMatch[1] + '?autoplay=1'
        };
      }

      if (/\.(mp4|webm|ogg|ogv|mov)(\?.*)?$/i.test(url)) {
        return { type: 'video', src: url };
      }

      // Fallback - treat as iframe (Shopify CDN / custom player URL)
      return { type: 'iframe', src: url };
    }

    function openModal(url) {
      var embed = buildEmbed(url);
      if (!embed || !embed.src || embed.src === '#') return;

      if (embed.type === 'iframe') {
        frame.innerHTML =
          '<iframe src="' + embed.src + '" ' +
          'allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" ' +
          'allowfullscreen></iframe>';
      } else {
        frame.innerHTML =
          '<video src="' + embed.src + '" controls autoplay playsinline></video>';
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      frame.innerHTML = ''; // clears iframe/video -> stops playback
      document.body.style.overflow = '';
    }

    triggers.forEach(function (t) {
      t.addEventListener('click', function () {
        openModal(t.getAttribute('data-video-url'));
      });
    });

    closeBtn.addEventListener('click', closeModal);

    // Click backdrop to close
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal();
    });

    // ESC to close
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });
  })();
</script>

