{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}

<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">

{%- style -%}
  @font-face {
    font-family: 'Danger Neue Free Regular';
    src: url('{{ 'DangerNeueFree-Regular.woff2' | asset_url }}') format('woff2'),
         url('https://fonts.cdnfonts.com/s/107588/DangerNeueFree-Regular.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ============================================================
     TSTN CART — scoped, self-contained styling
     ============================================================ */
  #shopify-section-{{ section.id }} {
    --tstn-bg: #0a0a0a;
    --tstn-surface: #141414;
    --tstn-surface-2: #1b1b1b;
    --tstn-accent: #ff6a1a;
    --tstn-border: rgba(255, 255, 255, 0.08);
    --tstn-text: #f5f5f5;
    --tstn-muted: #9a9a9a;
    background: var(--tstn-bg);
  }

  #shopify-section-{{ section.id }} cart-items {
    display: block;
    background: var(--tstn-bg);
    color: var(--tstn-text);
    font-family: 'Rajdhani', sans-serif;
  }

  #shopify-section-{{ section.id }} .page-width {
    max-width: 1600px;
    margin: 0 auto;
    padding-left: clamp(16px, 4vw, 56px);
    padding-right: clamp(16px, 4vw, 56px);
  }

  /* ---------- Header / title ---------- */
  #shopify-section-{{ section.id }} .tstn-cart-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--tstn-accent);
    margin: 0 0 10px;
  }

  #shopify-section-{{ section.id }} .tstn-cart-eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: var(--tstn-accent);
  }

  #shopify-section-{{ section.id }} .title-wrapper-with-link {
    align-items: flex-end;
    gap: 16px;
    margin-bottom: clamp(24px, 4vw, 48px);
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .title--primary {
    font-family: 'Danger Neue Free Regular', 'Rajdhani', sans-serif;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--tstn-text);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .tstn-cart-count {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tstn-muted);
    margin: 6px 0 0;
  }

  #shopify-section-{{ section.id }} .tstn-cart-count strong {
    color: var(--tstn-accent);
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .underlined-link {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tstn-text);
    text-decoration: none;
    text-underline-offset: 0;
    border-bottom: 2px solid var(--tstn-accent);
    padding-bottom: 4px;
    transition: color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .underlined-link:hover {
    color: var(--tstn-accent);
    text-decoration: none;
  }

  /* ---------- Cart table → card panel ---------- */
  #shopify-section-{{ section.id }} .cart__items {
    background: var(--tstn-surface);
    border: 1px solid var(--tstn-border);
    border-radius: 18px;
    padding: clamp(8px, 2vw, 24px) clamp(14px, 2.5vw, 32px);
    border-top-width: 1px;
  }

  #shopify-section-{{ section.id }} .cart-items {
    border: 0;
  }

  #shopify-section-{{ section.id }} .cart-items thead th {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--tstn-muted);
    border-bottom: 1px solid var(--tstn-border);
    padding-bottom: 16px;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .cart-item {
    border-bottom: 1px solid var(--tstn-border);
  }

  #shopify-section-{{ section.id }} .cart-item:last-child {
    border-bottom: 0;
  }

  #shopify-section-{{ section.id }} .cart-item > td {
    border: 0;
    padding-top: clamp(18px, 3vw, 28px);
    padding-bottom: clamp(18px, 3vw, 28px);
  }

  /* ---------- Product media ---------- */
  #shopify-section-{{ section.id }} .cart-item__image-container {
    background: var(--tstn-surface-2);
    border: 1px solid var(--tstn-border);
    border-radius: 14px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .cart-item__image {
    border-radius: 0;
    display: block;
    transition: transform 0.4s ease;
  }

  #shopify-section-{{ section.id }} .cart-item:hover .cart-item__image {
    transform: scale(1.04);
  }

  /* ---------- Product details ---------- */
  #shopify-section-{{ section.id }} .cart-item__name {
    font-family: 'Danger Neue Free Regular', 'Rajdhani', sans-serif;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    line-height: 1.15;
    color: var(--tstn-text);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  #shopify-section-{{ section.id }} .cart-item__name:hover {
    color: var(--tstn-accent);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .cart-item__details {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1rem;
    color: var(--tstn-muted);
  }

  #shopify-section-{{ section.id }} .cart-item__details .caption-with-letter-spacing {
    color: var(--tstn-accent);
    font-weight: 700;
    letter-spacing: 0.22em;
    font-size: 0.72rem;
  }

  #shopify-section-{{ section.id }} .product-option {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--tstn-muted);
  }

  #shopify-section-{{ section.id }} .product-option dt {
    font-weight: 700;
    color: var(--tstn-muted);
  }

  #shopify-section-{{ section.id }} .product-option dd {
    color: var(--tstn-text);
    font-weight: 600;
  }

  /* ---------- Prices ---------- */
  #shopify-section-{{ section.id }} .price,
  #shopify-section-{{ section.id }} .price--end {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--tstn-text);
  }

  #shopify-section-{{ section.id }} .cart-item__old-price {
    color: var(--tstn-muted);
    font-weight: 500;
    font-size: 0.95rem;
  }

  #shopify-section-{{ section.id }} .cart-item__final-price {
    color: var(--tstn-accent);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
  }

  /* ---------- Quantity controls ---------- */
  #shopify-section-{{ section.id }} .quantity {
    background: var(--tstn-surface-2);
    border: 1px solid var(--tstn-border);
    border-radius: 999px;
    min-height: 46px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .quantity::after,
  #shopify-section-{{ section.id }} .quantity::before {
    display: none;
  }

  #shopify-section-{{ section.id }} .quantity__input {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--tstn-text);
    background: transparent;
  }

  #shopify-section-{{ section.id }} .quantity__button {
    color: var(--tstn-muted);
    transition: color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .quantity__button:hover {
    color: var(--tstn-accent);
  }

  #shopify-section-{{ section.id }} .quantity__button .svg-wrapper,
  #shopify-section-{{ section.id }} .quantity__button svg {
    color: currentColor;
  }

  #shopify-section-{{ section.id }} .quantity__button svg path {
    fill: currentColor;
  }

  /* ---------- Remove button ---------- */
  #shopify-section-{{ section.id }} cart-remove-button .button {
    background: transparent;
    border: 1px solid var(--tstn-border);
    border-radius: 999px;
    width: 46px;
    height: 46px;
    min-width: 46px;
    min-height: 46px;
    color: var(--tstn-muted);
    box-shadow: none;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  #shopify-section-{{ section.id }} cart-remove-button .button:hover {
    color: var(--tstn-accent);
    border-color: var(--tstn-accent);
    background: rgba(255, 106, 26, 0.08);
  }

  #shopify-section-{{ section.id }} cart-remove-button .button::after,
  #shopify-section-{{ section.id }} cart-remove-button .button::before {
    display: none;
  }

  #shopify-section-{{ section.id }} cart-remove-button svg path {
    fill: currentColor;
  }

  /* ---------- Discounts ---------- */
  #shopify-section-{{ section.id }} .discounts__discount {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tstn-accent);
    background: rgba(255, 106, 26, 0.1);
    border: 1px solid rgba(255, 106, 26, 0.3);
    border-radius: 999px;
    padding: 4px 12px;
    width: fit-content;
    margin-top: 8px;
  }

  #shopify-section-{{ section.id }} .discounts__discount svg path {
    fill: var(--tstn-accent);
  }

  /* ---------- Quantity popover / volume pricing ---------- */
  #shopify-section-{{ section.id }} .quantity-popover__info {
    background: var(--tstn-surface-2);
    border: 1px solid var(--tstn-border);
    border-radius: 12px;
    color: var(--tstn-text);
  }

  #shopify-section-{{ section.id }} .quantity-popover__info-button {
    color: var(--tstn-muted);
  }

  #shopify-section-{{ section.id }} .quantity__rules,
  #shopify-section-{{ section.id }} .volume-pricing-label {
    color: var(--tstn-muted);
    font-family: 'Rajdhani', sans-serif;
  }

  /* ---------- Errors ---------- */
  #shopify-section-{{ section.id }} .cart-item__error-text {
    font-family: 'Rajdhani', sans-serif;
    color: #ff5a5a;
    font-weight: 600;
  }

  /* ---------- Loading spinner ---------- */
  #shopify-section-{{ section.id }} .loading__spinner .spinner .path {
    stroke: var(--tstn-accent);
  }

  /* ---------- Empty state ---------- */
  #shopify-section-{{ section.id }} .is-empty .cart__warnings {
    padding: clamp(64px, 12vw, 140px) 0;
  }

  #shopify-section-{{ section.id }} .cart__empty-text {
    font-family: 'Danger Neue Free Regular', 'Rajdhani', sans-serif;
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--tstn-text);
    margin-bottom: 28px;
  }

  #shopify-section-{{ section.id }} .cart__warnings .button {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0a0a0a;
    background: var(--tstn-accent);
    border: 1px solid var(--tstn-accent);
    border-radius: 999px;
    padding: 16px 40px;
    min-height: 0;
    box-shadow: none;
    transition: background 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  #shopify-section-{{ section.id }} .cart__warnings .button::after,
  #shopify-section-{{ section.id }} .cart__warnings .button::before {
    display: none;
  }

  #shopify-section-{{ section.id }} .cart__warnings .button:hover {
    background: transparent;
    color: var(--tstn-accent);
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .cart__login-title {
    font-family: 'Danger Neue Free Regular', 'Rajdhani', sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 1.6rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tstn-text);
    margin-top: clamp(40px, 8vw, 72px);
  }

  #shopify-section-{{ section.id }} .cart__login-paragraph {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.05rem;
    color: var(--tstn-muted);
  }

  #shopify-section-{{ section.id }} .cart__login-paragraph a {
    color: var(--tstn-accent);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  /* ---------- Focus visibility ---------- */
  #shopify-section-{{ section.id }} a:focus-visible,
  #shopify-section-{{ section.id }} button:focus-visible,
  #shopify-section-{{ section.id }} input:focus-visible {
    outline: 2px solid var(--tstn-accent);
    outline-offset: 2px;
    box-shadow: none;
  }

  /* ---------- Mobile refinements ---------- */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cart__items {
      border-radius: 14px;
      padding: 4px 14px;
    }

    #shopify-section-{{ section.id }} .title-wrapper-with-link {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    #shopify-section-{{ section.id }} .quantity {
      min-height: 42px;
    }

    #shopify-section-{{ section.id }} cart-remove-button .button {
      width: 42px;
      height: 42px;
      min-width: 42px;
      min-height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} * {
      transition: none !important;
    }
  }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class="isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <div>
        <p class="tstn-cart-eyebrow">TSTN Store</p>
        <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
        {%- if cart != empty -%}
          <p class="tstn-cart-count">
            <strong>{{ cart.item_count }}</strong>
            {%- if cart.item_count == 1 %} item{% else %} items{% endif %} in your cart
          </p>
        {%- endif -%}
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
        {{- 'general.continue_shopping' | t -}}
      </a>
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      <a href="{{ routes.all_products_collection_url }}" class="button">
        {{ 'general.continue_shopping' | t }}
      </a>

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {%- if cart != empty -%}
            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead>
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for item in cart.items -%}
                  <tr
                    class="cart-item {% if item.parent_relationship.parent != null %}cart-item__nested-line{% endif %}"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                  >
                    <td class="cart-item__media">
                      {% if item.image %}
                        {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                        <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                        <div class="cart-item__image-container {% if item.parent_relationship.parent == null %}global-media-settings{% endif %}">
                          <img
                            src="{{ item.image | image_url: width: 300 }}"
                            class="cart-item__image {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="150"
                            height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        </div>
                      {% endif %}
                    </td>

                    <td class="cart-item__details">
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s class="cart-item__old-price product-option">
                            {{- item.original_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong class="cart-item__final-price product-option">
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {%- else -%}
                        <div class="product-option">
                          {{ item.original_price | money }}
                        </div>
                      {%- endif -%}

                      {%- if item.product.has_only_default_variant == false
                        or item.properties.size != 0
                        or item.selling_plan_allocation != null
                      -%}
                        <dl>
                          {%- if item.product.has_only_default_variant == false -%}
                            {%- for option in item.options_with_values -%}
                              <div class="product-option">
                                <dt>{{ option.name }}:</dt>
                                <dd>{{ option.value }}</dd>
                              </div>
                            {%- endfor -%}
                          {%- endif -%}

                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="product-option">
                                <dt>{{ property.first }}:</dt>
                                <dd>
                                  {%- if property.last contains '/uploads/' -%}
                                    <a href="{{ property.last }}" class="link" target="_blank">
                                      {{ property.last | split: '/' | last }}
                                    </a>
                                  {%- else -%}
                                    {{ property.last }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>

                        <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>

                    <td class="cart-item__totals right medium-hide large-up-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif

                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                aria-expanded="false"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                              >
                                {{- 'icon-info.svg' | inline_asset_content -}}
                              </button>
                            {%- endif -%}
                            <quantity-input class="quantity cart-quantity">
                              {% assign can_update_quantity = item.instructions.can_update_quantity | default: true %}
                              <button
                                class="quantity__button"
                                name="minus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-minus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                              <button
                                class="quantity__button"
                                name="plus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-plus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </quantity-input>
                          </div>
                          <cart-remove-button
                            id="Remove-{{ item.index | plus: 1 }}"
                            data-index="{{ item.index | plus: 1 }}"
                            {% assign can_remove = item.instructions.can_remove | default: true %}
                            {% if can_remove == false %}
                              class="hidden"
                            {% endif %}
                          >
                            <a
                              href="{{ item.url_to_remove }}"
                              class="button button--tertiary"
                              aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-remove.svg' | inline_asset_content -}}
                              </span>
                            </a>
                          </cart-remove-button>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                            aria-expanded="false"
                          >
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- elsif has_qty_rules -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        {%- endif -%}
                        {%- if has_vol_pricing or has_qty_rules -%}
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.multiples_of'
                                    | t: quantity: item.variant.quantity_rule.increment
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.min_of'
                                    | t: quantity: item.variant.quantity_rule.min
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.max_of'
                                    | t: quantity: item.variant.quantity_rule.max
                                  -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary large-up-hide"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    {%- assign price = item.variant.price | money_with_currency -%}
                                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      {%- assign price = price_break.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </td>

                    <td class="cart-item__totals right small-hide">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- endif -%}
        </div>
      </div>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
