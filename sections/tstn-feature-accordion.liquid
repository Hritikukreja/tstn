{% comment %}
  TSTN — See It In Action / Feature Accordion
  Two-column premium product feature section:
    Left  : Cinematic video with overlay play button + trust badge
    Right : Expandable feature accordion (blocks)
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --tstn-bg: {{ section.settings.bg_color }};
    --tstn-card-bg: {{ section.settings.card_bg_color }};
    --tstn-accent: {{ section.settings.accent_color }};
    --tstn-eyebrow: {{ section.settings.eyebrow_color }};
    --tstn-heading: {{ section.settings.heading_color }};
    --tstn-sub: {{ section.settings.subheading_color }};
    --tstn-text: {{ section.settings.text_color }};
    --tstn-border: {{ section.settings.border_color }};
    --tstn-heading-size: {{ section.settings.heading_size }}px;
    --tstn-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --tstn-sub-size: {{ section.settings.subheading_size }}px;
    --tstn-radius: {{ section.settings.corner_radius }}px;
    --tstn-pad-top: {{ section.settings.padding_top }}px;
    --tstn-pad-bottom: {{ section.settings.padding_bottom }}px;

    background: var(--tstn-bg) !important;
    padding: var(--tstn-pad-top) 0 var(--tstn-pad-bottom) 0 !important;
    color: var(--tstn-text);
    position: relative;
    overflow: hidden;
  }

  /* Subtle textured background */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 15% 20%, rgba(255,106,26,0.04) 0%, transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(255,106,26,0.03) 0%, transparent 45%);
    pointer-events: none;
    z-index: 0;
  }

  .tstn-fa__inner {
    position: relative;
    z-index: 1;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .tstn-fa__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
  }

  /* ============ LEFT COLUMN ============ */
  .tstn-fa__left {
    display: flex;
    flex-direction: column;
  }

  .tstn-fa__eyebrow-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .tstn-fa__eyebrow {
    font-family: 'Danger Neue Free Regular', var(--font-heading-family), sans-serif !important;
    font-size: var(--tstn-eyebrow-size);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tstn-accent);
    margin: 0;
    line-height: 1;
  }

  .tstn-fa__eyebrow-line {
    width: 32px;
    height: 2px;
    background: var(--tstn-accent);
    border-radius: 2px;
  }

  .tstn-fa__heading {
    font-family: 'Danger Neue Free Regular', var(--font-heading-family), sans-serif !important;
    font-size: clamp(calc(var(--tstn-heading-size) * 0.45), 7vw, var(--tstn-heading-size));
    line-height: 0.95;
    letter-spacing: 0.01em;
    color: var(--tstn-heading);
    margin: 0 0 18px 0;
    text-transform: uppercase;
    font-weight: 400;
  }

  .tstn-fa__sub {
    font-size: var(--tstn-sub-size);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tstn-sub);
    margin: 0 0 28px 0;
    line-height: 1.4;
  }

  /* Video block */
  .tstn-fa__video {
    position: relative;
    border-radius: var(--tstn-radius);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #000;
    box-shadow:
      0 0 0 1px rgba(255,106,26,0.18),
      0 20px 60px rgba(0,0,0,0.5),
      0 0 80px rgba(255,106,26,0.08);
    cursor: pointer;
  }

  .tstn-fa__video img,
  .tstn-fa__video video,
  .tstn-fa__video iframe {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    border: none;
  }

  .tstn-fa__video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 40%);
    pointer-events: none;
  }

  .tstn-fa__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: rgba(10,10,10,0.55);
    border: 2px solid var(--tstn-accent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: transform 0.3s ease, background 0.3s ease;
    pointer-events: none;
  }

  .tstn-fa__video:hover .tstn-fa__play {
    transform: translate(-50%, -50%) scale(1.08);
    background: var(--tstn-accent);
  }

  .tstn-fa__play svg {
    width: 28px;
    height: 28px;
    fill: var(--tstn-accent);
    margin-left: 4px;
    transition: fill 0.3s ease;
  }

  .tstn-fa__video:hover .tstn-fa__play svg { fill: #fff; }

  .tstn-fa__video-tag {
    position: absolute;
    bottom: 18px;
    left: 18px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(10,10,10,0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 8px 12px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.08);
  }

  .tstn-fa__duration {
    font-family: 'Danger Neue Free Regular', var(--font-heading-family), sans-serif !important;
    font-size: 13px;
    color: var(--tstn-accent);
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border: 1px solid var(--tstn-accent);
    border-radius: 4px;
    line-height: 1;
  }

  .tstn-fa__video-label {
    font-family: 'Danger Neue Free Regular', var(--font-heading-family), sans-serif !important;
    font-size: 13px;
    color: #fff;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* Trust badge */
  .tstn-fa__trust {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding: 14px 16px;
    border-radius: 10px;
    background: rgba(255,106,26,0.04);
    border: 1px solid rgba(255,106,26,0.12);
  }

  .tstn-fa__trust-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255,106,26,0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tstn-accent);
  }

  .tstn-fa__trust-icon svg { width: 18px; height: 18px; }

  .tstn-fa__trust-text {
    font-size: 14px;
    line-height: 1.45;
    color: var(--tstn-text);
    margin: 0;
  }

  .tstn-fa__trust-text p { margin: 0; }

  /* ============ RIGHT COLUMN — ACCORDION ============ */
  .tstn-fa__right {
    background: var(--tstn-card-bg);
    border-radius: var(--tstn-radius);
    border: 1px solid var(--tstn-border);
    box-shadow:
      0 0 0 1px rgba(255,106,26,0.08),
      0 20px 60px rgba(0,0,0,0.4);
    overflow: hidden;
    align-self: start;
  }

  .tstn-fa__item {
    border-bottom: 1px solid var(--tstn-border);
    position: relative;
    transition: background 0.3s ease;
  }

  .tstn-fa__item:last-child { border-bottom: none; }

  .tstn-fa__item.is-open {
    background: linear-gradient(180deg, rgba(255,106,26,0.06) 0%, rgba(255,106,26,0.02) 100%);
  }

  .tstn-fa__item.is-open::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--tstn-accent);
    box-shadow: 0 0 16px rgba(255,106,26,0.5);
  }

  .tstn-fa__trigger {
    width: 100%;
    background: none;
    border: none;
    box-shadow: none !important;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    padding: 22px 26px;
    display: flex;
    align-items: center;
    gap: 16px;
    text-align: left;
    color: inherit;
    font-family: inherit;
    transition: background 0.25s ease;
  }

  .tstn-fa__trigger:hover { background: rgba(255,255,255,0.02); }
  .tstn-fa__trigger:focus { outline: none; box-shadow: none !important; }
  .tstn-fa__trigger:focus-visible { outline: 2px solid var(--tstn-accent); outline-offset: -2px; }

  .tstn-fa__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255,106,26,0.1);
    border: 1px solid rgba(255,106,26,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tstn-accent);
    transition: all 0.3s ease;
  }

  .tstn-fa__item.is-open .tstn-fa__icon {
    background: rgba(255,106,26,0.18);
    border-color: var(--tstn-accent);
  }

  .tstn-fa__icon svg { width: 18px; height: 18px; }

  .tstn-fa__title {
    font-family: 'Danger Neue Free Regular', var(--font-heading-family), sans-serif !important;
    font-size: 18px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    margin: 0;
    flex: 1;
    line-height: 1;
    font-weight: 400;
  }

  .tstn-fa__toggle {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tstn-accent);
    position: relative;
  }

  .tstn-fa__toggle::before,
  .tstn-fa__toggle::after {
    content: '';
    position: absolute;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .tstn-fa__toggle::before {
    width: 14px;
    height: 2px;
  }

  .tstn-fa__toggle::after {
    width: 2px;
    height: 14px;
  }

  .tstn-fa__item.is-open .tstn-fa__toggle::after {
    transform: rotate(90deg);
    opacity: 0;
  }

  /* Panel */
  .tstn-fa__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }

  .tstn-fa__item.is-open .tstn-fa__panel {
    max-height: 1500px;
  }

  .tstn-fa__panel-inner {
    padding: 0 26px 26px 26px;
  }

  .tstn-fa__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--tstn-text);
    margin: 0 0 22px 0;
  }

  .tstn-fa__desc p { margin: 0 0 10px 0; }
  .tstn-fa__desc p:last-child { margin-bottom: 0; }

  /* Sub-features */
  .tstn-fa__subs {
    display: flex;
    flex-direction: column;
  }

  .tstn-fa__sub-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 16px 0;
    border-top: 1px solid var(--tstn-border);
  }

  .tstn-fa__sub-row:first-child { border-top: 1px solid var(--tstn-border); }

  .tstn-fa__sub-icon {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tstn-accent);
    margin-top: 2px;
  }

  .tstn-fa__sub-icon svg { width: 22px; height: 22px; }

  .tstn-fa__sub-content { flex: 1; }

  .tstn-fa__sub-title {
    font-family: 'Danger Neue Free Regular', var(--font-heading-family), sans-serif !important;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 4px 0;
    line-height: 1;
    font-weight: 400;
  }

  .tstn-fa__sub-text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--tstn-text);
    margin: 0;
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 990px) {
    .tstn-fa__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .tstn-fa__inner { padding: 0 16px; }
    .tstn-fa__heading { letter-spacing: 0; }
    .tstn-fa__play { width: 64px; height: 64px; }
    .tstn-fa__play svg { width: 22px; height: 22px; }
    .tstn-fa__trigger { padding: 18px 20px; gap: 12px; }
    .tstn-fa__panel-inner { padding: 0 20px 22px 20px; }
    .tstn-fa__title { font-size: 16px; }
  }

  @media (max-width: 600px) {
    .tstn-fa__eyebrow { font-size: calc(var(--tstn-eyebrow-size) * 0.85); }
    .tstn-fa__sub { font-size: calc(var(--tstn-sub-size) * 0.9); letter-spacing: 0.1em; }
    .tstn-fa__video-tag { bottom: 12px; left: 12px; padding: 6px 10px; }
    .tstn-fa__duration, .tstn-fa__video-label { font-size: 11px; }
  }
</style>

{% liquid
  assign has_video_file = false
  if section.settings.video_file != blank
    assign has_video_file = true
  endif
  assign has_video_url = false
  if section.settings.video_url != blank
    assign has_video_url = true
  endif
%}

<section class="tstn-fa">
  <div class="tstn-fa__inner">
    <div class="tstn-fa__grid">

      {%- comment -%} ============ LEFT COLUMN ============ {%- endcomment -%}
      <div class="tstn-fa__left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="tstn-fa__eyebrow-wrap">
            <h6 class="tstn-fa__eyebrow">{{ section.settings.eyebrow }}</h6>
            <span class="tstn-fa__eyebrow-line"></span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="tstn-fa__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="tstn-fa__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- comment -%} Video {%- endcomment -%}
        <div class="tstn-fa__video" id="tstnVideo-{{ section.id }}">
          {%- if has_video_file -%}
            <video
              id="tstnVideoEl-{{ section.id }}"
              {% if section.settings.video_poster != blank %}poster="{{ section.settings.video_poster | image_url: width: 1600 }}"{% endif %}
              playsinline
              preload="metadata"
              muted
            >
              <source src="{{ section.settings.video_file.sources[1].url }}" type="video/mp4">
              <source src="{{ section.settings.video_file.sources[0].url }}" type="video/mp4">
            </video>
          {%- elsif has_video_url -%}
            {%- if section.settings.video_poster != blank -%}
              <img
                id="tstnVideoPoster-{{ section.id }}"
                src="{{ section.settings.video_poster | image_url: width: 1600 }}"
                alt="{{ section.settings.heading | escape }}"
                loading="lazy"
              >
            {%- endif -%}
            <iframe
              id="tstnVideoIframe-{{ section.id }}"
              src=""
              data-src="{{ section.settings.video_url }}{% if section.settings.video_url contains 'youtube' %}?autoplay=1&rel=0{% elsif section.settings.video_url contains 'vimeo' %}?autoplay=1{% endif %}"
              frameborder="0"
              allow="autoplay; fullscreen; picture-in-picture"
              allowfullscreen
              style="display:none;"
            ></iframe>
          {%- elsif section.settings.video_poster != blank -%}
            <img
              src="{{ section.settings.video_poster | image_url: width: 1600 }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          <div class="tstn-fa__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </div>

          {%- if section.settings.video_duration != blank or section.settings.video_label != blank -%}
            <div class="tstn-fa__video-tag">
              {%- if section.settings.video_duration != blank -%}
                <span class="tstn-fa__duration">{{ section.settings.video_duration }}</span>
              {%- endif -%}
              {%- if section.settings.video_label != blank -%}
                <span class="tstn-fa__video-label">{{ section.settings.video_label }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Trust badge {%- endcomment -%}
        {%- if section.settings.trust_text != blank -%}
          <div class="tstn-fa__trust">
            <div class="tstn-fa__trust-icon">
              {%- render 'tstn-fa-icon', name: section.settings.trust_icon -%}
            </div>
            <div class="tstn-fa__trust-text">{{ section.settings.trust_text }}</div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ============ RIGHT COLUMN ============ {%- endcomment -%}
      <div class="tstn-fa__right">
        {%- for block in section.blocks -%}
          {%- assign open_class = '' -%}
          {%- if block.settings.open_by_default -%}
            {%- assign open_class = ' is-open' -%}
          {%- endif -%}

          <div class="tstn-fa__item{{ open_class }}" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="tstn-fa__trigger"
              aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
              aria-controls="tstn-panel-{{ block.id }}"
            >
              <span class="tstn-fa__icon">
                {%- render 'tstn-fa-icon', name: block.settings.icon -%}
              </span>
              <span class="tstn-fa__title">{{ block.settings.title }}</span>
              <span class="tstn-fa__toggle" aria-hidden="true"></span>
            </button>

            <div
              id="tstn-panel-{{ block.id }}"
              class="tstn-fa__panel"
              role="region"
            >
              <div class="tstn-fa__panel-inner">
                {%- if block.settings.description != blank -%}
                  <div class="tstn-fa__desc">{{ block.settings.description }}</div>
                {%- endif -%}

                {%- assign has_subs = false -%}
                {%- if block.settings.sub_1_title != blank or block.settings.sub_2_title != blank or block.settings.sub_3_title != blank or block.settings.sub_4_title != blank -%}
                  {%- assign has_subs = true -%}
                {%- endif -%}

                {%- if has_subs -%}
                  <div class="tstn-fa__subs">
                    {%- for i in (1..4) -%}
                      {%- assign t_key = 'sub_' | append: i | append: '_title' -%}
                      {%- assign d_key = 'sub_' | append: i | append: '_text' -%}
                      {%- assign i_key = 'sub_' | append: i | append: '_icon' -%}
                      {%- assign s_title = block.settings[t_key] -%}
                      {%- assign s_text = block.settings[d_key] -%}
                      {%- assign s_icon = block.settings[i_key] -%}

                      {%- if s_title != blank or s_text != blank -%}
                        <div class="tstn-fa__sub-row">
                          <div class="tstn-fa__sub-icon">
                            {%- render 'tstn-fa-icon', name: s_icon -%}
                          </div>
                          <div class="tstn-fa__sub-content">
                            {%- if s_title != blank -%}
                              <h4 class="tstn-fa__sub-title">{{ s_title }}</h4>
                            {%- endif -%}
                            {%- if s_text != blank -%}
                              <p class="tstn-fa__sub-text">{{ s_text }}</p>
                            {%- endif -%}
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('shopify-section-{{ section.id }}');
  if (!section) return;

  // Accordion toggle
  var items = section.querySelectorAll('.tstn-fa__item');
  items.forEach(function(item) {
    var trigger = item.querySelector('.tstn-fa__trigger');
    if (!trigger) return;

    trigger.addEventListener('click', function() {
      var isOpen = item.classList.contains('is-open');
      // Close all
      items.forEach(function(other) {
        other.classList.remove('is-open');
        var t = other.querySelector('.tstn-fa__trigger');
        if (t) t.setAttribute('aria-expanded', 'false');
      });
      // Open clicked (if it wasn't already open)
      if (!isOpen) {
        item.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // Video play handling
  var videoWrap = document.getElementById('tstnVideo-{{ section.id }}');
  if (!videoWrap) return;

  videoWrap.addEventListener('click', function() {
    var videoEl = document.getElementById('tstnVideoEl-{{ section.id }}');
    var iframeEl = document.getElementById('tstnVideoIframe-{{ section.id }}');
    var posterEl = document.getElementById('tstnVideoPoster-{{ section.id }}');
    var playBtn = videoWrap.querySelector('.tstn-fa__play');
    var tag = videoWrap.querySelector('.tstn-fa__video-tag');

    if (videoEl) {
      videoEl.setAttribute('controls', 'controls');
      videoEl.muted = false;
      videoEl.play();
      if (playBtn) playBtn.style.display = 'none';
      if (tag) tag.style.display = 'none';
    } else if (iframeEl) {
      var src = iframeEl.getAttribute('data-src');
      if (src) {
        iframeEl.setAttribute('src', src);
        iframeEl.style.display = 'block';
        if (posterEl) posterEl.style.display = 'none';
        if (playBtn) playBtn.style.display = 'none';
        if (tag) tag.style.display = 'none';
      }
    }
  });
})();
</script>

{% schema %}
{
  "name": "TSTN Feature Accordion",
  "tag": "section",
  "class": "section-tstn-feature-accordion",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
