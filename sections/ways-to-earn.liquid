{%- comment -%}
  TSTN — Ways To Earn Points
  Premium dark cinematic rewards section.
  Headings: Danger Neue Free Regular | Accent: #ff6a1a | BG: #0a0a0a
  CSS scoped via #shopify-section-{{ section.id }} — safe to drop alongside other sections.
{%- endcomment -%}

{%- liquid
  assign acc = section.settings.accent_color
  assign bg = section.settings.bg_color
  assign card_bg = section.settings.card_bg_color
  assign text_color = section.settings.text_color
  assign muted_color = section.settings.muted_color
-%}

<style>
  @font-face {
    font-family: 'Danger Neue Free Regular';
    src: url('https://cdn.shopify.com/s/files/1/0686/9486/8103/files/Danger_Neue_Regular.ttf?v=1776280277') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  @import url('https://fonts.cdnfonts.com/css/danger-neue');
  @import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&display=swap');

  #shopify-section-{{ section.id }} .tstn-wte {
    --tstn-accent: {{ acc }};
    --tstn-bg: {{ bg }};
    --tstn-card: {{ card_bg }};
    --tstn-text: {{ text_color }};
    --tstn-muted: {{ muted_color }};
    --tstn-heading-font: 'Danger Neue Free Regular', 'Danger Neue', 'Arial Narrow', sans-serif;
    --tstn-body-font: 'Rajdhani', system-ui, -apple-system, sans-serif;
    --tstn-border: rgba(255,106,26,0.18);

    background: var(--tstn-bg);
    color: var(--tstn-text);
    font-family: var(--tstn-body-font);
    padding: clamp(48px, 7vw, 96px) clamp(18px, 5vw, 40px);
    position: relative;
    overflow: hidden;
  }

  /* subtle topographic glow in corners */
  #shopify-section-{{ section.id }} .tstn-wte::before,
  #shopify-section-{{ section.id }} .tstn-wte::after {
    content: '';
    position: absolute;
    width: 420px; height: 420px;
    background: radial-gradient(circle, rgba(255,106,26,0.10), transparent 70%);
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .tstn-wte::before { top: -120px; right: -120px; }
  #shopify-section-{{ section.id }} .tstn-wte::after { bottom: -120px; left: -120px; }

  #shopify-section-{{ section.id }} .tstn-wte__inner {
    max-width: 980px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* ---------- HEADER ---------- */
  #shopify-section-{{ section.id }} .tstn-wte__logo-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 3vw, 30px);
    margin-bottom: 18px;
  }
  #shopify-section-{{ section.id }} .tstn-wte__logo-line {
    flex: 1;
    height: 1px;
    max-width: 200px;
    background: linear-gradient(90deg, transparent, var(--tstn-accent));
  }
  #shopify-section-{{ section.id }} .tstn-wte__logo-line--r {
    background: linear-gradient(90deg, var(--tstn-accent), transparent);
  }
  #shopify-section-{{ section.id }} .tstn-wte__logo {
    text-align: center;
    flex-shrink: 0;
  }
  #shopify-section-{{ section.id }} .tstn-wte__logo svg { display: block; margin: 0 auto 2px; color: var(--tstn-accent); }
  #shopify-section-{{ section.id }} .tstn-wte__logo-text {
    font-family: var(--tstn-heading-font);
    font-size: clamp(26px, 5vw, 40px);
    letter-spacing: 0.14em;
    line-height: 1;
    color: var(--tstn-text);
  }
  #shopify-section-{{ section.id }} .tstn-wte__eyebrow {
    text-align: center;
    color: var(--tstn-accent);
    font-weight: 700;
    letter-spacing: 0.22em;
    font-size: clamp(13px, 1.6vw, 15px);
    margin-bottom: 6px;
  }
  #shopify-section-{{ section.id }} .tstn-wte__heading {
    font-family: var(--tstn-heading-font);
    text-align: center;
    font-size: clamp(40px, 9vw, 88px);
    line-height: 0.95;
    letter-spacing: 0.01em;
    margin: 0 0 14px;
    color: var(--tstn-text);
  }
  #shopify-section-{{ section.id }} .tstn-wte__subheading {
    text-align: center;
    color: var(--tstn-muted);
    font-size: clamp(15px, 2vw, 19px);
    max-width: 560px;
    margin: 0 auto clamp(34px, 5vw, 52px);
  }

  /* ---------- HIGHLIGHT CARDS ---------- */
  #shopify-section-{{ section.id }} .tstn-wte__highlights {
    display: grid;
    gap: 20px;
    margin-bottom: clamp(40px, 6vw, 64px);
  }
  #shopify-section-{{ section.id }} .tstn-wte__hcard {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: clamp(20px, 4vw, 40px);
    background: var(--tstn-card);
    border: 1px solid rgba(255,255,255,0.06);
    border-left: 4px solid var(--tstn-accent);
    border-radius: 14px;
    padding: clamp(22px, 4vw, 38px);
  }
  #shopify-section-{{ section.id }} .tstn-wte__hicon {
    flex-shrink: 0;
    width: clamp(72px, 12vw, 110px);
    height: clamp(72px, 12vw, 110px);
    border-radius: 50%;
    background: rgba(255,106,26,0.08);
    display: flex; align-items: center; justify-content: center;
    color: var(--tstn-accent);
  }
  #shopify-section-{{ section.id }} .tstn-wte__hicon svg { width: 46%; height: 46%; }
  #shopify-section-{{ section.id }} .tstn-wte__htitle {
    font-family: var(--tstn-heading-font);
    font-size: clamp(20px, 3.2vw, 30px);
    letter-spacing: 0.04em;
    margin: 0 0 4px;
    color: var(--tstn-text);
  }
  #shopify-section-{{ section.id }} .tstn-wte__hpoints {
    font-family: var(--tstn-heading-font);
    font-size: clamp(22px, 3.6vw, 34px);
    color: var(--tstn-accent);
    margin: 0 0 8px;
    letter-spacing: 0.04em;
  }
  #shopify-section-{{ section.id }} .tstn-wte__hdesc { color: var(--tstn-muted); font-size: clamp(14px, 1.8vw, 17px); margin: 0; }

  /* ---------- DIVIDER ---------- */
  #shopify-section-{{ section.id }} .tstn-wte__divider {
    display: flex; align-items: center; gap: 18px;
    margin-bottom: clamp(28px, 4vw, 40px);
  }
  #shopify-section-{{ section.id }} .tstn-wte__divider span {
    flex: 1; height: 1px; background: rgba(255,255,255,0.12);
  }
  #shopify-section-{{ section.id }} .tstn-wte__divider strong {
    font-family: var(--tstn-heading-font);
    font-weight: 400;
    color: var(--tstn-text);
    letter-spacing: 0.14em;
    font-size: clamp(15px, 2vw, 20px);
    white-space: nowrap;
  }

  /* ---------- ACTION GRID ---------- */
  #shopify-section-{{ section.id }} .tstn-wte__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  #shopify-section-{{ section.id }} .tstn-wte__acard {
    cursor: pointer;
    background: var(--tstn-card);
    border: 1px solid var(--tstn-border);
    border-radius: 12px;
    padding: clamp(20px, 3vw, 30px) 18px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform .2s ease, border-color .2s ease;
  }
  #shopify-section-{{ section.id }} .tstn-wte__acard:hover {
    transform: translateY(-3px);
    border-color: var(--tstn-accent);
  }
  #shopify-section-{{ section.id }} .tstn-wte__aicon { color: var(--tstn-accent); margin-bottom: 14px; }
  #shopify-section-{{ section.id }} .tstn-wte__aicon svg { width: 34px; height: 34px; }
  #shopify-section-{{ section.id }} .tstn-wte__atitle {
    font-family: var(--tstn-heading-font);
    font-size: clamp(16px, 2.2vw, 20px);
    letter-spacing: 0.05em;
    margin: 0 0 8px;
    color: var(--tstn-text);
  }
  #shopify-section-{{ section.id }} .tstn-wte__adesc {
    color: var(--tstn-muted);
    font-size: 14px;
    margin: 0 0 18px;
    flex: 1;
  }
  #shopify-section-{{ section.id }} .tstn-wte__abtn {
    display: inline-block;
    border: 1px solid var(--tstn-accent);
    color: var(--tstn-accent);
    background: transparent;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 0.12em;
    font-size: 12px;
    text-transform: uppercase;
    padding: 9px 18px;
    border-radius: 6px;
    transition: background .2s ease, color .2s ease;
  }
  #shopify-section-{{ section.id }} .tstn-wte__abtn:hover { background: var(--tstn-accent); color: #0a0a0a; }

  /* ---------- ONE-TIME CTA BANNER ---------- */
  #shopify-section-{{ section.id }} .tstn-wte__cta {
    cursor: pointer;
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--tstn-border);
    display: flex;
    align-items: center;
    gap: clamp(18px, 4vw, 36px);
    padding: clamp(24px, 4vw, 40px);
    background: linear-gradient(90deg, rgba(10,10,10,0.92), rgba(10,10,10,0.55));
  }
  #shopify-section-{{ section.id }} .tstn-wte__cta-bg {
    position: absolute; inset: 0; z-index: -1;
    background-size: cover; background-position: center;
  }
  #shopify-section-{{ section.id }} .tstn-wte__cta-overlay {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgba(10,10,10,0.92), rgba(10,10,10,0.5));
  }
  #shopify-section-{{ section.id }} .tstn-wte__cta-icon {
    flex-shrink: 0;
    width: clamp(60px, 9vw, 88px);
    height: clamp(60px, 9vw, 88px);
    border-radius: 50%;
    border: 1px solid var(--tstn-accent);
    display: flex; align-items: center; justify-content: center;
    color: var(--tstn-accent);
  }
  #shopify-section-{{ section.id }} .tstn-wte__cta-icon svg { width: 44%; height: 44%; }
  #shopify-section-{{ section.id }} .tstn-wte__cta-body { flex: 1; }
  #shopify-section-{{ section.id }} .tstn-wte__cta-title {
    font-family: var(--tstn-heading-font);
    font-size: clamp(18px, 3vw, 28px);
    letter-spacing: 0.04em;
    margin: 0 0 6px;
    color: var(--tstn-text);
  }
  #shopify-section-{{ section.id }} .tstn-wte__cta-text { color: var(--tstn-muted); font-size: clamp(14px, 1.8vw, 16px); margin: 0; }
  #shopify-section-{{ section.id }} .tstn-wte__cta-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--tstn-accent);
    color: #0a0a0a;
    text-decoration: none;
    font-family: var(--tstn-heading-font);
    font-size: clamp(15px, 2vw, 20px);
    letter-spacing: 0.06em;
    padding: 14px 26px;
    border-radius: 8px;
    transition: transform .2s ease, box-shadow .2s ease;
  }
  #shopify-section-{{ section.id }} .tstn-wte__cta-btn:hover {
    transform: translateX(3px);
    box-shadow: 0 8px 30px rgba(255,106,26,0.35);
  }
  #shopify-section-{{ section.id }} .tstn-wte__cta-btn svg { width: 20px; height: 20px; }

  /* ---------- FOOTER TAGLINE ---------- */
  #shopify-section-{{ section.id }} .tstn-wte__tagline {
    margin-top: clamp(40px, 6vw, 64px);
    padding-top: clamp(20px, 3vw, 30px);
    border-top: 1px solid rgba(255,106,26,0.25);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .tstn-wte__tagline em {
    font-family: var(--tstn-heading-font);
    font-style: italic;
    color: var(--tstn-accent);
    letter-spacing: 0.06em;
    font-size: clamp(15px, 2.4vw, 22px);
  }
  #shopify-section-{{ section.id }} .tstn-wte__tagline span {
    font-family: var(--tstn-heading-font);
    color: var(--tstn-accent);
    letter-spacing: 0.14em;
    font-size: clamp(16px, 2.6vw, 24px);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .tstn-wte__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .tstn-wte__hcard { flex-direction: column; text-align: center; }
    #shopify-section-{{ section.id }} .tstn-wte__cta { flex-direction: column; text-align: center; }
    #shopify-section-{{ section.id }} .tstn-wte__logo-line { max-width: 60px; }
  }
</style>

{%- comment -%} ---- reusable icon renderer ---- {%- endcomment -%}
{%- capture icon_cart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>{%- endcapture -%}
{%- capture icon_camera -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>{%- endcapture -%}
{%- capture icon_instagram -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" y1="6.5" x2="17.5" y2="6.5"/></svg>{%- endcapture -%}
{%- capture icon_youtube -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 7a3 3 0 0 0-2.1-2.1C19 4.4 12 4.4 12 4.4s-7 0-8.9.5A3 3 0 0 0 1 7a31 31 0 0 0 0 10 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5A3 3 0 0 0 23 17a31 31 0 0 0 0-10zM9.8 15.4V8.6l5.8 3.4z"/></svg>{%- endcapture -%}
{%- capture icon_birthday -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21h16v-6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2z"/><path d="M4 16c2 0 2 1 4 1s2-1 4-1 2 1 4 1 2-1 4-1"/><path d="M12 6v3M12 3v.01"/></svg>{%- endcapture -%}
{%- capture icon_share -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>{%- endcapture -%}
{%- capture icon_star -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.1 8.6 22 9.3 17 14.1 18.2 21 12 17.6 5.8 21 7 14.1 2 9.3 8.9 8.6 12 2"/></svg>{%- endcapture -%}
{%- capture icon_envelope -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 6 10 7L22 6"/></svg>{%- endcapture -%}
{%- capture icon_gift -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>{%- endcapture -%}
{%- capture icon_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>{%- endcapture -%}
{%- capture icon_tag -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4 12 22l-9-9V3h10z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>{%- endcapture -%}

<div class="tstn-wte">
  <div class="tstn-wte__inner">

    {%- comment -%} ---------- HEADER ---------- {%- endcomment -%}
    <div class="tstn-wte__logo-row">
      <span class="tstn-wte__logo-line"></span>
      <div class="tstn-wte__logo">
        {%- if section.settings.show_mountain -%}
          <svg width="40" height="18" viewBox="0 0 40 18" fill="currentColor"><path d="M2 18 14 2l6 8 4-5 12 13z"/></svg>
        {%- endif -%}
        <div class="tstn-wte__logo-text">{{ section.settings.logo_text | escape }}</div>
      </div>
      <span class="tstn-wte__logo-line tstn-wte__logo-line--r"></span>
    </div>

    {%- if section.settings.eyebrow != blank -%}
      <p class="tstn-wte__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="tstn-wte__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="tstn-wte__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- comment -%} ---------- HIGHLIGHT CARDS ---------- {%- endcomment -%}
    {%- assign has_highlights = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'highlight' -%}{%- assign has_highlights = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_highlights -%}
      <div class="tstn-wte__highlights">
        {%- for block in section.blocks -%}
          {%- if block.type == 'highlight' -%}
            <div class="tstn-wte__hcard" data-open-growave-rewards role="button" tabindex="0" {{ block.shopify_attributes }}>
              <div class="tstn-wte__hicon">
                {%- case block.settings.icon -%}
                  {%- when 'cart' -%}{{ icon_cart }}
                  {%- when 'camera' -%}{{ icon_camera }}
                  {%- when 'gift' -%}{{ icon_gift }}
                  {%- when 'star' -%}{{ icon_star }}
                  {%- when 'heart' -%}{{ icon_heart }}
                  {%- when 'tag' -%}{{ icon_tag }}
                  {%- else -%}{{ icon_cart }}
                {%- endcase -%}
              </div>
              <div>
                {%- if block.settings.title != blank -%}<h3 class="tstn-wte__htitle">{{ block.settings.title | escape }}</h3>{%- endif -%}
                {%- if block.settings.points != blank -%}<p class="tstn-wte__hpoints">{{ block.settings.points | escape }}</p>{%- endif -%}
                {%- if block.settings.description != blank -%}<p class="tstn-wte__hdesc">{{ block.settings.description | escape }}</p>{%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- ACTION GRID ---------- {%- endcomment -%}
    {%- assign has_actions = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'action' -%}{%- assign has_actions = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_actions -%}
      {%- if section.settings.grid_label != blank -%}
        <div class="tstn-wte__divider"><span></span><strong>{{ section.settings.grid_label | escape }}</strong><span></span></div>
      {%- endif -%}
      <div class="tstn-wte__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'action' -%}
            <div class="tstn-wte__acard" data-open-growave-rewards role="button" tabindex="0" {{ block.shopify_attributes }}>
              <div class="tstn-wte__aicon">
                {%- case block.settings.icon -%}
                  {%- when 'instagram' -%}{{ icon_instagram }}
                  {%- when 'youtube' -%}{{ icon_youtube }}
                  {%- when 'birthday' -%}{{ icon_birthday }}
                  {%- when 'share' -%}{{ icon_share }}
                  {%- when 'star' -%}{{ icon_star }}
                  {%- when 'envelope' -%}{{ icon_envelope }}
                  {%- when 'heart' -%}{{ icon_heart }}
                  {%- when 'gift' -%}{{ icon_gift }}
                  {%- else -%}{{ icon_star }}
                {%- endcase -%}
              </div>
              {%- if block.settings.title != blank -%}<h3 class="tstn-wte__atitle">{{ block.settings.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.description != blank -%}<p class="tstn-wte__adesc">{{ block.settings.description | escape }}</p>{%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="tstn-wte__abtn" href="#" data-open-growave-rewards>{{ block.settings.button_label | escape }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- ONE-TIME CTA BANNER ---------- {%- endcomment -%}
    {%- if section.settings.cta_title != blank -%}
      <div class="tstn-wte__cta" data-open-growave-rewards role="button" tabindex="0">
        {%- if section.settings.cta_image != blank -%}
          <div class="tstn-wte__cta-bg" style="background-image:url({{ section.settings.cta_image | image_url: width: 1600 }});"></div>
        {%- endif -%}
        <div class="tstn-wte__cta-overlay"></div>
        <div class="tstn-wte__cta-icon">{{ icon_gift }}</div>
        <div class="tstn-wte__cta-body">
          <h3 class="tstn-wte__cta-title">{{ section.settings.cta_title | escape }}</h3>
          {%- if section.settings.cta_text != blank -%}<p class="tstn-wte__cta-text">{{ section.settings.cta_text | escape }}</p>{%- endif -%}
        </div>
        {%- if section.settings.cta_button_label != blank -%}
          <a class="tstn-wte__cta-btn" href="#" data-open-growave-rewards>
            {{ section.settings.cta_button_label | escape }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ---------- FOOTER TAGLINE ---------- {%- endcomment -%}
    {%- if section.settings.tagline != blank or section.settings.footer_logo != blank -%}
      <div class="tstn-wte__tagline">
        {%- if section.settings.tagline != blank -%}<em>{{ section.settings.tagline | escape }}</em>{%- endif -%}
        {%- if section.settings.footer_logo != blank -%}<span>{{ section.settings.footer_logo | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function() {
    function openGrowaveRewards(event) {
      var trigger = event.target.closest('[data-open-growave-rewards]');
      if (!trigger) return;

      event.preventDefault();

      var widget = document.querySelector('.gw-rd-popup-widget-placeholder');
      var launcher = null;

      if (widget && widget.shadowRoot) {
        launcher =
          widget.shadowRoot.querySelector('button') ||
          widget.shadowRoot.querySelector('[role="button"]') ||
          widget.shadowRoot.querySelector('[class*="launcher"]');
      }

      if (!launcher) {
        launcher =
          document.querySelector('.gw-rd-popup-widget-placeholder button') ||
          document.querySelector('[class*="gw-rd"] button') ||
          document.querySelector('[class*="growave"] button');
      }

      if (launcher) {
        launcher.click();
      } else {
        console.warn('Growave rewards launcher was not found. Keep the Growave launcher enabled in Growave settings.');
      }
    }

    document.addEventListener('click', openGrowaveRewards);

    document.addEventListener('keydown', function(event) {
      if ((event.key === 'Enter' || event.key === ' ') && event.target.matches('[data-open-growave-rewards]')) {
        openGrowaveRewards(event);
      }
    });
  })();
</script>

