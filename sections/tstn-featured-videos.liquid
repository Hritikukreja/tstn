{% comment %}
  TSTN Clubhouse (Featured Videos)
  - Podcast/Clubhouse layout: bordered panel, big featured episode + overlaid
    meta, stacked episode cards on the right, and a 3-icon feature strip.
  - Logged-in:  clicking an episode opens the video modal player
  - Logged-out: clicking an episode opens the "Members Only" gate popup
{% endcomment %}

<style>
  @font-face {
    font-family: 'Danger Neue Free Regular';
    src: url('{{ "DangerNeueFree-Regular.woff2" | asset_url }}') format('woff2'),
         url('https://cdn.shopify.com/s/files/1/0686/9486/8103/files/Danger_Neue_Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  #shopify-section-{{ section.id }} {
    --tstn-orange: #ff6a1a;
    --tstn-orange-hover: #ff7a1f;
    --tstn-bg: #0a0a0a;
    --tstn-panel: #0d0d0d;
    --tstn-card-bg: #141414;
    --tstn-text: #ffffff;
    --tstn-muted: #9a9a9a;
    --tstn-border: rgba(255,255,255,0.08);
    --tstn-font-display: "Danger Neue Free Regular", "Inter", sans-serif;
  }

  .tstn-club {
    background: var(--tstn-bg);
    color: var(--tstn-text);
    padding: clamp(20px, 3vw, 48px) clamp(16px, 4vw, 56px);
  }
  .tstn-club__shell {
    max-width: 1600px;
    margin: 0 auto;
    background: linear-gradient(180deg, #101010, #0b0b0b);
    border: 1px solid var(--tstn-border);
    border-radius: clamp(18px, 2vw, 28px);
    padding: clamp(24px, 3.5vw, 56px);
  }

  /* ----- Header ----- */
  .tstn-club__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: clamp(26px, 3vw, 40px);
  }
  .tstn-club__title {
    font-family: var(--tstn-font-display);
    font-weight: 400;
    font-size: clamp(34px, 4.5vw, 58px);
    line-height: 0.95;
    margin: 0 0 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .tstn-club__subtitle {
    font-size: clamp(14px, 1.1vw, 16px);
    color: var(--tstn-muted);
    margin: 0;
    max-width: 520px;
    line-height: 1.5;
  }
  .tstn-club__explore {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--tstn-orange);
    color: var(--tstn-orange);
    background: transparent;
    padding: 14px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: all 0.25s ease;
  }
  .tstn-club__explore:hover {
    background: var(--tstn-orange);
    color: #fff;
  }
  .tstn-club__explore svg { transition: transform 0.25s ease; }
  .tstn-club__explore:hover svg { transform: translateX(4px); }

  /* ----- Main grid ----- */
  .tstn-club__grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(20px, 2.4vw, 36px);
    align-items: start;
  }

  /* Featured episode (left) */
  .tstn-club__feature {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16/9;
    background: #1a1a1a;
    cursor: pointer;
    display: block;
    border: 1px solid var(--tstn-border);
    padding: 0;
    width: 100%;
    font: inherit;
    color: inherit;
    text-align: left;
  }
  .tstn-club__feature img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
    transition: transform 0.5s ease;
  }
  .tstn-club__feature:hover img { transform: scale(1.04); }
  .tstn-club__feature::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0) 35%, rgba(0,0,0,0.7) 100%);
    pointer-events: none;
  }
  .tstn-club__badge {
    position: absolute;
    top: 18px; left: 18px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,0,0,0.5);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--tstn-orange);
    color: var(--tstn-orange);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 999px;
  }
  .tstn-club__badge svg { width: 13px; height: 13px; }
  .tstn-club__play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(64px, 7vw, 88px);
    height: clamp(64px, 7vw, 88px);
    border-radius: 50%;
    background: rgba(255,255,255,0.96);
    border: 3px solid var(--tstn-orange);
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .tstn-club__feature:hover .tstn-club__play {
    transform: translate(-50%, -50%) scale(1.08);
    background: var(--tstn-orange);
  }
  .tstn-club__play svg { color: #111; margin-left: 4px; transition: color 0.25s ease; }
  .tstn-club__feature:hover .tstn-club__play svg { color: #fff; }
  .tstn-club__feature-meta {
    position: absolute;
    bottom: 18px; left: 20px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.5px;
  }
  .tstn-club__feature-meta svg { width: 15px; height: 15px; opacity: 0.85; }
  .tstn-club__feature-meta .tstn-club__sep { opacity: 0.4; }
  .tstn-club__feature-meta .tstn-club__ep-no { color: var(--tstn-orange); }

  .tstn-club__feature-info { margin-top: clamp(16px, 1.8vw, 22px); }
  .tstn-club__feature-title {
    font-family: var(--tstn-font-display);
    font-weight: 400;
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.02;
    margin: 0 0 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .tstn-club__feature-author {
    font-size: clamp(15px, 1.2vw, 17px);
    font-weight: 600;
    color: var(--tstn-text);
    margin: 0 0 10px;
  }
  .tstn-club__feature-desc {
    font-size: 14px;
    color: var(--tstn-muted);
    line-height: 1.55;
    margin: 0;
    max-width: 620px;
  }

  /* Episode cards (right) */
  .tstn-club__side {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.5vw, 18px);
  }
  .tstn-club__ep {
    display: grid;
    grid-template-columns: clamp(120px, 11vw, 150px) 1fr auto;
    gap: clamp(12px, 1.2vw, 18px);
    align-items: center;
    background: var(--tstn-card-bg);
    border: 1px solid var(--tstn-border);
    border-radius: 14px;
    padding: clamp(12px, 1.2vw, 16px);
    cursor: pointer;
    width: 100%;
    font: inherit;
    color: inherit;
    text-align: left;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .tstn-club__ep:hover {
    border-color: rgba(255,106,26,0.5);
    background: #181818;
    transform: translateY(-2px);
  }
  .tstn-club__ep-thumb {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 16/11;
    background: #1a1a1a;
  }
  .tstn-club__ep-thumb img {
    width: 100%; height: 100%;
    object-fit: cover; display: block;
  }
  .tstn-club__ep-thumb-play {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 38px; height: 38px;
    border-radius: 50%;
    background: rgba(255,255,255,0.92);
    border: 2px solid rgba(255,255,255,0.6);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .tstn-club__ep:hover .tstn-club__ep-thumb-play {
    background: var(--tstn-orange);
    border-color: var(--tstn-orange);
  }
  .tstn-club__ep:hover .tstn-club__ep-thumb-play svg { fill: #fff; }
  .tstn-club__ep-body { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
  .tstn-club__ep-no {
    color: var(--tstn-orange);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .tstn-club__ep-title {
    font-family: var(--tstn-font-display);
    font-weight: 400;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.08;
    margin: 0;
    color: var(--tstn-text);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .tstn-club__ep-author { font-size: 13px; color: var(--tstn-muted); }
  .tstn-club__ep-time {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--tstn-muted);
    margin-top: 2px;
  }
  .tstn-club__ep-time svg { width: 13px; height: 13px; }
  .tstn-club__ep-arrow {
    color: var(--tstn-muted);
    flex-shrink: 0;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .tstn-club__ep:hover .tstn-club__ep-arrow {
    color: var(--tstn-orange);
    transform: translateX(4px);
  }

  /* ----- Feature strip ----- */
  .tstn-club__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(26px, 3vw, 44px);
    padding-top: clamp(24px, 2.6vw, 34px);
    border-top: 1px solid var(--tstn-border);
  }
  .tstn-club__feat {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 6px clamp(18px, 2vw, 32px);
  }
  .tstn-club__feat + .tstn-club__feat { border-left: 1px solid var(--tstn-border); }
  .tstn-club__feat-icon {
    color: var(--tstn-orange);
    flex-shrink: 0;
    width: 34px; height: 34px;
  }
  .tstn-club__feat-icon svg { width: 100%; height: 100%; }
  .tstn-club__feat-title {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0 0 4px;
    color: var(--tstn-text);
  }
  .tstn-club__feat-text { font-size: 13px; color: var(--tstn-muted); margin: 0; line-height: 1.4; }

  /* ============================================================
     Modals (shared base)
     ============================================================ */
  .tstn-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 40px);
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .tstn-modal.is-open { display: flex; opacity: 1; }
  .tstn-modal__inner {
    position: relative;
    transform: translateY(20px);
    transition: transform 0.25s ease;
  }
  .tstn-modal.is-open .tstn-modal__inner { transform: translateY(0); }
  .tstn-modal__close {
    position: absolute;
    top: 12px; right: 12px;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 10;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .tstn-modal__close:hover { background: var(--tstn-orange); transform: rotate(90deg); }

  .tstn-modal--video .tstn-modal__inner {
    width: 100%;
    max-width: 1100px;
    background: #000;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6);
  }
  .tstn-modal__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    background: #000;
  }
  .tstn-modal__frame iframe,
  .tstn-modal__frame video {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    border: none;
  }
  .tstn-modal__meta {
    padding: 16px clamp(16px, 2vw, 24px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--tstn-card-bg);
    border-top: 1px solid var(--tstn-border);
  }
  .tstn-modal__title {
    font-family: var(--tstn-font-display);
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 26px);
    margin: 0;
    color: var(--tstn-text);
    letter-spacing: 0.02em;
    line-height: 1.15;
    text-transform: uppercase;
  }
  .tstn-modal__author { font-size: 13px; color: var(--tstn-muted); }

  .tstn-modal--gate .tstn-modal__inner {
    width: 100%;
    max-width: 560px;
    background: var(--tstn-card-bg);
    border: 1px solid var(--tstn-border);
    border-radius: 18px;
    padding: clamp(32px, 4vw, 44px);
    overflow: hidden;
  }
  .tstn-gate__lock-bg {
    position: absolute;
    right: -10px; bottom: -20px;
    color: var(--tstn-orange);
    opacity: 0.35;
    width: 220px; height: 220px;
    pointer-events: none;
  }
  .tstn-gate__glow {
    position: absolute;
    right: -60px; bottom: -60px;
    width: 360px; height: 360px;
    background: radial-gradient(circle, rgba(255,106,26,0.18) 0%, transparent 65%);
    pointer-events: none;
  }
  .tstn-gate__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--tstn-orange);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    margin-bottom: 18px;
    position: relative;
    z-index: 2;
  }
  .tstn-gate__pill svg { width: 14px; height: 14px; }
  .tstn-gate__title {
    font-family: var(--tstn-font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.05;
    margin: 0 0 26px;
    color: var(--tstn-text);
    letter-spacing: 0.02em;
    position: relative;
    z-index: 2;
    text-transform: uppercase;
  }
  .tstn-gate__list {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    z-index: 2;
  }
  .tstn-gate__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 15px;
    color: var(--tstn-text);
    font-weight: 500;
  }
  .tstn-gate__check { color: var(--tstn-orange); flex-shrink: 0; }
  .tstn-gate__cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--tstn-orange);
    color: #fff;
    padding: 13px 26px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.25s ease;
    position: relative;
    z-index: 2;
  }
  .tstn-gate__cta:hover { background: var(--tstn-orange-hover); transform: translateY(-2px); }
  .tstn-gate__cta svg { transition: transform 0.25s ease; }
  .tstn-gate__cta:hover svg { transform: translateX(4px); }

  body.tstn-modal-open { overflow: hidden; }

  /* ----- Responsive ----- */
  @media (max-width: 1024px) {
    .tstn-club__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) {
    .tstn-club__head { flex-direction: column; }
    .tstn-club__features { grid-template-columns: 1fr; gap: 22px; }
    .tstn-club__feat { padding: 0; }
    .tstn-club__feat + .tstn-club__feat { border-left: none; padding-top: 22px; border-top: 1px solid var(--tstn-border); }
  }
  @media (max-width: 460px) {
    .tstn-club__ep { grid-template-columns: 96px 1fr; }
    .tstn-club__ep-arrow { display: none; }
    .tstn-modal--gate .tstn-modal__inner { padding: 28px 24px; }
    .tstn-gate__lock-bg { width: 160px; height: 160px; }
  }
</style>

{%- comment -%} Reusable icon renderer for the feature strip {%- endcomment -%}
{%- capture noop -%}{%- endcapture -%}

<section class="tstn-club">
  <div class="tstn-club__shell">

    <!-- Header -->
    <div class="tstn-club__head">
      <div class="tstn-club__head-left">
        <h2 class="tstn-club__title">{{ section.settings.heading | default: 'Clubhouse' }}</h2>
        {% if section.settings.subtitle != blank %}
          <p class="tstn-club__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
      {% if section.settings.explore_text != blank %}
        <a href="{{ section.settings.explore_link | default: '#' }}" class="tstn-club__explore">
          {{ section.settings.explore_text }}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>

    <!-- Main grid -->
    <div class="tstn-club__grid">

      <!-- Featured episode -->
      <div class="tstn-club__main-col">
        <button
          class="tstn-club__feature"
          type="button"
          data-tstn-video-trigger
          data-video-url="{{ section.settings.main_link }}"
          data-video-title="{{ section.settings.main_title | default: 'Full-Size Overlanding: Lessons From The Road' | escape }}"
          data-video-author="{{ section.settings.main_author | default: 'Shaun Walford with Clay Croft' | escape }}">
          {% if section.settings.main_image %}
            <img src="{{ section.settings.main_image | image_url: width: 1200 }}" alt="{{ section.settings.main_title }}">
          {% else %}
            <div style="width:100%;height:100%;background:linear-gradient(135deg,#222,#111);"></div>
          {% endif %}

          {% if section.settings.main_badge != blank %}
            <span class="tstn-club__badge">
              <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
              {{ section.settings.main_badge }}
            </span>
          {% endif %}

          <span class="tstn-club__play">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20"/></svg>
          </span>

          {% if section.settings.main_duration != blank or section.settings.main_episode != blank %}
            <span class="tstn-club__feature-meta">
              {% if section.settings.main_duration != blank %}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                <span>{{ section.settings.main_duration }}</span>
              {% endif %}
              {% if section.settings.main_duration != blank and section.settings.main_episode != blank %}<span class="tstn-club__sep">•</span>{% endif %}
              {% if section.settings.main_episode != blank %}<span class="tstn-club__ep-no">{{ section.settings.main_episode }}</span>{% endif %}
            </span>
          {% endif %}
        </button>

        <div class="tstn-club__feature-info">
          <h3 class="tstn-club__feature-title">{{ section.settings.main_title | default: 'Full-Size Overlanding: Lessons From The Road' }}</h3>
          {% if section.settings.main_author != blank %}
            <p class="tstn-club__feature-author">{{ section.settings.main_author }}</p>
          {% endif %}
          {% if section.settings.main_desc != blank %}
            <p class="tstn-club__feature-desc">{{ section.settings.main_desc }}</p>
          {% endif %}
        </div>
      </div>

      <!-- Episode list -->
      <div class="tstn-club__side">
        {% for block in section.blocks %}
          {% if block.type == 'video_item' %}
            <button
              class="tstn-club__ep"
              type="button"
              data-tstn-video-trigger
              data-video-url="{{ block.settings.link }}"
              data-video-title="{{ block.settings.title | escape }}"
              data-video-author="{{ block.settings.author | escape }}"
              {{ block.shopify_attributes }}>
              <span class="tstn-club__ep-thumb">
                {% if block.settings.image %}
                  <img src="{{ block.settings.image | image_url: width: 320 }}" alt="{{ block.settings.title }}">
                {% else %}
                  <span style="display:block;width:100%;height:100%;background:linear-gradient(135deg,#333,#1a1a1a);"></span>
                {% endif %}
                <span class="tstn-club__ep-thumb-play">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="#111"><polygon points="6,4 20,12 6,20"/></svg>
                </span>
              </span>
              <span class="tstn-club__ep-body">
                {% if block.settings.episode != blank %}<span class="tstn-club__ep-no">{{ block.settings.episode }}</span>{% endif %}
                <span class="tstn-club__ep-title">{{ block.settings.title }}</span>
                {% if block.settings.author != blank %}<span class="tstn-club__ep-author">{{ block.settings.author }}</span>{% endif %}
                {% if block.settings.duration != blank %}
                  <span class="tstn-club__ep-time">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    {{ block.settings.duration }}
                  </span>
                {% endif %}
              </span>
              <span class="tstn-club__ep-arrow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </button>
          {% endif %}
        {% endfor %}
      </div>

    </div>

    <!-- Feature strip -->
    {%- assign feat_count = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'feature' -%}{%- assign feat_count = feat_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {% if feat_count > 0 %}
      <div class="tstn-club__features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="tstn-club__feat" {{ block.shopify_attributes }}>
              <span class="tstn-club__feat-icon">
                {% case block.settings.icon %}
                  {% when 'headphones' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
                  {% when 'mountains' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m8 3 4 8 5-5 5 15H2L8 3z"></path></svg>
                  {% when 'compass' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
                  {% when 'map' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                  {% when 'shield' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                  {% when 'gear' %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                {% endcase %}
              </span>
              <div>
                <p class="tstn-club__feat-title">{{ block.settings.heading }}</p>
                <p class="tstn-club__feat-text">{{ block.settings.text }}</p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}

  </div>

  <!-- Video Modal -->
  <div class="tstn-modal tstn-modal--video" id="tstn-modal-video-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="tstn-modal__inner">
      <button class="tstn-modal__close" type="button" aria-label="Close video">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="tstn-modal__frame" data-tstn-modal-frame></div>
      <div class="tstn-modal__meta">
        <h3 class="tstn-modal__title" data-tstn-modal-title></h3>
        <span class="tstn-modal__author" data-tstn-modal-author></span>
      </div>
    </div>
  </div>

  <!-- Gate Modal -->
  <div class="tstn-modal tstn-modal--gate" id="tstn-modal-gate-{{ section.id }}" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="tstn-modal__inner">
      <button class="tstn-modal__close" type="button" aria-label="Close">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="tstn-gate__glow"></div>
      <svg class="tstn-gate__lock-bg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>

      <div class="tstn-gate__pill">
        <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        {{ section.settings.gate_pill | default: 'MEMBERS ONLY' }}
      </div>

      <h3 class="tstn-gate__title">{{ section.settings.gate_title | default: 'Unlock Exclusive Content & Perks' }}</h3>

      <ul class="tstn-gate__list">
        {% for block in section.blocks %}
          {% if block.type == 'perk' %}
            <li {{ block.shopify_attributes }}>
              <svg class="tstn-gate__check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>{{ block.settings.text }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      <a href="{{ section.settings.gate_cta_link | default: '/account/register' }}" class="tstn-gate__cta">
        {{ section.settings.gate_cta_text | default: 'Join TSTN Club' }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

</section>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var section = document.getElementById('shopify-section-' + sectionId);
  if (!section || section.dataset.tstnClubBound === 'true') return;
  section.dataset.tstnClubBound = 'true';

  var isLoggedIn = {% if customer %}true{% else %}false{% endif %};

  var videoModal = section.querySelector('#tstn-modal-video-' + sectionId);
  var gateModal  = section.querySelector('#tstn-modal-gate-' + sectionId);
  var frame      = videoModal && videoModal.querySelector('[data-tstn-modal-frame]');
  var titleEl    = videoModal && videoModal.querySelector('[data-tstn-modal-title]');
  var authorEl   = videoModal && videoModal.querySelector('[data-tstn-modal-author]');
  var triggers   = section.querySelectorAll('[data-tstn-video-trigger]');

  function buildEmbed(rawUrl) {
    if (!rawUrl) return null;
    var url = rawUrl.trim();
    var ytMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([A-Za-z0-9_-]{11})/);
    if (ytMatch) return { type: 'iframe', src: 'https://www.youtube.com/embed/' + ytMatch[1] + '?autoplay=1&rel=0&modestbranding=1' };
    var vimeoMatch = url.match(/(?:vimeo\.com\/(?:video\/)?|player\.vimeo\.com\/video\/)(\d+)/);
    if (vimeoMatch) return { type: 'iframe', src: 'https://player.vimeo.com/video/' + vimeoMatch[1] + '?autoplay=1' };
    if (/\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(url)) return { type: 'video', src: url };
    return { type: 'iframe', src: url };
  }

  function openModal(modal) {
    if (!modal) return;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.classList.add('tstn-modal-open');
  }
  function closeModal(modal) {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    if (!section.querySelector('.tstn-modal.is-open')) {
      document.body.classList.remove('tstn-modal-open');
    }
    if (modal === videoModal && frame) frame.innerHTML = '';
  }

  function openVideoModal(trigger) {
    var url = trigger.getAttribute('data-video-url');
    var embed = buildEmbed(url);
    if (!embed || !embed.src || embed.src === '' || embed.src === '#') {
      console.warn('[TSTN] No video URL set for this trigger.');
      return;
    }
    if (embed.type === 'iframe') {
      frame.innerHTML = '<iframe src="' + embed.src + '" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
    } else {
      frame.innerHTML = '<video src="' + embed.src + '" controls autoplay playsinline></video>';
    }
    titleEl.textContent  = trigger.getAttribute('data-video-title')  || '';
    authorEl.textContent = trigger.getAttribute('data-video-author') || '';
    openModal(videoModal);
  }

  triggers.forEach(function(t) {
    t.addEventListener('click', function() {
      if (isLoggedIn) openVideoModal(t); else openModal(gateModal);
    });
  });

  section.querySelectorAll('.tstn-modal').forEach(function(modal) {
    var closeBtn = modal.querySelector('.tstn-modal__close');
    if (closeBtn) closeBtn.addEventListener('click', function() { closeModal(modal); });
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal(modal);
    });
  });

  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape') return;
    section.querySelectorAll('.tstn-modal.is-open').forEach(function(m) { closeModal(m); });
  });
})();
</script>

{% schema %}
{
  "name": "TSTN Clubhouse",
  "settings": [
    { "type": "header", "content": "Section Header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Clubhouse" },
