    { "type": "url", "id": "explore_link", "label": "Button Link" },

    { "type": "header", "content": "Featured Episode" },
    { "type": "image_picker", "id": "main_image", "label": "Cover Image" },
    { "type": "text", "id": "main_badge", "label": "Badge Text", "default": "Featured Episode" },
    { "type": "text", "id": "main_title", "label": "Title", "default": "Full-Size Overlanding: Lessons From The Road" },
    { "type": "text", "id": "main_author", "label": "Author/By line", "default": "Shaun Walford with Clay Croft" },
    { "type": "textarea", "id": "main_desc", "label": "Description", "default": "Real-world lessons on building, outfitting, and living on the road with confidence." },
    { "type": "text", "id": "main_duration", "label": "Duration", "default": "39 MIN" },
    { "type": "text", "id": "main_episode", "label": "Episode Label", "default": "Episode 04" },
    { "type": "url", "id": "main_link", "label": "Video URL (YouTube, Vimeo, or direct .mp4)" },

    { "type": "header", "content": "Members Only Gate Popup (logged-out)" },
    { "type": "text", "id": "gate_pill", "label": "Pill Label", "default": "MEMBERS ONLY" },
    { "type": "text", "id": "gate_title", "label": "Title", "default": "Unlock Exclusive Content & Perks" },
    { "type": "text", "id": "gate_cta_text", "label": "CTA Button Text", "default": "Join TSTN Club" },
    { "type": "url", "id": "gate_cta_link", "label": "CTA Button Link" },
    { "type": "paragraph", "content": "Add 'Members Perk' blocks below to populate the checkmark list. Logged-out visitors who click an episode will see this popup." }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "Episode",
      "settings": [
