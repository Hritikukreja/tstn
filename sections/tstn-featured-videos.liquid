        { "type": "text", "id": "episode", "label": "Episode Label", "default": "Episode 02" },
        { "type": "text", "id": "title", "label": "Title", "default": "Episode Title" },
        { "type": "text", "id": "author", "label": "By line" },
        { "type": "text", "id": "duration", "label": "Duration", "default": "42 MIN" },
        { "type": "url", "id": "link", "label": "Video URL" }
      ]
    },
    {
      "type": "feature",
      "name": "Bottom Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "headphones",
          "options": [
            { "value": "headphones", "label": "Headphones" },
            { "value": "mountains", "label": "Mountains" },
            { "value": "compass", "label": "Compass" },
            { "value": "map", "label": "Map" },
            { "value": "shield", "label": "Shield" },
            { "value": "gear", "label": "Gear" },
            { "value": "star", "label": "Star" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Real Conversations" },
        { "type": "text", "id": "text", "label": "Text", "default": "Unfiltered talk with experts and builders." }
      ]
    },
    {
      "type": "perk",
      "name": "Members Perk",
      "settings": [
        { "type": "text", "id": "text", "label": "Perk", "default": "Exclusive Videos" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "TSTN Clubhouse",
      "blocks": [
        { "type": "video_item", "settings": { "episode": "Episode 02", "title": "Building A Rig That Can Actually Handle The Trip", "author": "Shaun Walford with Brad Kowitz", "duration": "42 MIN" } },
        { "type": "video_item", "settings": { "episode": "Episode 03", "title": "Remote Travel, Recovery Gear & Smart Decisions", "author": "Shaun Walford with Scott Brady", "duration": "55 MIN" } },
        { "type": "video_item", "settings": { "episode": "Episode 01", "title": "Living On The Road Without Overcomplicating It", "author": "Shaun Walford with Clay Croft", "duration": "39 MIN" } },
        { "type": "feature", "settings": { "icon": "headphones", "heading": "Real Conversations", "text": "Unfiltered talk with experts and builders." } },
        { "type": "feature", "settings": { "icon": "mountains", "heading": "Field Tested Insights", "text": "Gear, rigs, and strategies that work." } },
        { "type": "feature", "settings": { "icon": "compass", "heading": "Stories From The Road", "text": "Experience that goes beyond the map." } },
        { "type": "perk", "settings": { "text": "Exclusive Videos" } },
        { "type": "perk", "settings": { "text": "In-depth Blogs" } },
        { "type": "perk", "settings": { "text": "Live Sessions" } },
        { "type": "perk", "settings": { "text": "Member Discounts" } },
        { "type": "perk", "settings": { "text": "Early Access to Events" } }
      ]
    }
  ]
}
{% endschema %}
