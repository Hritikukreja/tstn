{% comment %}
  ============================================================
  TSTN Gallery — Single Row Edition
  ------------------------------------------------------------
  - One elegant row, always: columns auto-fit the number of
    image blocks added (up to 5)
  - Mobile: the row becomes a swipeable scroll-snap strip,
    preserving the single-row design on small screens
  - Danger Neue Free Regular headings, Rajdhani body
  - Fully self-contained, scoped to this section instance
  ============================================================
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign heading = section.settings.heading | default: ''
  assign eyebrow = section.settings.eyebrow | default: ''
  assign subheading_check = section.settings.subheading | strip_html | strip
  assign image_count = section.blocks.size
  if image_count < 1
    assign image_count = 1
  endif
  assign img_sizes = '(max-width: 749px) 78vw, (max-width: 1600px) calc(100vw / ' | append: image_count | append: '), calc(1600px / ' | append: image_count | append: ')'
-%}

<style>
  #shopify-section-{{ sid }} {
    --tstn-bg: {{ section.settings.background_color | default: '#0a0a0a' }};
    --tstn-surface: #141414;
    --tstn-accent: #ff6a1a;
    --tstn-border: rgba(255, 255, 255, 0.08);
    --tstn-text: #ffffff;
    --tstn-muted: #9a9a9a;
    --tstn-gap: {{ section.settings.grid_gap | default: 16 }}px;
    --tstn-radius: {{ section.settings.corner_radius | default: 14 }}px;
  }

  #shopify-section-{{ sid }} .tstn-gallery {
    background: var(--tstn-bg);
    padding-top: {{ section.settings.padding_top | default: 80 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 80 }}px;
  }

  #shopify-section-{{ sid }} .tstn-gallery__inner {
    max-width: 1600px;
    margin: 0 auto;
    padding-left: clamp(20px, 6vw, 80px);
    padding-right: clamp(20px, 6vw, 80px);
  }

  /* ---------- Heading group ---------- */
  #shopify-section-{{ sid }} .tstn-gallery__head {
    margin-bottom: clamp(28px, 4vw, 52px);
    {% if section.settings.heading_alignment == 'center' %}
    text-align: center;
    {% endif %}
  }

  #shopify-section-{{ sid }} .tstn-gallery__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--tstn-accent);
    margin: 0 0 14px;
  }

  #shopify-section-{{ sid }} .tstn-gallery__eyebrow::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 2px;
    background: var(--tstn-accent);
  }

  {% if section.settings.heading_alignment == 'center' %}
  #shopify-section-{{ sid }} .tstn-gallery__eyebrow::after {
    content: '';
    display: inline-block;
    width: 28px;
    height: 2px;
    background: var(--tstn-accent);
  }
  {% endif %}

  #shopify-section-{{ sid }} .tstn-gallery__heading {
    font-family: 'Danger Neue Free Regular', 'Rajdhani', sans-serif;
    font-size: clamp(32px, 4.5vw, 60px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--tstn-text);
    margin: 0;
  }

  #shopify-section-{{ sid }} .tstn-gallery__subheading {
    font-family: 'Rajdhani', sans-serif;
    font-size: clamp(15px, 1.4vw, 18px);
    font-weight: 500;
    line-height: 1.6;
    color: var(--tstn-muted);
    max-width: 640px;
    margin: 14px 0 0;
    {% if section.settings.heading_alignment == 'center' %}
    margin-left: auto;
    margin-right: auto;
    {% endif %}
  }

  #shopify-section-{{ sid }} .tstn-gallery__subheading p {
    margin: 0;
  }

  /* ---------- Single row ---------- */
  #shopify-section-{{ sid }} .tstn-gallery__row {
    display: grid;
    grid-template-columns: repeat({{ image_count }}, minmax(0, 1fr));
    gap: var(--tstn-gap);
  }

  #shopify-section-{{ sid }} .tstn-gallery__item {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--tstn-radius);
    background: var(--tstn-surface);
    border: 1px solid var(--tstn-border);
    text-decoration: none;
  }

  {% case section.settings.aspect_ratio %}
    {% when 'adaptive' %}
  /* Justified row: natural ratios, equal height, proportional widths */
  #shopify-section-{{ sid }} .tstn-gallery__row {
    display: flex;
    align-items: stretch;
  }
  #shopify-section-{{ sid }} .tstn-gallery__item {
    aspect-ratio: var(--tstn-ratio, 1);
    flex: var(--tstn-ratio, 1) 1 0%;
  }
    {% when 'square' %}
  #shopify-section-{{ sid }} .tstn-gallery__item { aspect-ratio: 1 / 1; }
    {% when 'portrait' %}
  #shopify-section-{{ sid }} .tstn-gallery__item { aspect-ratio: 4 / 5; }
    {% when 'tall' %}
  #shopify-section-{{ sid }} .tstn-gallery__item { aspect-ratio: 3 / 4; }
    {% when 'landscape' %}
  #shopify-section-{{ sid }} .tstn-gallery__item { aspect-ratio: 16 / 10; }
    {% else %}
  #shopify-section-{{ sid }} .tstn-gallery__item { aspect-ratio: 4 / 5; }
  {% endcase %}

  #shopify-section-{{ sid }} .tstn-gallery__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  #shopify-section-{{ sid }} .tstn-gallery__item:hover .tstn-gallery__img,
  #shopify-section-{{ sid }} .tstn-gallery__item:focus-visible .tstn-gallery__img {
    transform: scale(1.05);
  }

  /* Subtle bottom scrim — appears on hover */
  #shopify-section-{{ sid }} .tstn-gallery__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.72) 0%,
      rgba(10, 10, 10, 0.0) 42%
    );
    opacity: 0;
    transition: opacity 0.45s ease;
    pointer-events: none;
  }

  #shopify-section-{{ sid }} .tstn-gallery__item:hover .tstn-gallery__scrim,
  #shopify-section-{{ sid }} .tstn-gallery__item:focus-visible .tstn-gallery__scrim {
    opacity: 1;
  }

  #shopify-section-{{ sid }} .tstn-gallery__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 18px 20px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tstn-text);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  #shopify-section-{{ sid }} .tstn-gallery__caption::before {
    content: '';
    display: block;
    width: 22px;
    height: 2px;
    background: var(--tstn-accent);
    margin-bottom: 8px;
  }

  #shopify-section-{{ sid }} .tstn-gallery__item:hover .tstn-gallery__caption,
  #shopify-section-{{ sid }} .tstn-gallery__item:focus-visible .tstn-gallery__caption {
    opacity: 1;
    transform: translateY(0);
  }

  #shopify-section-{{ sid }} .tstn-gallery__item:focus-visible {
    outline: 2px solid var(--tstn-accent);
    outline-offset: 3px;
  }

  /* Placeholder state (theme editor, no image selected) */
  #shopify-section-{{ sid }} .tstn-gallery__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tstn-muted);
  }

  #shopify-section-{{ sid }} .tstn-gallery__placeholder svg {
    width: 38%;
    height: 38%;
    opacity: 0.35;
  }

  /* ---------- Zoom button reset ---------- */
  #shopify-section-{{ sid }} button.tstn-gallery__item {
    appearance: none;
    -webkit-appearance: none;
    padding: 0;
    margin: 0;
    font: inherit;
    text-align: left;
    color: inherit;
    cursor: zoom-in;
    width: 100%;
  }

  /* ---------- Lightbox ---------- */
  html.tstn-lb-open,
  html.tstn-lb-open body {
    overflow: hidden;
  }

  .tstn-gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease;
  }

  /* CRITICAL: author display:flex overrides the UA [hidden] rule —
     without this, the closed lightbox sits invisibly over the whole
     page at z-index 9999 and blocks every click */
  .tstn-gallery-lightbox[hidden] {
    display: none;
  }

  .tstn-gallery-lightbox.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .tstn-gallery-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 10, 0.94);
    cursor: zoom-out;
  }

  .tstn-gallery-lightbox__figure {
    position: relative;
    margin: 0;
    max-width: min(92vw, 1600px);
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    pointer-events: none;
  }

  .tstn-gallery-lightbox__img {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    border-radius: 10px;
    cursor: zoom-in;
    pointer-events: auto;
    user-select: none;
    transform: scale(1);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tstn-gallery-lightbox__img.is-zoomed {
    transform: scale(2.2);
    cursor: zoom-out;
  }

  .tstn-gallery-lightbox__caption {
    font-family: 'Rajdhani', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a9a9a;
    text-align: center;
  }

  .tstn-gallery-lightbox__close {
    position: absolute;
    top: clamp(14px, 3vw, 28px);
    right: clamp(14px, 3vw, 28px);
    z-index: 2;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .tstn-gallery-lightbox__close svg {
    width: 18px;
    height: 18px;
  }

  .tstn-gallery-lightbox__close:hover,
  .tstn-gallery-lightbox__close:focus-visible {
    border-color: #ff6a1a;
    color: #ff6a1a;
    transform: rotate(90deg);
  }

  .tstn-gallery-lightbox__close:focus-visible {
    outline: 2px solid #ff6a1a;
    outline-offset: 3px;
  }

  /* ---------- Mobile: swipeable single row ---------- */
  @media (max-width: 749px) {
    #shopify-section-{{ sid }} .tstn-gallery {
      padding-top: {{ section.settings.padding_top | default: 80 | times: 0.6 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | default: 80 | times: 0.6 | round }}px;
    }

    #shopify-section-{{ sid }} .tstn-gallery__inner {
      padding-left: clamp(16px, 4vw, 56px);
      padding-right: clamp(16px, 4vw, 56px);
    }

    {% if section.settings.mobile_layout == 'scroll' %}
    /* Scroll-snap strip: the row stays a row */
    #shopify-section-{{ sid }} .tstn-gallery__row {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      /* Bleed to the screen edges so swiping feels native */
      margin-left: calc(-1 * clamp(16px, 4vw, 56px));
      margin-right: calc(-1 * clamp(16px, 4vw, 56px));
      padding-left: clamp(16px, 4vw, 56px);
      padding-right: clamp(16px, 4vw, 56px);
    }

    #shopify-section-{{ sid }} .tstn-gallery__row::-webkit-scrollbar {
      display: none;
    }

    {% if section.settings.aspect_ratio == 'adaptive' %}
    /* Equal-height strip: each image's width follows its own ratio */
    #shopify-section-{{ sid }} .tstn-gallery__item {
      flex: 0 0 auto;
      height: min(96vw, 420px);
      max-width: 86vw;
      scroll-snap-align: center;
    }
    {% else %}
    #shopify-section-{{ sid }} .tstn-gallery__item {
      flex: 0 0 78vw;
      max-width: 420px;
      scroll-snap-align: center;
    }
    {% endif %}
    {% else %}
    /* Stacked: one image per row */
    #shopify-section-{{ sid }} .tstn-gallery__row {
      grid-template-columns: 1fr;
      flex-direction: column;
      gap: 12px;
    }

    {% if section.settings.aspect_ratio == 'adaptive' %}
    #shopify-section-{{ sid }} .tstn-gallery__item {
      flex: 0 0 auto;
      width: 100%;
    }
    {% endif %}
    {% endif %}

    /* Captions visible by default on touch — hover doesn't exist */
    #shopify-section-{{ sid }} .tstn-gallery__scrim,
    #shopify-section-{{ sid }} .tstn-gallery__caption {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ sid }} .tstn-gallery__img,
    #shopify-section-{{ sid }} .tstn-gallery__caption,
    #shopify-section-{{ sid }} .tstn-gallery__scrim,
    .tstn-gallery-lightbox,
    .tstn-gallery-lightbox__img,
    .tstn-gallery-lightbox__close {
      transition: none;
    }
  }
</style>

<section class="tstn-gallery">
  <div class="tstn-gallery__inner">

    {%- if eyebrow != blank or heading != blank or subheading_check != blank -%}
      <header class="tstn-gallery__head">
        {%- if eyebrow != blank -%}
          <p class="tstn-gallery__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="tstn-gallery__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading_check != blank -%}
          <div class="tstn-gallery__subheading">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="tstn-gallery__row">
        {%- for block in section.blocks -%}
          {%- liquid
            assign caption_check = block.settings.caption | strip
            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
            assign img_ratio = 1.0
            if block.settings.image != blank
              assign img_ratio = block.settings.image.aspect_ratio | round: 4
            endif
            assign is_zoom = false
            if section.settings.enable_zoom and has_link == false and block.settings.image != blank
              assign is_zoom = true
            endif
          -%}

          {%- if has_link -%}
            <a
              href="{{ block.settings.link }}"
              class="tstn-gallery__item"
              style="--tstn-ratio: {{ img_ratio }};"
              {{ block.shopify_attributes }}
              {%- if caption_check != blank %} aria-label="{{ caption_check | escape }}"{% endif -%}
            >
          {%- elsif is_zoom -%}
            <button
              type="button"
              class="tstn-gallery__item tstn-gallery__item--zoom"
              style="--tstn-ratio: {{ img_ratio }};"
              data-tstn-zoom
              data-tstn-full="{{ block.settings.image | image_url: width: 2400 }}"
              data-tstn-caption="{{ caption_check | escape }}"
              aria-haspopup="dialog"
              aria-label="{% if caption_check != blank %}{{ caption_check | escape }} — {% endif %}View full size"
              {{ block.shopify_attributes }}
            >
          {%- else -%}
            <div class="tstn-gallery__item" style="--tstn-ratio: {{ img_ratio }};" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  class: 'tstn-gallery__img',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1600',
                  sizes: img_sizes
              }}
            {%- else -%}
              <div class="tstn-gallery__placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            <span class="tstn-gallery__scrim" aria-hidden="true"></span>

            {%- if caption_check != blank -%}
              <span class="tstn-gallery__caption">{{ caption_check }}</span>
            {%- endif -%}

          {%- if has_link -%}
            </a>
          {%- elsif is_zoom -%}
            </button>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{%- if section.settings.enable_zoom -%}
  <div
    class="tstn-gallery-lightbox"
    id="TstnGalleryLightbox-{{ sid }}"
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
    hidden
  >
    <div class="tstn-gallery-lightbox__backdrop" data-tstn-lb-close></div>
    <button type="button" class="tstn-gallery-lightbox__close" data-tstn-lb-close aria-label="Close image viewer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
    <figure class="tstn-gallery-lightbox__figure">
      <img class="tstn-gallery-lightbox__img" src="" alt="" draggable="false">
      <figcaption class="tstn-gallery-lightbox__caption"></figcaption>
    </figure>
  </div>

  <script>
    (function () {
      var section = document.getElementById('shopify-section-{{ sid }}');
      if (!section || section.dataset.tstnGalleryZoomBound === 'true') return;
      section.dataset.tstnGalleryZoomBound = 'true';

      var lightbox = document.getElementById('TstnGalleryLightbox-{{ sid }}');
      if (!lightbox) return;

      var img = lightbox.querySelector('.tstn-gallery-lightbox__img');
      var captionEl = lightbox.querySelector('.tstn-gallery-lightbox__caption');
      var lastTrigger = null;

      function open(trigger) {
        lastTrigger = trigger;
        img.src = trigger.getAttribute('data-tstn-full') || '';
        var caption = trigger.getAttribute('data-tstn-caption') || '';
        img.alt = caption;
        captionEl.textContent = caption;
        captionEl.style.display = caption ? '' : 'none';
        resetZoom();
        lightbox.hidden = false;
        document.documentElement.classList.add('tstn-lb-open');
        requestAnimationFrame(function () {
          lightbox.classList.add('is-visible');
        });
      }

      function close() {
        lightbox.classList.remove('is-visible');
        document.documentElement.classList.remove('tstn-lb-open');
        window.setTimeout(function () {
          lightbox.hidden = true;
          img.src = '';
          resetZoom();
          if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
        }, 220);
      }

      function resetZoom() {
        img.classList.remove('is-zoomed');
        img.style.transformOrigin = '';
      }

      function toggleZoom(event) {
        if (img.classList.contains('is-zoomed')) {
          resetZoom();
          return;
        }
        var rect = img.getBoundingClientRect();
        var x = ((event.clientX - rect.left) / rect.width) * 100;
        var y = ((event.clientY - rect.top) / rect.height) * 100;
        img.style.transformOrigin = x + '% ' + y + '%';
        img.classList.add('is-zoomed');
      }

      section.addEventListener('click', function (event) {
        var trigger = event.target.closest('[data-tstn-zoom]');
        if (trigger) {
          event.preventDefault();
          open(trigger);
        }
      });

      lightbox.addEventListener('click', function (event) {
        if (event.target.closest('[data-tstn-lb-close]')) {
          close();
          return;
        }
        if (event.target === img) {
          toggleZoom(event);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !lightbox.hidden) close();
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "TSTN Gallery",
  "tag": "section",
  "class": "tstn-gallery-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "paragraph",
      "content": "All images sit in a single row. The row divides itself evenly between however many images you add (up to 5)."
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adaptive", "label": "Adapt to each image" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "tall", "label": "Tall (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (16:10)" }
      ],
      "default": "adaptive",
      "info": "Adapt keeps each image's natural proportions — the row stays one height and widths adjust automatically."
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        { "value": "scroll", "label": "Swipeable row" },
        { "value": "stack", "label": "Stacked" }
      ],
      "default": "scroll",
      "info": "Swipeable keeps the single-row design on phones."
    },
    {
      "type": "checkbox",
      "id": "enable_zoom",
      "label": "Enable image zoom",
      "default": true,
      "info": "Tap an image to view it full screen, then tap again to magnify. Images with a link navigate instead."
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between images",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 14
