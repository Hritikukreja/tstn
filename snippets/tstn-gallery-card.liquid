{% comment %}
  ============================================================
    TSTN — Gallery Card snippet
    Renders one card for the Community Gallery section.
    Used by both the metaobject loop and the section blocks loop
    so the markup never drifts between the two sources.

    Accepts:
      image              (image object)        - required to show a photo
      title              (string)
      category           (string)              - drives the filter pills
      author_name        (string)
      avatar             (image object)
      photo_count        (string / number)
      like_count         (string / number)
      description        (string)              - shown in lightbox
      location_label     (string)              - shown on the photo + lightbox
      location_url       (string)              - optional map link
      is_community_upload(boolean)             - drives "Only community uploads"
      editor_attributes  (string)              - block.shopify_attributes (blocks only)
  ============================================================
{% endcomment %}

<div class="tstn-gal__card" role="button" tabindex="0" data-lightbox-trigger
     data-description="{{ description | escape }}"
     data-location-label="{{ location_label | escape }}"
     data-location-url="{{ location_url | escape }}"
     data-likes="{{ like_count }}"
     data-photos="{{ photo_count }}"
     data-category="{{ category | escape }}"
     data-community="{{ is_community_upload }}"
     data-search="{{ title | escape }} {{ category | escape }} {{ author_name | escape }} {{ location_label | escape }}"
     {{ editor_attributes }}>
  <div class="tstn-gal__card-img">
    {%- if image != blank -%}
      <img src="{{ image | image_url: width: 700 }}"
           alt="{{ title | escape }}"
           loading="lazy"
           width="{{ image.width }}"
           height="{{ image.height }}"
           data-lightbox-src="{{ image | image_url: width: 1800 }}">
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- if photo_count != blank -%}
      <span class="tstn-gal__photocount">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        {{ photo_count }}
      </span>
    {%- endif -%}
    <span class="tstn-gal__expand" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
    </span>
    {%- if category != blank -%}
      <div class="tstn-gal__card-cat-overlay">{{ category }}</div>
    {%- endif -%}
  </div>
  <div class="tstn-gal__card-body">
    {%- if location_label != blank -%}
      <div class="tstn-gal__card-loc">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>{{ location_label }}</span>
      </div>
    {%- endif -%}
    {%- if title != blank -%}
      <div class="tstn-gal__card-title">{{ title }}</div>
    {%- endif -%}
    <div class="tstn-gal__card-meta">
      <div class="tstn-gal__author tstn-gal__card-author">
        <div class="tstn-gal__author-avatar">
          {%- if avatar != blank -%}
            <img src="{{ avatar | image_url: width: 50 }}" alt="" loading="lazy">
          {%- endif -%}
        </div>
        <span class="tstn-gal__author-name">{{ author_name }}</span>
      </div>
      {%- if like_count != blank -%}
        <span class="tstn-gal__likes">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          {{ like_count }}
        </span>
      {%- endif -%}
    </div>
  </div>
</div>
